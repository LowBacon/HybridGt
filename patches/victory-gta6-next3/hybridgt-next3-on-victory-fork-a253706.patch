+        // With -src1: the modifier applies before the conversion.
+        let neg = vop3_mod(op, 0, vgpr(1), vgpr(2), 0, 0, 2, 0, false);
+        check_op(&neg, &inputs, false, what, |i| {
+            norm16_f32_reference(i[0], signed)
