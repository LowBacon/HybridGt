diff --git a/crates/victory-hle/src/modules/ffx.rs b/crates/victory-hle/src/modules/ffx.rs
new file mode 100644
index 00000000..20d40b06
--- /dev/null
+++ b/crates/victory-hle/src/modules/ffx.rs
@@ -0,0 +1,613 @@
+//! HybridGt: AMD FidelityFX (`amd_fidelityfx_upscaler_xbox.dll`), the
+//! upscaler the title loads in its Series S configuration.
+//!
+//! The console DLL exports the FidelityFX API (`ffx_api.h`, MIT, AMD's PC
+//! SDK has the same five entry points): `ffxCreateContext`, `ffxConfigure`,
+//! `ffxQuery`, `ffxDispatch`, `ffxDestroyContext`. Each takes a chain of
+//! descriptors starting `{ u64 type; header* next; }`. Its shaders are not
+//! in a form our translator reads, so the console DLL itself cannot run.
+//!
+//! Here the calls go to AMD's PC upscaler: `amd_fidelityfx_loader_dx12.dll`
+//! (with `amd_fidelityfx_upscaler_dx12.dll` beside it), looked for in
+//! `VICTORY_FFX_DIR`, else beside our executable. It runs on the host
+//! device, recording into the host list behind the title's list, with the
+//! host copies of the title's textures:
+//! - create: the upscale descriptor (and its version descriptor) is passed
+//!   on; the console backend descriptor is replaced by the PC DX12 one
+//!   naming the host device;
+//! - dispatch (upscale): the command list and each texture are swapped for
+//!   the host's, moved to the states the upscaler expects;
+//! - query and configure: passed on (plain data).
+//!
+//! Without the PC DLLs every call answers `FFX_API_RETURN_ERROR_NO_PROVIDER`
+//! (no upscaler), as the API defines; the title is never told an upscale ran
+//! that did not.
+//! shortcut: descriptor layouts are taken to be the PC SDK 2.x ones (the
+//! console DLL's API version is not known); the first dispatch is logged
+//! word by word to check them against a run.
+
+#![allow(non_snake_case)]
+
+use std::ffi::c_void;
+use std::sync::{Mutex, OnceLock};
+
+use crate::{HleModule, hle_export};
+
+/// `FFX_API_RETURN_OK`.
+const OK: u32 = 0;
+/// `FFX_API_RETURN_ERROR_NO_PROVIDER`.
+const NO_PROVIDER: u32 = 4;
+/// `FFX_API_RETURN_ERROR_PARAMETER`.
+const PARAMETER: u32 = 6;
+/// `FFX_API_RETURN_ERROR_RUNTIME_ERROR`.
+const RUNTIME_ERROR: u32 = 3;
+
+/// `FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE`, `_UPSCALE_VERSION`.
+const CREATE_UPSCALE: u64 = 0x1_0000;
+const CREATE_UPSCALE_VERSION: u64 = 0x1_000b;
+/// `FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_DX12` (PC).
+const BACKEND_DX12: u64 = 0x2;
+/// `FFX_API_DISPATCH_DESC_TYPE_UPSCALE`.
+const DISPATCH_UPSCALE: u64 = 0x1_0001;
+/// `FFX_API_QUERY_DESC_TYPE_GET_VERSIONS`, `FFX_API_DESC_TYPE_OVERRIDE_VERSION`,
+/// `FFX_API_QUERY_DESC_TYPE_GET_PROVIDER_VERSION` (`ffx_api.h`).
+const QUERY_VERSIONS: u64 = 4;
+const OVERRIDE_VERSION: u64 = 5;
+const QUERY_PROVIDER_VERSION: u64 = 6;
+
+/// `ffxQueryDescGetVersions`.
+#[repr(C)]
+struct QueryVersions {
+    header: Header,
+    create_desc_type: u64,
+    device: *mut c_void,
+    output_count: *mut u64,
+    version_ids: *mut u64,
+    version_names: *mut *const std::ffi::c_char,
+}
+
+/// `ffxOverrideVersion`.
+#[repr(C)]
+struct OverrideVersion {
+    header: Header,
+    version_id: u64,
+}
+
+/// `ffxQueryGetProviderVersion`.
+#[repr(C)]
+struct ProviderVersion {
+    header: Header,
+    version_id: u64,
+    version_name: *const std::ffi::c_char,
+}
+
+/// HybridGt: the upscale providers AMD's PC DLLs offer on `device` (id,
+/// name; e.g. "FSR 3.1.x" and, on cards that run it, "FSR 4.x").
+fn versions(pc: &Pc, device: *mut c_void) -> Vec<(u64, String)> {
+    let mut count = 0u64;
+    let mut q = QueryVersions {
+        header: Header { ty: QUERY_VERSIONS, next: std::ptr::null_mut() },
+        create_desc_type: CREATE_UPSCALE,
+        device,
+        output_count: &raw mut count,
+        version_ids: std::ptr::null_mut(),
+        version_names: std::ptr::null_mut(),
+    };
+    // SAFETY: a query of counts only, with no context.
+    if unsafe { (pc.query)(std::ptr::null_mut(), &raw mut q.header) } != OK || count == 0 || count > 64 {
+        return Vec::new();
+    }
+    let mut ids = vec![0u64; count as usize];
+    let mut names: Vec<*const std::ffi::c_char> = vec![std::ptr::null(); count as usize];
+    q.version_ids = ids.as_mut_ptr();
+    q.version_names = names.as_mut_ptr();
+    // SAFETY: arrays of `count` entries.
+    if unsafe { (pc.query)(std::ptr::null_mut(), &raw mut q.header) } != OK {
+        return Vec::new();
+    }
+    ids.into_iter()
+        .zip(names)
+        .take(count as usize)
+        .map(|(id, name)| {
+            let name = if name.is_null() {
+                String::new()
+            } else {
+                // SAFETY: a nul-terminated name the DLL keeps.
+                unsafe { std::ffi::CStr::from_ptr(name) }.to_string_lossy().into_owned()
+            };
+            (id, name)
+        })
+        .collect()
+}
+
+/// HybridGt: the provider of a context, as the PC DLL names it.
+fn provider(pc: &Pc, context: *mut c_void) -> Option<String> {
+    let mut q = ProviderVersion {
+        header: Header { ty: QUERY_PROVIDER_VERSION, next: std::ptr::null_mut() },
+        version_id: 0,
+        version_name: std::ptr::null(),
+    };
+    let mut context = context;
+    // SAFETY: a context the PC DLL made.
+    if unsafe { (pc.query)(&raw mut context, &raw mut q.header) } != OK || q.version_name.is_null() {
+        return None;
+    }
+    // SAFETY: a nul-terminated name the DLL keeps.
+    Some(unsafe { std::ffi::CStr::from_ptr(q.version_name) }.to_string_lossy().into_owned())
+}
+
+/// HybridGt: `VICTORY_FFX_VERSION=<part of a name>` picks the provider whose
+/// name holds it (e.g. `3.1`); unset: the DLL's own choice (the newest the
+/// card runs).
+fn chosen(offered: &[(u64, String)]) -> Option<u64> {
+    let want = std::env::var("VICTORY_FFX_VERSION").ok().filter(|w| !w.is_empty())?;
+    let found = offered.iter().find(|(_, name)| name.contains(&want)).map(|(id, _)| *id);
+    if found.is_none() {
+        tracing::warn!(want, ?offered, "FidelityFX: no upscale provider with that name (VICTORY_FFX_VERSION); the DLL's own choice is used");
+    }
+    found
+}
+
+/// `ffxApiHeader`.
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct Header {
+    ty: u64,
+    next: *mut Header,
+}
+
+/// `ffxCreateBackendDX12Desc`.
+#[repr(C)]
+struct BackendDx12 {
+    header: Header,
+    device: *mut c_void,
+}
+
+/// `FfxApiResourceDescription`.
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+struct ResourceDesc {
+    ty: u32,
+    format: u32,
+    width: u32,
+    height: u32,
+    depth: u32,
+    mips: u32,
+    flags: u32,
+    usage: u32,
+}
+
+/// `FfxApiResource`.
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct Resource {
+    resource: *mut c_void,
+    desc: ResourceDesc,
+    state: u32,
+}
+
+/// `ffxDispatchDescUpscale` (FidelityFX SDK 2.x).
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct DispatchUpscale {
+    header: Header,
+    command_list: *mut c_void,
+    color: Resource,
+    depth: Resource,
+    motion_vectors: Resource,
+    exposure: Resource,
+    reactive: Resource,
+    transparency: Resource,
+    output: Resource,
+    jitter: [f32; 2],
+    motion_vector_scale: [f32; 2],
+    render_size: [u32; 2],
+    upscale_size: [u32; 2],
+    enable_sharpening: bool,
+    sharpness: f32,
+    frame_time_delta: f32,
+    pre_exposure: f32,
+    reset: bool,
+    camera_near: f32,
+    camera_far: f32,
+    camera_fov_vertical: f32,
+    view_space_to_meters: f32,
+    flags: u32,
+}
+
+type Create = unsafe extern "C" fn(*mut *mut c_void, *mut Header, *const c_void) -> u32;
+type Destroy = unsafe extern "C" fn(*mut *mut c_void, *const c_void) -> u32;
+type Configure = unsafe extern "C" fn(*mut *mut c_void, *const Header) -> u32;
+type Query = unsafe extern "C" fn(*mut *mut c_void, *mut Header) -> u32;
+type Dispatch = unsafe extern "C" fn(*mut *mut c_void, *const Header) -> u32;
+
+/// The PC upscaler's entry points.
+struct Pc {
+    create: Create,
+    destroy: Destroy,
+    configure: Configure,
+    query: Query,
+    dispatch: Dispatch,
+}
+
+/// The PC loader, loaded on first use; `None` (logged once) without it.
+fn pc() -> Option<&'static Pc> {
+    static PC: OnceLock<Option<Pc>> = OnceLock::new();
+    PC.get_or_init(|| {
+        use windows_sys::Win32::System::LibraryLoader::{GetProcAddress, LoadLibraryW};
+        let dir = std::env::var_os("VICTORY_FFX_DIR")
+            .map(std::path::PathBuf::from)
+            .or_else(|| std::env::current_exe().ok().and_then(|e| e.parent().map(|p| p.to_path_buf())))?;
+        let path = dir.join("amd_fidelityfx_loader_dx12.dll");
+        let wide: Vec<u16> = path.as_os_str().encode_wide_null();
+        // SAFETY: a nul-terminated path.
+        let module = unsafe { LoadLibraryW(wide.as_ptr()) };
+        if module.is_null() {
+            tracing::warn!(path = %path.display(), "FidelityFX: AMD's PC upscaler not found (set VICTORY_FFX_DIR); the title is told there is no upscaler");
+            return None;
+        }
+        let get = |name: &[u8]| {
+            // SAFETY: a loaded module and a nul-terminated name.
+            unsafe { GetProcAddress(module, name.as_ptr()) }
+        };
+        // SAFETY: the loader's exports have these signatures (ffx_api.h).
+        let pc = unsafe {
+            Pc {
+                create: std::mem::transmute::<_, Create>(get(b"ffxCreateContext\0")?),
+                destroy: std::mem::transmute::<_, Destroy>(get(b"ffxDestroyContext\0")?),
+                configure: std::mem::transmute::<_, Configure>(get(b"ffxConfigure\0")?),
+                query: std::mem::transmute::<_, Query>(get(b"ffxQuery\0")?),
+                dispatch: std::mem::transmute::<_, Dispatch>(get(b"ffxDispatch\0")?),
+            }
+        };
+        tracing::info!(path = %path.display(), "FidelityFX: AMD's PC upscaler loaded");
+        Some(pc)
+    })
+    .as_ref()
+}
+
+trait WideNull {
+    fn encode_wide_null(&self) -> Vec<u16>;
+}
+impl WideNull for std::ffi::OsStr {
+    fn encode_wide_null(&self) -> Vec<u16> {
+        use std::os::windows::ffi::OsStrExt;
+        self.encode_wide().chain(std::iter::once(0)).collect()
+    }
+}
+
+/// Logs each descriptor type in a chain once per entry point.
+fn note(entry: &'static str, desc: *const Header, answer: u32) {
+    static SEEN: Mutex<Vec<(&'static str, u64)>> = Mutex::new(Vec::new());
+    let mut at = desc;
+    for _ in 0..16 {
+        if at.is_null() {
+            break;
+        }
+        // SAFETY: the title's descriptor chain.
+        let h = unsafe { at.read_unaligned() };
+        let mut seen = SEEN.lock().unwrap_or_else(|e| e.into_inner());
+        if !seen.contains(&(entry, h.ty)) {
+            seen.push((entry, h.ty));
+            tracing::warn!(entry, desc_type = format_args!("{:#x}", h.ty), answer, "FidelityFX call");
+        }
+        at = h.next;
+    }
+}
+
+/// The links of a chain, by type.
+fn links(desc: *const Header) -> Vec<*const Header> {
+    let mut out = Vec::new();
+    let mut at = desc;
+    while !at.is_null() && out.len() < 16 {
+        out.push(at);
+        // SAFETY: the title's descriptor chain.
+        at = unsafe { (*at).next };
+    }
+    out
+}
+
+pub extern "system" fn ffxCreateContext(context: *mut *mut c_void, desc: *mut Header, _mem: *const c_void) -> u32 {
+    if context.is_null() || desc.is_null() {
+        return PARAMETER;
+    }
+    // SAFETY: the title's out pointer.
+    unsafe { context.write(std::ptr::null_mut()) };
+    let answer = (|| {
+        let pc = pc().ok_or(NO_PROVIDER)?;
+        let device = victory_gpu::list::host_device().ok_or(NO_PROVIDER)?;
+        // A chain of our own: the title's upscale links (copied, so its
+        // memory is not changed) and the PC backend naming the host device.
+        let mut kept: Vec<Vec<u8>> = Vec::new();
+        for link in links(desc) {
+            // SAFETY: a link of the title's chain.
+            let ty = unsafe { (*link).ty };
+            let size = match ty {
+                CREATE_UPSCALE => 16 + 4 + 8 + 8 + 4 + 8, // flags, two sizes, fpMessage (padded)
+                CREATE_UPSCALE_VERSION => 16 + 8,
+                _ => continue,
+            };
+            let mut bytes = vec![0u8; size];
+            // SAFETY: the title's descriptor of that type is at least that long.
+            unsafe { std::ptr::copy_nonoverlapping(link.cast::<u8>(), bytes.as_mut_ptr(), size) };
+            kept.push(bytes);
+        }
+        if !kept.iter().any(|k| u64::from_le_bytes(k[..8].try_into().unwrap_or_default()) == CREATE_UPSCALE) {
+            return Err(NO_PROVIDER);
+        }
+        // HybridGt: the upscale description's flags, said by name, and its
+        // message callback: ours (the title's is console code the PC DLL
+        // would call); `VICTORY_FFX_DEBUG=1` asks AMD's runtime to check the
+        // values it is given and say what it finds wrong through it;
+        // `VICTORY_FFX_ADD_FLAGS=<hex>` adds creation flags.
+        if let Some(k) = kept.iter_mut().find(|k| u64::from_le_bytes(k[..8].try_into().unwrap_or_default()) == CREATE_UPSCALE) {
+            let mut flags = u32::from_le_bytes(k[16..20].try_into().unwrap_or_default());
+            let asked = flags;
+            if std::env::var_os("VICTORY_FFX_DEBUG").is_some_and(|v| v == "1") {
+                flags |= 1 << 7;
+            }
+            if let Some(add) = std::env::var("VICTORY_FFX_ADD_FLAGS").ok().and_then(|v| u32::from_str_radix(v.trim().trim_start_matches("0x"), 16).ok()) {
+                flags |= add;
+            }
+            k[16..20].copy_from_slice(&flags.to_le_bytes());
+            let ours = ffx_message as extern "C" fn(u32, *const u16) as usize as u64;
+            k[40..48].copy_from_slice(&ours.to_le_bytes());
+            const NAMES: [&str; 10] = [
+                "high dynamic range",
+                "display-resolution motion vectors",
+                "jittered motion vectors",
+                "depth inverted",
+                "depth infinite",
+                "auto exposure",
+                "dynamic resolution",
+                "debug checking",
+                "non-linear colour",
+                "debug view",
+            ];
+            let named: Vec<&str> = (0..10).filter(|b| asked & (1 << b) != 0).map(|b| NAMES[b]).collect();
+            tracing::info!(
+                flags = format_args!("{asked:#x}"),
+                used = format_args!("{flags:#x}"),
+                ?named,
+                render = ?[u32::from_le_bytes(k[20..24].try_into().unwrap_or_default()), u32::from_le_bytes(k[24..28].try_into().unwrap_or_default())],
+                upscale = ?[u32::from_le_bytes(k[28..32].try_into().unwrap_or_default()), u32::from_le_bytes(k[32..36].try_into().unwrap_or_default())],
+                "FidelityFX: the title's upscale context"
+            );
+        }
+        // HybridGt: the version of the API the title was built against, the
+        // providers on offer and the one asked for.
+        if let Some(v) = kept.iter().find(|k| u64::from_le_bytes(k[..8].try_into().unwrap_or_default()) == CREATE_UPSCALE_VERSION) {
+            let asked = u32::from_le_bytes(v[16..20].try_into().unwrap_or_default());
+            tracing::info!(
+                "FidelityFX: the title asks for upscaler API {}.{}.{}",
+                asked >> 22,
+                (asked >> 12) & 0x3ff,
+                asked & 0xfff
+            );
+        }
+        let offered = versions(pc, device as *mut c_void);
+        tracing::info!(?offered, "FidelityFX: upscale providers AMD's PC DLLs offer on this card");
+        let mut chosen_link = chosen(&offered).map(|id| OverrideVersion {
+            header: Header { ty: OVERRIDE_VERSION, next: std::ptr::null_mut() },
+            version_id: id,
+        });
+        let mut backend = BackendDx12 { header: Header { ty: BACKEND_DX12, next: std::ptr::null_mut() }, device };
+        if let Some(o) = chosen_link.as_mut() {
+            o.header.next = &raw mut backend.header;
+        }
+        // Link: kept[0] -> kept[1] -> ... -> backend.
+        let mut next: *mut Header = match chosen_link.as_mut() {
+            Some(o) => &raw mut o.header,
+            None => &raw mut backend.header,
+        };
+        for k in kept.iter_mut().rev() {
+            let h = k.as_mut_ptr().cast::<Header>();
+            // SAFETY: our own copy of a link.
+            unsafe { (*h).next = next };
+            next = h;
+        }
+        let mut made: *mut c_void = std::ptr::null_mut();
+        // SAFETY: a valid chain of descriptors that outlives the call.
+        let r = unsafe { (pc.create)(&raw mut made, next, std::ptr::null()) };
+        if r != OK {
+            tracing::warn!(code = r, "FidelityFX: AMD's PC upscaler refused the context");
+            return Err(r);
+        }
+        // SAFETY: the title's out pointer.
+        unsafe { context.write(made) };
+        tracing::info!(
+            provider = provider(pc, made).as_deref().unwrap_or("not said"),
+            "FidelityFX: upscale context made on the host device"
+        );
+        Ok(())
+    })();
+    let code = answer.err().unwrap_or(OK);
+    note("ffxCreateContext", desc, code);
+    code
+}
+
+/// HybridGt: AMD's runtime's messages (errors and warnings; with
+/// `VICTORY_FFX_DEBUG=1` its checks of what it is given), into our log.
+extern "C" fn ffx_message(kind: u32, message: *const u16) {
+    if message.is_null() {
+        return;
+    }
+    let mut n = 0;
+    // SAFETY: a nul-terminated wide string of the DLL's, read up to 4096 units.
+    while n < 4096 && unsafe { *message.add(n) } != 0 {
+        n += 1;
+    }
+    // SAFETY: as above, `n` units.
+    let text = String::from_utf16_lossy(unsafe { std::slice::from_raw_parts(message, n) });
+    static SAID: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+    if SAID.fetch_add(1, std::sync::atomic::Ordering::Relaxed) < 200 {
+        if kind == 0 {
+            tracing::warn!(%text, "FidelityFX says (error)");
+        } else {
+            tracing::info!(%text, "FidelityFX says");
+        }
+    }
+}
+
+pub extern "system" fn ffxDestroyContext(context: *mut *mut c_void, _mem: *const c_void) -> u32 {
+    // SAFETY: the title's context pointer.
+    if context.is_null() || unsafe { (*context).is_null() } {
+        return PARAMETER;
+    }
+    match pc() {
+        // SAFETY: a context the PC upscaler made.
+        Some(pc) => unsafe { (pc.destroy)(context, std::ptr::null()) },
+        None => NO_PROVIDER,
+    }
+}
+
+pub extern "system" fn ffxConfigure(context: *mut *mut c_void, desc: *const Header) -> u32 {
+    let code = match pc() {
+        // SAFETY: plain data descriptors, passed on.
+        Some(pc) if !desc.is_null() => unsafe { (pc.configure)(context, desc) },
+        Some(_) => PARAMETER,
+        None => NO_PROVIDER,
+    };
+    note("ffxConfigure", desc, code);
+    code
+}
+
+pub extern "system" fn ffxQuery(context: *mut *mut c_void, desc: *mut Header) -> u32 {
+    let code = match pc() {
+        // SAFETY: plain data descriptors, passed on (results written to the
+        // title's memory, as the console DLL would).
+        Some(pc) if !desc.is_null() => unsafe { (pc.query)(context, desc) },
+        Some(_) => PARAMETER,
+        None => NO_PROVIDER,
+    };
+    note("ffxQuery", desc, code);
+    code
+}
+
+/// Host states (`D3D12_RESOURCE_STATES`) and the FidelityFX ones.
+const HOST_READ: u32 = 0x40 | 0x80;
+const HOST_UNORDERED: u32 = 0x8;
+const FFX_READ: u32 = (1 << 2) | (1 << 3);
+const FFX_UNORDERED: u32 = 1 << 1;
+
+pub extern "system" fn ffxDispatch(context: *mut *mut c_void, desc: *const Header) -> u32 {
+    if desc.is_null() || context.is_null() {
+        return PARAMETER;
+    }
+    // SAFETY: the title's descriptor.
+    let ty = unsafe { (*desc).ty };
+    let code = (|| {
+        let pc = pc().ok_or(NO_PROVIDER)?;
+        if ty != DISPATCH_UPSCALE {
+            return Err(NO_PROVIDER);
+        }
+        // SAFETY: an upscale dispatch descriptor.
+        let mut d = unsafe { desc.cast::<DispatchUpscale>().read_unaligned() };
+        static LOGGED: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+        let n = LOGGED.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        if n == 0 || n.is_power_of_two() && n <= 4096 {
+            let present = |r: &Resource| !r.resource.is_null();
+            tracing::info!(
+                dispatch = n,
+                render = ?d.render_size, upscale = ?d.upscale_size, jitter = ?d.jitter,
+                mv_scale = ?d.motion_vector_scale, color = ?d.color.desc, output = ?d.output.desc,
+                depth = present(&d.depth), motion = present(&d.motion_vectors), exposure = present(&d.exposure),
+                reactive = present(&d.reactive), transparency = present(&d.transparency),
+                pre_exposure = d.pre_exposure, frame_ms = d.frame_time_delta, reset = d.reset,
+                sharpen = d.enable_sharpening, sharpness = d.sharpness,
+                near = d.camera_near, far = d.camera_far, fov = d.camera_fov_vertical, meters = d.view_space_to_meters, flags = d.flags,
+                "FidelityFX: an upscale dispatch"
+            );
+        }
+        let list = d.command_list as *const c_void;
+        let host = |r: &mut Resource, state: u32, ffx: u32, write: bool| {
+            if r.resource.is_null() {
+                return true;
+            }
+            match victory_gpu::list::external_texture(list, r.resource as *const c_void, state, write) {
+                Some(h) => {
+                    r.resource = h;
+                    r.state = ffx;
+                    true
+                }
+                None => false,
+            }
+        };
+        let ok = host(&mut d.color, HOST_READ, FFX_READ, false)
+            && host(&mut d.depth, HOST_READ, FFX_READ, false)
+            && host(&mut d.motion_vectors, HOST_READ, FFX_READ, false)
+            && host(&mut d.exposure, HOST_READ, FFX_READ, false)
+            && host(&mut d.reactive, HOST_READ, FFX_READ, false)
+            && host(&mut d.transparency, HOST_READ, FFX_READ, false)
+            && host(&mut d.output, HOST_UNORDERED, FFX_UNORDERED, true);
+        if !ok {
+            tracing::warn!("FidelityFX: a texture of the dispatch has no host copy; not upscaled");
+            return Err(RUNTIME_ERROR);
+        }
+        d.header.next = std::ptr::null_mut();
+        let r = victory_gpu::list::record_external(list, |host_list| {
+            d.command_list = host_list;
+            // SAFETY: a PC upscale descriptor naming host objects that live
+            // until the list has run.
+            unsafe { (pc.dispatch)(context, &raw const d.header) }
+        })
+        .ok_or(RUNTIME_ERROR)?;
+        if r == OK { Ok(()) } else { Err(r) }
+    })();
+    let code = code.err().unwrap_or(OK);
+    note("ffxDispatch", desc, code);
+    code
+}
+
+pub(crate) fn module() -> HleModule {
+    HleModule {
+        name: "ffx",
+        dlls: &["amd_fidelityfx_upscaler_xbox.dll"],
+        exports: vec![
+            hle_export!(ffxCreateContext),
+            hle_export!(ffxDestroyContext),
+            hle_export!(ffxConfigure),
+            hle_export!(ffxQuery),
+            hle_export!(ffxDispatch),
+        ],
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// HybridGt: the providers AMD's PC DLLs offer on this machine's card,
+    /// and a context made through the title's entry point for 1280x720 to
+    /// 1920x1080, with the one `VICTORY_FFX_VERSION` names (`VICTORY_FFX_DIR`
+    /// set; `cargo test --release -p victory-hle ffx::tests -- --ignored --nocapture`).
+    #[test]
+    #[ignore]
+    fn providers_on_this_card() {
+        let pc = pc().expect("VICTORY_FFX_DIR with amd_fidelityfx_loader_dx12.dll");
+        let device = victory_gpu::list::host_device().expect("a host device");
+        let offered = versions(pc, device);
+        println!("offered: {offered:?}");
+        assert!(!offered.is_empty());
+        #[repr(C)]
+        struct CreateUpscale {
+            header: Header,
+            flags: u32,
+            max_render: [u32; 2],
+            max_upscale: [u32; 2],
+            message: *const c_void,
+        }
+        let mut desc = CreateUpscale {
+            header: Header { ty: CREATE_UPSCALE, next: std::ptr::null_mut() },
+            flags: 0,
+            max_render: [1280, 720],
+            max_upscale: [1920, 1080],
+            message: std::ptr::null(),
+        };
+        let mut context: *mut c_void = std::ptr::null_mut();
+        let code = ffxCreateContext(&raw mut context, &raw mut desc.header, std::ptr::null());
+        assert_eq!(code, OK);
+        println!("provider: {:?}", provider(pc, context));
+        assert_eq!(ffxDestroyContext(&raw mut context, std::ptr::null()), OK);
+    }
+}
