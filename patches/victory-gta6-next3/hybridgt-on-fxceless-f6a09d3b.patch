+    for (name, op) in [("s_mul_hi_u32", 0x35u32), ("s_mul_hi_i32", 0x36)] {
+        let words = [
+            0x8000_0000 | (op << 23) | (4 << 16) | (1 << 8), // s4 = op(s0, s1)
+            0x7E00_0280,                                     // v_mov_b32 v0, 0
+            0x7E02_0204,                                     // v_mov_b32 v1, s4
+            0xD834_0000,
+            0x0000_0100, // ds_write_b32 v0, v1
