+#[test]
+fn a_branch_that_writes_lds_two_different_values_keeps_64_lanes() {
+    // a second value after the read: what the flag ends up holding depends on what was read
+    assert_eq!(flag_wave(&flag_program(Some(2))), Some(64));
+}
