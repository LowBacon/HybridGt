+/// HybridGt: records host work the title did not ask for through the
+/// list's own methods (the PC upscaler behind the title's FidelityFX calls)
+/// into title list `this`'s host command list, given as a raw
+/// `ID3D12GraphicsCommandList`; then the list's next draw or dispatch binds
+/// the title's heaps, root signature and pipeline again. `None` without a
+/// host list.
+#[cfg(windows)]
+pub fn record_external<R>(this: *const std::ffi::c_void, record: impl FnOnce(*mut std::ffi::c_void) -> R) -> Option<R> {
+    use windows::core::Interface;
+    if this.is_null() {
+        return None;
+    }
+    // SAFETY: the title passes one of our lists.
+    let list = unsafe { &*this.cast::<List>() };
+    let host = list.host.as_ref()?;
+    let r = record(host.list.as_raw());
+    list.state.lock().unwrap_or_else(|e| e.into_inner()).forget_bindings();
+    Some(r)
+}
+
+/// HybridGt: title texture `resource`'s host copy, moved to host state
+/// `state` in title list `this` (a depth texture's colour twin brought up
+/// to date first), as a raw `ID3D12Resource`, for work recorded with
+/// [`record_external`].
+#[cfg(windows)]
+pub fn external_texture(this: *const std::ffi::c_void, resource: *const std::ffi::c_void, state: u32, write: bool) -> Option<*mut std::ffi::c_void> {
+    use windows::core::Interface;
+    if this.is_null() || resource.is_null() {
+        return None;
+    }
+    // SAFETY: the title passes one of our lists.
+    let list = unsafe { &*this.cast::<List>() };
+    let host = list.host.as_ref()?;
+    let resource = resource as This;
+    host.twin_use(resource, false, write);
+    ensure_state(host, resource, state);
+    crate::resource::host_resource(resource).map(|r| r.as_raw())
+}
+
+/// HybridGt: the host D3D12 device as a raw `ID3D12Device`, if there is one.
+#[cfg(windows)]
+pub fn host_device() -> Option<*mut std::ffi::c_void> {
+    use windows::core::Interface;
+    crate::host::host().map(|h| h.device.as_raw())
+}
