+    // product rounded in f32 first would land on the wrong integer.
+    for scale in [32767.0f64, 65535.0] {
+        for n in (0..32767).step_by(997).chain([0, 1, 16383, 32766]) {
+            let x = ((f64::from(n) + 0.5) / scale) as f32;
