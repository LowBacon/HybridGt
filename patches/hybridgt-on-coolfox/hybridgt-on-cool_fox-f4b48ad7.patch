+        f(known)
+    }
+
+    #[cfg(test)]
+    mod tests {
+        /// What one run notes, the file holds once, and the map answers.
+        #[test]
+        fn formats_are_remembered_once_and_written_down() {
+            let dir = std::env::temp_dir().join(format!("hgt-formats-{}", std::process::id()));
+            std::fs::create_dir_all(&dir).unwrap();
+            // SAFETY: set before the module's first look at it, in this test only.
+            unsafe { std::env::set_var("VICTORY_CACHE_DIR", &dir) };
+            super::remember("k1", &[28, 10], 45);
+            super::remember("k1", &[28, 10], 45);
+            super::remember("k1", &[87], 0);
+            assert_eq!(super::remembered("k1"), vec![(vec![28, 10], 45), (vec![87], 0)]);
+            assert!(super::remembered("k2").is_empty());
+            let text = std::fs::read_to_string(dir.join("console-formats.txt")).unwrap();
+            assert_eq!(text.lines().collect::<Vec<_>>(), ["k1 45 28 10", "k1 0 87"]);
+            let _ = std::fs::remove_dir_all(&dir);
+        }
+    }
+
+    /// The name a pipeline's format sets are kept under: its key, with `r`
+    /// for its rectangle-list version.
+    pub(super) fn name(key: &str, rects: bool) -> String {
+        if rects { format!("{key}r") } else { key.to_owned() }
+    }
+
+    /// The format sets an earlier run drew pipeline `key` with.
+    pub(super) fn remembered(key: &str) -> Sets {
+        with(|m| m.get(key).cloned().unwrap_or_default())
+    }
+
+    /// Notes that pipeline `key` was drawn with `targets` and `depth`.
+    pub(super) fn remember(key: &str, targets: &[i32], depth: i32) {
+        let new = with(|m| {
+            let sets = m.entry(key.to_owned()).or_default();
+            let new = !sets.iter().any(|s| s.0 == targets && s.1 == depth);
+            if new {
+                sets.push((targets.to_vec(), depth));
+            }
+            new
+        });
+        if new && let Some(path) = file() {
+            let line: Vec<String> = targets.iter().map(i32::to_string).collect();
+            if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+                let _ = writeln!(f, "{key} {depth} {}", line.join(" "));
+            }
+        }
+    }
+}
