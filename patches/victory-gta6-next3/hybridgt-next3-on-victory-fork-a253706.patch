+        if last.is_some_and(|l| l.elapsed().as_millis() < 1000) {
+            return;
+        }
+        *last = Some(std::time::Instant::now());
+    }
+    let ranges = TRACED.lock().unwrap_or_else(|e| e.into_inner()).clone();
+    for (at, len, groups, shader) in ranges {
+        let n = len.min(64);
+        let mut bytes = vec![0u8; n];
+        if read_into(at as *const u8, &mut bytes) {
+            let f: Vec<String> = bytes.chunks_exact(4).map(|c| format!("{:.3}", f32::from_le_bytes([c[0], c[1], c[2], c[3]]))).collect();
