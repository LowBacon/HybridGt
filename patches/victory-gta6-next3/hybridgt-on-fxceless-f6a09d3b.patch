+/// The 64 KiB pages `[at, end)` that hold `[start, start + len)`.
+pub(crate) fn pages_of_range(start: u64, len: u64) -> (u64, u64) {
+    (start & !(K64 as u64 - 1), (start + len.max(1)).next_multiple_of(K64 as u64))
