+/// f32 bit patterns at the edges: signed zeros, denormals, the ends of the
+/// normal range, around 0.5 and 1, large values, infinities and NaNs.
+const F32_EDGES: &[u32] = &[
+    0x0000_0000,
+    0x8000_0000,
+    0x0000_0001,
+    0x8000_0001,
+    0x0040_0000,
+    0x007F_FFFF,
+    0x807F_FFFF,
+    0x0080_0000,
+    0x8080_0000,
+    0x0080_0001,
+    0x3E4C_CCCD,
+    0xBE4C_CCCD,
+    0x3EFF_FFFF,
+    0x3F00_0000,
+    0xBF00_0000,
+    0x3F00_0001,
+    0x3F7F_FFFF,
+    0xBF7F_FFFF,
+    0x3F80_0000,
+    0xBF80_0000,
+    0x3F80_0001,
+    0x3FC0_0000,
+    0x4040_0000,
+    0x42C9_0000,
+    0xC2C9_0000,
+    0x4B00_0000,
+    0x4B80_0000,
+    0x477F_E000,
+    0x7F7F_FFFF,
+    0xFF7F_FFFF,
