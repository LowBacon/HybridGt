 impl GraphicsState {
     /// Takes in one subobject of a stream: its type, then its data at +4
     /// (+8 for those holding pointers).
     ///
     /// # Safety
     /// `at` points at a whole subobject of type `kind`.
+    /// HybridGt: the state of a device-method 0x1c8 pipeline, from the
+    /// console description's register block (`regs`, 0x184 bytes: word 1)
+    /// and vertex layout (`layout`, word 3), with the render-target and
+    /// depth formats bound where it is drawn (the description has none).
+    ///
+    /// Register block, decoded from 1,746 descriptions of a new game's
+    /// prologue (tools/decode_1c8.py): +0xa0 PA_SU_SC_MODE_CNTL (cull and
+    /// front face), +0xb8 DB_DEPTH_CONTROL, +0xc0 DB_STENCILREFMASK, +0xcc
+    /// CB_TARGET_MASK, +0xd0..+0xec CB_BLEND0-7_CONTROL. Vertex layout: a
+    /// count at +0x4c, then per element its name's length, the name, and
+    /// the six words of an input element (index, format, slot, offset,
+    /// class, step rate).
+    /// shortcut: stencil operations are not decoded yet (KEEP), and the
+    /// topology type is triangles.
+    /// `rects`: drawn as the console's rectangle lists, which the host
+    /// pipeline completes in a geometry stage (as a stream pipeline that
+    /// names that topology); drawn without it each rectangle showed its
+    /// first triangle only (the intro's grids of half squares).
+    pub(crate) fn console(regs: &[u8], layout: &[u8], targets: &[DXGI_FORMAT], depth: DXGI_FORMAT, rects: bool) -> GraphicsState {
+        let mut g = GraphicsState::default();
+        let r = |off: usize| regs.get(off..off + 4).map_or(0, |b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]));
+        // AMD blend factors (CB_BLEND*_CONTROL) to D3D12's; as an alpha
+        // factor a colour one becomes its alpha form.
+        let factor = |v: u32, alpha: bool| -> D3D12_BLEND {
+            let f = match v {
+                0 => D3D12_BLEND_ZERO,
+                1 => D3D12_BLEND_ONE,
+                2 => D3D12_BLEND_SRC_COLOR,
+                3 => D3D12_BLEND_INV_SRC_COLOR,
+                4 => D3D12_BLEND_SRC_ALPHA,
+                5 => D3D12_BLEND_INV_SRC_ALPHA,
+                6 => D3D12_BLEND_DEST_ALPHA,
+                7 => D3D12_BLEND_INV_DEST_ALPHA,
+                8 => D3D12_BLEND_DEST_COLOR,
+                9 => D3D12_BLEND_INV_DEST_COLOR,
+                10 => D3D12_BLEND_SRC_ALPHA_SAT,
+                13 | 19 => D3D12_BLEND_BLEND_FACTOR,
+                14 | 20 => D3D12_BLEND_INV_BLEND_FACTOR,
+                15 => D3D12_BLEND_SRC1_COLOR,
+                16 => D3D12_BLEND_INV_SRC1_COLOR,
+                17 => D3D12_BLEND_SRC1_ALPHA,
+                18 => D3D12_BLEND_INV_SRC1_ALPHA,
+                _ => D3D12_BLEND_ONE,
+            };
+            if !alpha {
+                return f;
+            }
+            match f {
+                D3D12_BLEND_SRC_COLOR => D3D12_BLEND_SRC_ALPHA,
+                D3D12_BLEND_INV_SRC_COLOR => D3D12_BLEND_INV_SRC_ALPHA,
+                D3D12_BLEND_DEST_COLOR => D3D12_BLEND_DEST_ALPHA,
+                D3D12_BLEND_INV_DEST_COLOR => D3D12_BLEND_INV_DEST_ALPHA,
+                D3D12_BLEND_SRC1_COLOR => D3D12_BLEND_SRC1_ALPHA,
+                D3D12_BLEND_INV_SRC1_COLOR => D3D12_BLEND_INV_SRC1_ALPHA,
+                other => other,
+            }
+        };
+        let op = |v: u32| match v {
+            1 => D3D12_BLEND_OP_SUBTRACT,
+            2 => D3D12_BLEND_OP_MIN,
+            3 => D3D12_BLEND_OP_MAX,
+            4 => D3D12_BLEND_OP_REV_SUBTRACT,
+            _ => D3D12_BLEND_OP_ADD,
+        };
+        let mask = r(0xcc);
+        g.blend.IndependentBlendEnable = true.into();
+        for (i, rt) in g.blend.RenderTarget.iter_mut().enumerate() {
+            let v = r(0xd0 + 4 * i);
+            rt.RenderTargetWriteMask = ((mask >> (4 * i)) & 0xf) as u8;
+            if v & (1 << 30) != 0 {
+                rt.BlendEnable = true.into();
+                rt.SrcBlend = factor(v & 31, false);
+                rt.BlendOp = op((v >> 5) & 7);
+                rt.DestBlend = factor((v >> 8) & 31, false);
+                let (src, comb, dst) = if v & (1 << 29) != 0 { ((v >> 16) & 31, (v >> 21) & 7, (v >> 24) & 31) } else { (v & 31, (v >> 5) & 7, (v >> 8) & 31) };
+                rt.SrcBlendAlpha = factor(src, true);
+                rt.BlendOpAlpha = op(comb);
+                rt.DestBlendAlpha = factor(dst, true);
+            }
+        }
+        // Dual-source blending (SRC1 factors) is allowed on target 0 only, with
+        // no other target blending; the console repeats target 0's control in
+        // all eight registers (2 of 1,746 prologue pipelines were refused so).
+        let dual = |rt: &D3D12_RENDER_TARGET_BLEND_DESC| {
+            [rt.SrcBlend, rt.DestBlend, rt.SrcBlendAlpha, rt.DestBlendAlpha].iter().any(|f| {
+                matches!(*f, D3D12_BLEND_SRC1_COLOR | D3D12_BLEND_INV_SRC1_COLOR | D3D12_BLEND_SRC1_ALPHA | D3D12_BLEND_INV_SRC1_ALPHA)
+            })
+        };
+        if g.blend.RenderTarget.iter().any(|rt| rt.BlendEnable.as_bool() && dual(rt)) {
+            for rt in g.blend.RenderTarget.iter_mut().skip(1) {
+                rt.BlendEnable = false.into();
+                rt.SrcBlend = D3D12_BLEND_ONE;
+                rt.DestBlend = D3D12_BLEND_ZERO;
+                rt.SrcBlendAlpha = D3D12_BLEND_ONE;
+                rt.DestBlendAlpha = D3D12_BLEND_ZERO;
+            }
+        }
+        let func = |v: u32| D3D12_COMPARISON_FUNC((v & 7) as i32 + 1);
+        let dc = r(0xb8);
+        let refmask = r(0xc0);
+        let has_depth = depth != DXGI_FORMAT_UNKNOWN;
+        g.depth.DepthEnable = (has_depth && dc & 2 != 0).into();
+        g.depth.DepthWriteMask = if dc & 4 != 0 { D3D12_DEPTH_WRITE_MASK_ALL } else { D3D12_DEPTH_WRITE_MASK_ZERO };
+        g.depth.DepthFunc = func(dc >> 4);
+        g.depth.StencilEnable = (has_depth && dc & 1 != 0).into();
+        g.depth.StencilReadMask = ((refmask >> 8) & 0xff) as u8;
+        g.depth.StencilWriteMask = ((refmask >> 16) & 0xff) as u8;
+        g.depth.FrontFace.StencilFunc = func(dc >> 8);
+        g.depth.BackFace.StencilFunc = if dc & (1 << 7) != 0 { func(dc >> 20) } else { func(dc >> 8) };
+        let sc = r(0xa0);
+        g.rasterizer.CullMode = match sc & 3 {
+            1 => D3D12_CULL_MODE_FRONT,
+            2 => D3D12_CULL_MODE_BACK,
+            _ => D3D12_CULL_MODE_NONE,
+        };
+        g.rasterizer.FrontCounterClockwise = (sc & 4 == 0).into();
+        g.topology = if rects { D3D12_PRIMITIVE_TOPOLOGY_TYPE(RECTANGLES) } else { D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE };
+        // The vertex layout.
+        let word = |at: usize| layout.get(at..at + 4).map(|b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]));
+        let count = word(0x4c).unwrap_or(0).min(32) as usize;
+        let mut at = 0x50;
+        let mut elements = Vec::new();
+        for _ in 0..count {
+            let Some(len) = word(at).map(|l| l as usize).filter(|l| (1..=64).contains(l)) else { break };
+            let Some(name) = layout.get(at + 4..at + 4 + len) else { break };
+            let name = CString::new(name.split(|&b| b == 0).next().unwrap_or_default()).unwrap_or_default();
+            let f = at + 4 + len;
+            let (Some(index), Some(format), Some(slot), Some(offset), Some(class), Some(step)) =
+                (word(f), word(f + 4), word(f + 8), word(f + 12), word(f + 16), word(f + 20))
+            else {
+                break;
+            };
+            elements.push((name, index, format, slot, offset, class, step));
+            at = f + 24;
+        }
+        g.names = elements.iter().map(|e| e.0.clone()).collect();
+        g.inputs = elements
+            .iter()
+            .zip(&g.names)
+            .map(|(e, name)| D3D12_INPUT_ELEMENT_DESC {
+                SemanticName: PCSTR(name.as_ptr().cast()),
+                SemanticIndex: e.1,
+                Format: DXGI_FORMAT(crate::resource::pc_format(e.2) as i32),
+                InputSlot: e.3,
+                AlignedByteOffset: e.4,
+                InputSlotClass: D3D12_INPUT_CLASSIFICATION(e.5 as i32),
