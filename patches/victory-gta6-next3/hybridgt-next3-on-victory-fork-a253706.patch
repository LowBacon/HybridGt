+#[cfg(all(test, windows))]
+mod read_cost_tests {
+    /// HybridGt: what reading title memory through the kernel costs against a
+    /// plain copy, for one frame's refreshes (155 MB in 64 KiB reads, run
+    /// next12). Ignored by default:
+    /// `cargo test -p victory-gpu --release -- --ignored read_cost --nocapture`
+    #[test]
+    #[ignore]
+    fn read_cost() {
+        const TOTAL: usize = 155 << 20;
+        let src = vec![7u8; TOTAL];
+        let mut dst = vec![0u8; TOTAL];
+        for piece in [4 << 10, 64 << 10, 1 << 20] {
+            let t = std::time::Instant::now();
+            for at in (0..TOTAL).step_by(piece) {
+                assert!(super::read(src[at..].as_ptr(), dst[at..].as_mut_ptr(), piece));
+            }
+            let kernel = t.elapsed();
+            let t = std::time::Instant::now();
+            for at in (0..TOTAL).step_by(piece) {
+                dst[at..at + piece].copy_from_slice(&src[at..at + piece]);
+            }
+            let plain = t.elapsed();
+            eprintln!("155 MB in {} KiB pieces: kernel read {kernel:?}, plain copy {plain:?}", piece >> 10);
+        }
+    }
+}
