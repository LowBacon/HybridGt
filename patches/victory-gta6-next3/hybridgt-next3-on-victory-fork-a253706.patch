+                for x in 0..128 {
+                    let at = y * PITCH as usize + x * 4;
+                    for c in 0..3 {
+                        let got = i32::from(bytes[at + c]);
+                        assert!((got - want[c]).abs() <= 2, "pixel {x},{y} channel {c}: {got}, want about {}", want[c]);
+                    }
+                }
+            }
+            eprintln!("FSR 1 upscaled 64x36 to 128x72; every pixel kept the flat colour");
+        }
+    }
