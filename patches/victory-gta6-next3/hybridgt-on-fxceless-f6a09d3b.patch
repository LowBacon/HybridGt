+
+/// The switch's value: 0 off, 1 on, 2 `alt`.
+fn mode_of(value: Option<&str>) -> u8 {
+    match value.map(str::trim) {
+        Some("1") => 1,
+        Some("alt") => 2,
+        _ => 0,
+    }
