+/// Bit `i` of the result is whether any of bits `4i..4i+3` of `pixels` is set.
+fn quad_mask_reference(pixels: u64) -> u64 {
+    (0..16).fold(0, |m, i| m | u64::from(pixels >> (4 * i) & 0xF != 0) << i)
+}
