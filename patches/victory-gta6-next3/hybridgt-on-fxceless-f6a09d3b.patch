+/// HybridGt: a console stencil operation (four bits of DB_STENCIL_CONTROL) as the host's.
+/// The console's: keep, zero, ones, replace by the test value, replace by the operation
+/// value, add and subtract clamped, invert, add and subtract wrapping, then bitwise ones.
+/// shortcut: the host has one reference, the test value: "ones" and "replace by the
+/// operation value" become a replace by it, adds and subtracts step by one whatever the
+/// operation value, and the bitwise operations keep.
+fn stencil_op(v: u32) -> D3D12_STENCIL_OP {
+    match v & 0xf {
+        0 => D3D12_STENCIL_OP_KEEP,
+        1 => D3D12_STENCIL_OP_ZERO,
+        2..=4 => D3D12_STENCIL_OP_REPLACE,
+        5 => D3D12_STENCIL_OP_INCR_SAT,
+        6 => D3D12_STENCIL_OP_DECR_SAT,
+        7 => D3D12_STENCIL_OP_INVERT,
+        8 => D3D12_STENCIL_OP_INCR,
+        9 => D3D12_STENCIL_OP_DECR,
+        _ => D3D12_STENCIL_OP_KEEP,
+    }
