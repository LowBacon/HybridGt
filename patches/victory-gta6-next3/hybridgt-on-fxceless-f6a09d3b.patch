+/// The host pipeline of `this` for a draw into `targets` (formats as the
+/// host views them) and `depth`: a 0x1c8 pipeline's for those formats
+/// (made on first use), any other pipeline's own ([`host_pipeline`]).
+#[cfg(windows)]
+pub(crate) fn console_pipeline_for<'a>(
+    this: This,
+    targets: &[windows::Win32::Graphics::Dxgi::Common::DXGI_FORMAT],
+    depth: windows::Win32::Graphics::Dxgi::Common::DXGI_FORMAT,
+    rects: bool,
+    bound: &host::TargetFormats,
+) -> Option<&'a host::HostPipeline> {
+    if this.is_null() {
+        return None;
+    }
+    let p = pipeline(this);
+    // Any other pipeline: its own host pipeline, or one for the formats
+    // bound if they are not the ones it declares (fxceless).
+    let Some(console) = &p.console else {
+        return host_pipeline_for(this, bound);
+    };
+    let key: Vec<i32> = targets.iter().map(|f| f.0).collect();
+    let pending: *const Arc<make::Pending> = {
+        let mut made = console.made.lock().unwrap_or_else(|e| e.into_inner());
+        match made.iter().find(|m| m.0 == key && m.1 == depth.0 && m.2 == rects) {
+            Some(m) => &*m.3,
+            None => {
+                let state = host::GraphicsState::console(&console.regs, &console.layout, targets, depth, rects);
+                let pending = Box::new(Arc::new(make::Pending::new(console.shaders.clone(), Some(Box::new(state)))));
+                let at: *const Arc<make::Pending> = &*pending;
+                formats::remember(&formats::name(&console.key, rects), &key, depth.0);
+                made.push((key, depth.0, rects, pending));
+                at
+            }
+        }
+    };
+    // SAFETY: boxed, and kept while the pipeline lives (never removed).
+    make::ready(unsafe { &*pending })
+}
