diff --git a/crates/victory-shader/src/emit/lower.rs b/crates/victory-shader/src/emit/lower.rs
index a6360fd..1b55664 100644
--- a/crates/victory-shader/src/emit/lower.rs
+++ b/crates/victory-shader/src/emit/lower.rs
@@ -1262,6 +1262,8 @@ impl<'a> Lower<'a> {
                 let n = i.name();
                 n.starts_with("ds_swizzle")
                     || n.contains("permute")
+                    // HybridGt: row permutes (within 32-lane halves)
+                    || n.starts_with("v_permlane")
                     || n.starts_with("v_mbcnt")
                     || matches!(n, "v_readlane_b32" | "v_writelane_b32")
                     || matches!(&i.fields, Fields::Valu(v) if v.dpp.is_some())
@@ -7244,6 +7246,43 @@ impl<'a> Lower<'a> {
                 }
                 Ok(())
             }
+            // HybridGt: `v_permlane16_b32` / `v_permlanex16_b32 d, x, s1, s2`:
+            // lane l takes `x` of lane (row base) + nibble (l & 15) of the
+            // 64-bit select s2:s1, the row base being l's own 16-lane row
+            // (`16`) or the other row of its 32 lanes (`x16`). Inside 32-lane
+            // halves, so exact in host waves of 32 or 64. Read lanes are
+            // assumed active (FI and bound_ctrl, `op_sel`, are refused).
+            "v_permlane16_b32" | "v_permlanex16_b32" => {
+                if v.opsel != 0 {
+                    return Err("v_permlane with fetch-inactive or bound_ctrl");
+                }
+                let (x, s1, s2) = (s(self, 0)?, s(self, 1)?, s(self, 2)?);
+                self.cross_lane(false)?;
+                let l = self.lane_index();
+                let k = |m: &mut super::bitcode::Module, v: u32| m.i32(v);
+                let m = &mut self.s.m;
+                let (k15, k7, k8, k2, k16) = (k(m, 15), k(m, 7), k(m, 8), k(m, 2), k(m, 16));
+                let n = m.bin(c, Bin::And, l, k15);
+                let low = m.cmp(c, pred::IULT, n, k8);
+                let word = m.select(c, low, s1, s2);
+                let n7 = m.bin(c, Bin::And, n, k7);
+                let sh = m.bin(c, Bin::Shl, n7, k2);
+                let nib = m.bin(c, Bin::LShr, word, sh);
+                let nib = m.bin(c, Bin::And, nib, k15);
+                let base = if name == "v_permlanex16_b32" {
+                    let not31 = k(m, !31);
+                    let half = m.bin(c, Bin::And, l, not31);
+                    let row = m.bin(c, Bin::And, l, k16);
+                    let other = m.bin(c, Bin::Xor, row, k16);
+                    m.bin(c, Bin::Or, half, other)
+                } else {
+                    let not15 = k(m, !15);
+                    m.bin(c, Bin::And, l, not15)
+                };
+                let src = m.bin(c, Bin::Add, base, nib);
+                let r = self.read_lane(x, src);
+                int(self, r)
+            }
             "v_readlane_b32" => {
                 let (a, lane) = (s(self, 0)?, s(self, 1)?);
                 // A computed lane in a pixel or vertex program is a host lane
diff --git a/crates/victory-shader/src/emit/valu_tests.rs b/crates/victory-shader/src/emit/valu_tests.rs
index d3f1171..a49f44d 100644
--- a/crates/victory-shader/src/emit/valu_tests.rs
+++ b/crates/victory-shader/src/emit/valu_tests.rs
@@ -1299,3 +1299,59 @@ fn v_cvt_f32_f64_rounds_like_ieee() {
         assert_eq!(got, want.to_bits(), "{backend}: v_cvt_f32_f64({x:e}) = {:e} ({got:#010x}), want {want:e}", f32::from_bits(got));
     });
 }
