+/// HybridGt diagnostic: for the first calls of methods 0x1c8 and 0x218, each
+/// (address, size) pair among the description's first 24 words: its first
+/// words, and whether it lies inside a shader container (`DXBC`, found by
+/// looking back up to 4 MiB for a header whose size reaches past it). If the
+/// code those methods name is a container's, the pipelines can be made from
+/// the containers the translator handles.
+#[cfg(windows)]
+fn find_containers(slot: usize, call: u32, desc: usize) {
+    let read = |at: usize, n: usize| -> Option<Vec<u8>> {
+        let mut b = vec![0u8; n];
+        (at != 0 && crate::host::read_into(at as *const u8, &mut b)).then_some(b)
+    };
+    let Some(head) = read(desc, 24 * 8) else {
+        return;
+    };
+    let words: Vec<u64> = head.chunks_exact(8).map(|c| u64::from_le_bytes(c.try_into().unwrap_or([0; 8]))).collect();
+    let mut found = Vec::new();
+    for i in 0..words.len() - 1 {
+        let (at, size) = (words[i] as usize, words[i + 1] as usize);
+        if !(0x10..=0x10_0000).contains(&size) || at < 0x10000 {
+            continue;
+        }
+        let Some(first) = read(at, 16) else {
+            continue;
+        };
+        let first: Vec<String> = first.chunks_exact(4).map(|c| format!("{:08x}", u32::from_le_bytes(c.try_into().unwrap_or([0; 4])))).collect();
+        // Back from `at`, 64 KiB at a time, for "DXBC" whose size covers it.
+        let mut container = None;
+        let mut chunk_end = at + 4;
+        'back: for _ in 0..64 {
+            let start = chunk_end.saturating_sub(64 << 10);
+            let Some(bytes) = read(start, chunk_end - start) else {
+                break;
+            };
+            let mut k = bytes.len().saturating_sub(4);
+            loop {
+                if &bytes[k..k + 4] == b"DXBC" && k + 28 <= bytes.len() {
+                    let total = u32::from_le_bytes(bytes[k + 24..k + 28].try_into().unwrap_or([0; 4])) as usize;
+                    let base = start + k;
+                    if base + total >= at + size {
+                        container = Some((base, total, at - base));
+                        break 'back;
+                    }
+                }
+                if k == 0 {
+                    break;
+                }
+                k -= 1;
+            }
+            chunk_end = start + 4;
+            if start == 0 {
+                break;
+            }
+        }
+        found.push(format!(
+            "w{i}: {at:#x}+{size:#x} [{}] container {:x?}",
+            first.join(" "),
+            container
+        ));
+    }
+    tracing::warn!(slot = format_args!("{slot:#x}"), call, "pipeline method description, pairs: {}", found.join(" | "));
+}
