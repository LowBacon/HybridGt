+        0xBE88_03FF, 0x0000_0092,       // clamp all axes
+        0xF09C_0F08, 0x0043_0C02,       // image_sample_lz v[12:15], ..., s[8:11]
+        0xD834_0000, 0x0000_0C00,       // ds_write_b32 v0, v12
