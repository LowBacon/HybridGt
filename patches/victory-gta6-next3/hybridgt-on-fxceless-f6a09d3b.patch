index 00000000..d8425981
--- /dev/null
+++ b/crates/victory-gpu/src/lazyback.rs
@@ -0,0 +1,385 @@
+//! HybridGt: copy-back on first touch (`VICTORY_LAZY_BACK=1`; off by default).
+//!
+//! What the relay copies back from copies in the card's memory is mostly
+//! never read by the title's CPU before the card writes it again: run next22
+//! probed 153,816 merged pieces (7.2 GB) and the title touched 10,046 of
+//! them (`crate::readprobe`). shadPS4 handles the same (its "precise"
+//! readback): GPU-written pages lose CPU access and come down when touched.
+//!
+//! Here, a piece the card's compare flags at a landing is not fetched: it is
+//! noted pending and the 4 KiB pages it covers (in every view of them) are
+//! made no-access. It comes down, through the direct queue (behind every
+//! flight that wrote it), and is merged as the relay merges, when:
+//! - the title touches one of its pages (the exception handler here);
+//! - this runtime reads or writes title memory there (`crate::host`'s
+//!   kernel reads and writes call [`ensure`] first: they would fail on the
+//!   pages instead of faulting);
+//! - a later landing flags it again: it stays pending (newer bytes on the
+//!   card), nothing is fetched.
+//!
+//! Title fences are signalled after the landing that noted the piece, so a
+//! read the title makes after its fence faults here.
+//!
+//! shortcut: pages are whole 4 KiB pages, so a touch of bytes beside a piece
+//! in the same page fetches it; a remap of the memory drops what is pending
+//! there unfetched (the memory shows other pages then).
+
+use std::cell::Cell;
+use std::collections::{BTreeMap, HashMap};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+
+use crate::shadow::Shadow;
+
+const PAGE: usize = 4096;
+
+pub(crate) fn on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| crate::shadow::relay() && std::env::var_os("VICTORY_LAZY_BACK").is_some_and(|v| v == "1"))
+}
+
+struct Pending {
+    shadow: Arc<Shadow>,
+    /// Bytes of the copy.
+    lo: usize,
+    hi: usize,
+    /// Title pages protected for it (every view), each with the protection
+    /// to give back.
+    pages: Vec<(usize, u32)>,
+}
+
+#[derive(Default)]
+struct Lazy {
+    /// By title address of the piece's first byte.
+    pending: BTreeMap<usize, Pending>,
+    /// Page number -> the pending pieces (their keys) that protect it.
+    pages: HashMap<usize, Vec<usize>>,
+}
+
+static LAZY: Mutex<Option<Lazy>> = Mutex::new(None);
+
+/// Pieces deferred, fetched on a title touch, fetched for this runtime,
+/// flagged again while pending, dropped by a remap; bytes deferred.
+static STATS: [AtomicU64; 6] = [const { AtomicU64::new(0) }; 6];
+
+/// Pieces not deferred because a page of theirs could not be closed.
+static NOT_CLOSED: AtomicU64 = AtomicU64::new(0);
+
+/// Pieces pending now (a check without the lock for [`ensure`]).
+static PENDING: AtomicU64 = AtomicU64::new(0);
+
+/// 64 KiB blocks of title memory with pending pieces, and how many: the
+/// check [`ensure`] makes before it takes the lock (next24: the texture
+/// pass, which reads title memory thousands of times a frame, went from
+/// 2-7 ms to 105-181 ms taking the lock each time).
+static BLOCKS: std::sync::RwLock<Option<HashMap<usize, u32>>> = std::sync::RwLock::new(None);
+
+fn blocks_of(at: usize, len: usize) -> std::ops::RangeInclusive<usize> {
+    (at >> 16)..=((at + len.max(1) - 1) >> 16)
+}
+
+fn blocks_add(at: usize, len: usize, by: i64) {
+    let mut b = BLOCKS.write().unwrap_or_else(|e| e.into_inner());
+    let map = b.get_or_insert_with(HashMap::new);
+    for block in blocks_of(at, len) {
+        let n = map.entry(block).or_insert(0);
+        *n = (i64::from(*n) + by).max(0) as u32;
+        if *n == 0 {
+            map.remove(&block);
+        }
+    }
+}
+
+/// Whether `[at, at + len)` may hold a pending piece.
+fn maybe_pending(at: usize, len: usize) -> bool {
+    let b = BLOCKS.read().unwrap_or_else(|e| e.into_inner());
+    let Some(map) = b.as_ref() else { return false };
+    blocks_of(at, len).any(|block| map.contains_key(&block))
+}
+
+/// The longest piece (the card's compare pieces are 64 KiB).
+const LONGEST: usize = 1 << 20;
+
+thread_local! {
+    /// Inside a fetch on this thread: [`ensure`] does nothing (the merge
+    /// reads and writes the piece's own memory, opened first).
+    static FETCHING: Cell<bool> = const { Cell::new(false) };
+}
+
+fn lazy() -> std::sync::MutexGuard<'static, Option<Lazy>> {
+    LAZY.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// The title addresses showing the 4 KiB page `page`: it, and its other
+/// views (`crate::inplace`, by 64 KiB block).
+fn views_of(page: usize) -> Vec<usize> {
+    let at = page * PAGE;
+    let block = at & !0xFFFF;
+    let mut all: Vec<usize> = crate::inplace::pages_of(block).into_iter().map(|b| (b + (at - block)) / PAGE).collect();
+    if !all.contains(&page) {
+        all.push(page);
+    }
+    all
+}
+
+/// At a landing: piece `[lo, hi)` of `shadow` was flagged. `true` if it is
+/// now pending (the caller fetches nothing for it); `false` leaves the
+/// fetch to the caller.
+pub(crate) fn defer(shadow: &Arc<Shadow>, lo: usize, hi: usize) -> bool {
+    if !on() || lo >= hi {
+        return false;
+    }
+    install();
+    let start = shadow.start_address() as usize;
+    let (at, end) = (start + lo, start + hi);
+    // The other host copies of these bytes (buffers, textures over the same
+    // memory) learn that shaders wrote them as they do from a merge: their
+    // guarded blocks are opened, so they take the bytes again, and their
+    // read (`crate::host::copy_mapped`) brings the piece down first. Without
+    // it they kept the bytes from before and the card computed from them
+    // (next24, next25, next27: the title then wrote through null). Before
+    // this module's lock: the guards call back into it with theirs held.
+    crate::watch::writing(at, end - at);
+    let mut g = lazy();
+    let l = g.get_or_insert_with(Lazy::default);
+    if let Some(p) = l.pending.get(&at)
+        && std::sync::Arc::ptr_eq(&p.shadow, shadow)
+        && p.hi == hi
+    {
+        STATS[3].fetch_add(1, Ordering::Relaxed);
+        return true;
+    }
+    // Another pending piece over these bytes (of another copy): fetch now.
+    if l.pending.range(at.saturating_sub(LONGEST)..end).any(|(&k, p)| k + (p.hi - p.lo) > at && k != at) {
+        return false;
+    }
+    use windows_sys::Win32::System::Memory::{PAGE_NOACCESS, PAGE_READONLY, PAGE_READWRITE, VirtualProtect};
+    // Every page of the piece in every view closed, or none: a page left
+    // open would show the title the bytes from before the card's.
+    let mut pages = Vec::new();
+    let mut shared = Vec::new();
+    let mut whole = true;
+    'all: for page in at / PAGE..end.div_ceil(PAGE) {
+        for view in views_of(page) {
+            if l.pages.get(&view).is_some_and(|v| !v.is_empty()) {
+                shared.push(view);
+                continue;
+            }
+            let mut old = 0;
+            // SAFETY: title memory; only its protection changes.
+            if unsafe { VirtualProtect((view * PAGE) as *const _, PAGE, PAGE_NOACCESS, &mut old) } == 0 {
+                whole = false;
+                break 'all;
+            }
+            pages.push((view, old));
+            if old != PAGE_READWRITE && old != PAGE_READONLY {
+                whole = false;
+                break 'all;
+            }
+        }
+    }
+    if !whole {
+        for &(view, old) in &pages {
+            restore(view, old);
+        }
+        STATS[4].fetch_add(0, Ordering::Relaxed);
+        NOT_CLOSED.fetch_add(1, Ordering::Relaxed);
+        return false;
+    }
+    for &(view, _) in &pages {
+        l.pages.entry(view).or_default().push(at);
+    }
+    for view in shared {
+        l.pages.entry(view).or_default().push(at);
+    }
+    blocks_add(at, hi - lo, 1);
+    l.pending.insert(at, Pending { shadow: shadow.clone(), lo, hi, pages });
+    PENDING.fetch_add(1, Ordering::Relaxed);
+    STATS[0].fetch_add(1, Ordering::Relaxed);
+    STATS[5].fetch_add((hi - lo) as u64, Ordering::Relaxed);
+    true
+}
+
+fn restore(page: usize, old: u32) {
+    use windows_sys::Win32::System::Memory::VirtualProtect;
+    let mut was = 0;
+    // SAFETY: a page this module protected.
+    unsafe { VirtualProtect((page * PAGE) as *const _, PAGE, old, &mut was) };
+}
+
+/// Takes the pending pieces overlapping `[at, at + len)` out, their pages
+/// opened (a page another pending piece still holds stays closed).
+fn take(l: &mut Lazy, at: usize, len: usize) -> Vec<Pending> {
+    let end = at + len.max(1);
+    let keys: Vec<usize> = l
+        .pending
+        .range(at.saturating_sub(LONGEST)..end)
+        .filter(|(k, p)| **k + (p.hi - p.lo) > at)
+        .map(|(k, _)| *k)
+        .collect();
+    let mut out = Vec::new();
+    for key in keys {
+        let Some(p) = l.pending.remove(&key) else { continue };
+        blocks_add(key, p.hi - p.lo, -1);
+        PENDING.fetch_sub(1, Ordering::Relaxed);
+        for &(page, old) in &p.pages {
+            let holders = l.pages.entry(page).or_default();
+            holders.retain(|&k| k != key);
+            if holders.is_empty() {
+                l.pages.remove(&page);
+                restore(page, old);
+            }
+        }
+        // Pages this piece shared with others it did not protect itself.
+        for holders in l.pages.values_mut() {
+            holders.retain(|&k| k != key);
+        }
+        out.push(p);
+    }
+    out
+}
+
+/// Brings pending pieces down and merges them (on this thread).
+fn fetch(pieces: Vec<Pending>, title_touch: bool) {
+    if pieces.is_empty() {
+        return;
+    }
+    STATS[if title_touch { 1 } else { 2 }].fetch_add(pieces.len() as u64, Ordering::Relaxed);
+    let Some(host) = crate::host::host() else { return };
+    FETCHING.with(|f| f.set(true));
+    let list: Vec<(Arc<Shadow>, usize, usize)> = pieces.into_iter().map(|p| (p.shadow, p.lo, p.hi)).collect();
+    host.lazy_fetch(&list);
+    FETCHING.with(|f| f.set(false));
+}
+
+/// Before this runtime reads or writes title memory `[at, at + len)`: what
+/// is pending there comes down first.
+pub(crate) fn ensure(at: usize, len: usize) {
+    if PENDING.load(Ordering::Relaxed) == 0 || !on() || FETCHING.with(Cell::get) || !maybe_pending(at, len) {
+        return;
+    }
+    let pieces = {
+        let mut g = lazy();
+        let Some(l) = g.as_mut() else { return };
+        if l.pending.is_empty() {
+            return;
+        }
+        take(l, at, len)
+    };
+    fetch(pieces, false);
+}
+
+/// `crate::watch` gave `[at, at + len)` the protection `protection` (its
+/// guards): pages pending here are closed again, and given that protection
+/// back when opened.
+pub(crate) fn protected(at: usize, len: usize, protection: u32) {
+    if PENDING.load(Ordering::Relaxed) == 0 || !on() || !maybe_pending(at, len) {
+        return;
+    }
+    use windows_sys::Win32::System::Memory::{PAGE_NOACCESS, VirtualProtect};
+    let mut g = lazy();
+    let Some(l) = g.as_mut() else { return };
+    for page in at / PAGE..(at + len.max(1)).div_ceil(PAGE) {
+        let Some(holders) = l.pages.get(&page) else { continue };
+        for key in holders.clone() {
+            if let Some(p) = l.pending.get_mut(&key)
+                && let Some(entry) = p.pages.iter_mut().find(|e| e.0 == page)
+            {
+                entry.1 = protection;
+            }
+        }
+        let mut old = 0;
+        // SAFETY: a page this module holds closed.
+        unsafe { VirtualProtect((page * PAGE) as *const _, PAGE, PAGE_NOACCESS, &mut old) };
+        RECLOSED.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// Pages closed again after the guards changed them.
+static RECLOSED: AtomicU64 = AtomicU64::new(0);
+
+/// The title's memory `[at, at + len)` shows other pages now: what was
+/// pending there is dropped unfetched.
+pub(crate) fn remapped(at: usize, len: usize) {
+    if !on() {
+        return;
+    }
+    let mut g = lazy();
+    let Some(l) = g.as_mut() else { return };
+    let gone = take(l, at, len);
+    STATS[4].fetch_add(gone.len() as u64, Ordering::Relaxed);
+}
+
+/// Before the relay merges `[at, at + len)` of title memory: a pending piece
+/// there is dropped (the merge brings newer bytes of the card) if it is the
+/// same piece, else fetched first.
+pub(crate) fn before_merge(shadow: *const Shadow, at: usize, len: usize) {
+    if PENDING.load(Ordering::Relaxed) == 0 || !on() || !maybe_pending(at, len) {
+        return;
+    }
+    let pieces = {
+        let mut g = lazy();
+        let Some(l) = g.as_mut() else { return };
+        take(l, at, len)
+    };
+    let others: Vec<Pending> = pieces.into_iter().filter(|p| !std::ptr::eq(Arc::as_ptr(&p.shadow), shadow)).collect();
+    fetch(others, false);
+}
+
+fn install() {
+    use windows_sys::Win32::Foundation::{EXCEPTION_ACCESS_VIOLATION, NTSTATUS};
+    use windows_sys::Win32::System::Diagnostics::Debug::{
+        AddVectoredExceptionHandler, EXCEPTION_CONTINUE_EXECUTION, EXCEPTION_CONTINUE_SEARCH, EXCEPTION_POINTERS,
+    };
+    unsafe extern "system" fn on_touch(info: *mut EXCEPTION_POINTERS) -> i32 {
+        // SAFETY: the system passes the exception being dispatched.
+        let r = unsafe { &*(*info).ExceptionRecord };
+        if r.ExceptionCode != EXCEPTION_ACCESS_VIOLATION as NTSTATUS || r.NumberParameters < 2 {
+            return EXCEPTION_CONTINUE_SEARCH;
+        }
+        let at = r.ExceptionInformation[1];
+        let pieces = {
+            let mut g = lazy();
+            let Some(l) = g.as_mut() else {
+                return EXCEPTION_CONTINUE_SEARCH;
+            };
+            let Some(keys) = l.pages.get(&(at / PAGE)).cloned() else {
+                return EXCEPTION_CONTINUE_SEARCH;
+            };
+            let mut out = Vec::new();
+            for key in keys {
+                out.extend(take(l, key, 1));
+            }
+            out
+        };
+        fetch(pieces, true);
+        EXCEPTION_CONTINUE_EXECUTION
+    }
+    static ONCE: std::sync::Once = std::sync::Once::new();
+    // SAFETY: the handler touches this module's state, protections and the
+    // host's own fetch.
+    ONCE.call_once(|| unsafe {
+        AddVectoredExceptionHandler(1, Some(on_touch));
+    });
+}
+
+/// The line for the frame-rate log (since the start).
+pub(crate) fn line() -> Option<String> {
+    if !on() {
+        return None;
+    }
+    let s: Vec<u64> = STATS.iter().map(|s| s.load(Ordering::Relaxed)).collect();
+    let pending = lazy().as_ref().map_or(0, |l| l.pending.len());
+    Some(format!(
+        "copy-back on first touch (VICTORY_LAZY_BACK=1), since the start: {} pieces deferred ({} MB); fetched for the title {}, for this runtime {}; flagged again while pending {}; dropped by remaps {}; pending now {}; not closable {}; pages closed again after the guards {}",
+        s[0],
+        s[5] >> 20,
+        s[1],
+        s[2],
+        s[3],
+        s[4],
+        pending,
