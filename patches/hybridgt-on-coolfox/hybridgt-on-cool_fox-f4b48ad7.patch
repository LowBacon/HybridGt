+/// HybridGt: samplers shaders build as constants (`HostShader::heap_samplers`),
+/// by slot, and the sampler heaps (CPU start, slot size) that hold the kept
+/// slots: every such heap gets every such sampler.
+#[cfg(windows)]
+static CONST_SAMPLERS: Mutex<(Vec<(u32, [u32; 4])>, Vec<(usize, u32)>)> = Mutex::new((Vec::new(), Vec::new()));
+
+#[cfg(windows)]
+fn write_const_sampler(cpu: usize, step: u32, slot: u32, w: [u32; 4]) {
+    let Some(host) = host() else { return };
+    let s = victory_shader::emit::StaticSampler::from_words(w);
+    let border = match s.border {
+        1 => [0.0, 0.0, 0.0, 1.0],
+        2 => [1.0, 1.0, 1.0, 1.0],
+        _ => [0.0; 4],
+    };
+    let desc = D3D12_SAMPLER_DESC {
+        Filter: D3D12_FILTER(s.filter as i32),
+        AddressU: D3D12_TEXTURE_ADDRESS_MODE(s.address[0] as i32),
+        AddressV: D3D12_TEXTURE_ADDRESS_MODE(s.address[1] as i32),
+        AddressW: D3D12_TEXTURE_ADDRESS_MODE(s.address[2] as i32),
+        MipLODBias: s.mip_lod_bias,
+        MaxAnisotropy: s.max_anisotropy.max(1),
+        ComparisonFunc: D3D12_COMPARISON_FUNC(s.comparison.max(1) as i32),
+        BorderColor: border,
+        MinLOD: s.min_lod,
+        MaxLOD: s.max_lod,
+    };
+    let at = D3D12_CPU_DESCRIPTOR_HANDLE { ptr: cpu + slot as usize * step as usize };
+    // SAFETY: a slot inside one of our 2,048-slot sampler heaps.
+    unsafe { host.device.CreateSampler(&desc, at) };
+}
+
+/// A sampler heap with the kept slots was made: it gets the samplers known so far.
+#[cfg(windows)]
+fn const_samplers_heap(cpu: usize, step: u32) {
+    let mut c = CONST_SAMPLERS.lock().unwrap_or_else(|e| e.into_inner());
+    for &(slot, w) in &c.0 {
+        write_const_sampler(cpu, step, slot, w);
+    }
+    c.1.push((cpu, step));
+}
+
+/// A translated shader's constant samplers (`HostShader::heap_samplers`):
+/// new ones are written into every sampler heap's kept slots. Two different
+/// samplers for one slot are logged (the later is not written).
+#[cfg(windows)]
+pub(crate) fn heap_samplers(list: &[(u32, [u32; 4])]) {
+    if list.is_empty() {
+        return;
+    }
+    let mut c = CONST_SAMPLERS.lock().unwrap_or_else(|e| e.into_inner());
+    for &(slot, w) in list {
+        match c.0.iter().find(|e| e.0 == slot) {
+            Some(e) if e.1 == w => {}
+            Some(e) => tracing::warn!(slot, have = ?e.1, wanted = ?w, "two constant samplers for one kept sampler slot: the first stays"),
+            None => {
+                for &(cpu, step) in &c.1 {
+                    write_const_sampler(cpu, step, slot, w);
+                }
+                c.0.push((slot, w));
+            }
+        }
+    }
+}
