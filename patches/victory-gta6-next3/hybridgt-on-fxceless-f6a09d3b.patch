+            inp[1], inp[0],
+        );
+    });
+    run_cases(&b64_scc, &inputs, |backend, _, inp, got| {
+        let want = u32::from(inp[0] | inp[1] != 0);
+        assert_eq!(
+            got, want,
+            "{backend}: SCC of s_quadmask_b64({:#010x}_{:#010x})",
+            inp[1], inp[0],
+        );
+    });
