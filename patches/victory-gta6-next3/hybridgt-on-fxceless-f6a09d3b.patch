+//! HybridGt: the textures on screen first (`VICTORY_TEXTURE_MARKS=1`; off by
+//! default).
+//!
+//! The title picks most textures from its view heap by an index its shaders
+//! compute, so nothing on the host side says which of the heap's textures a
+//! frame samples: the texture pass uploads the queue newest write first, and
+//! with the card at its line some 10,000 textures wait while the screen shows
+//! surfaces without theirs. With the switch, translated pixel and compute
+//! shaders store 1 at the slot of every texture they pick
+//! (`victory_shader::emit::SLOT_SEEN`) into a map in the card's memory. Every
+//! half second a thread of ours copies the map to a readback buffer and
+//! clears it, on a copy queue of its own (the first try read the map
+//! through the bus instead: 725 ms a read, and the bus it held up slowed the
+//! title's copies threefold); the texture queue then serves the slots found
+//! before the others ([`marked`]).
+//!
+//! shortcut: a slot marked stays first for two reads of the map (about a
+//! second); one whose texture waits longer is served by age as before.
+
+use std::collections::HashSet;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::{OnceLock, RwLock};
+
+use victory_shader::emit::SEEN_SLOTS;
+use windows::Win32::Graphics::Direct3D12::*;
+use windows::core::Interface;
+
+/// The map in the card's memory (shaders write it), a zeroed buffer that
+/// clears it, a readback buffer the copy queue fills, and that queue.
+struct Map {
+    map: ID3D12Resource,
+    zeros: ID3D12Resource,
+    readback: ID3D12Resource,
+    data: *const u32,
+    gpu: u64,
+    queue: ID3D12CommandQueue,
+    allocator: ID3D12CommandAllocator,
+    list: ID3D12GraphicsCommandList,
+    fence: ID3D12Fence,
+    sent: AtomicU64,
+}
+
+// SAFETY: the objects are free-threaded; the mapping is of a buffer the
+// struct owns for the process's life, read by the one reader thread.
+unsafe impl Send for Map {}
+unsafe impl Sync for Map {}
+
+static MAP: OnceLock<Option<Map>> = OnceLock::new();
+
+/// Slots marked in the last two reads of the map.
+static MARKED: std::sync::LazyLock<RwLock<(HashSet<u32>, HashSet<u32>)>> =
+    std::sync::LazyLock::new(|| RwLock::new((HashSet::new(), HashSet::new())));
+
+/// Reads of the map, slots found marked over all of them, the last read's
+/// count, and its time in microseconds.
+static COUNTS: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+
+/// How many queued slots were served first for being on screen
+/// ([`crate::descriptor::host`]).
+pub(crate) static SERVED_FIRST: AtomicU64 = AtomicU64::new(0);
+
+/// Whether the switch is on (the translator reads the same switch).
+pub(crate) fn on() -> bool {
+    victory_shader::emit::texture_marks()
+}
+
+fn buffer(
+    device: &ID3D12Device,
+    kind: D3D12_HEAP_TYPE,
+    bytes: u64,
+    uav: bool,
+    state: D3D12_RESOURCE_STATES,
+) -> windows::core::Result<ID3D12Resource> {
+    let heap = D3D12_HEAP_PROPERTIES { Type: kind, ..Default::default() };
+    let desc = D3D12_RESOURCE_DESC {
+        Dimension: D3D12_RESOURCE_DIMENSION_BUFFER,
+        Width: bytes,
+        Height: 1,
+        DepthOrArraySize: 1,
+        MipLevels: 1,
+        SampleDesc: windows::Win32::Graphics::Dxgi::Common::DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+        Layout: D3D12_TEXTURE_LAYOUT_ROW_MAJOR,
+        Flags: if uav { D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS } else { D3D12_RESOURCE_FLAG_NONE },
+        ..Default::default()
+    };
+    let mut made: Option<ID3D12Resource> = None;
+    // SAFETY: plain creation; committed resources start zeroed.
+    unsafe { device.CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, state, None, &mut made)? };
+    made.ok_or_else(windows::core::Error::empty)
+}
+
+fn make() -> windows::core::Result<Map> {
+    let host = crate::host::host().ok_or_else(windows::core::Error::empty)?;
+    let device = &host.device;
+    let bytes = u64::from(SEEN_SLOTS) * 4;
+    let map = buffer(device, D3D12_HEAP_TYPE_DEFAULT, bytes, true, D3D12_RESOURCE_STATE_COMMON)?;
+    let zeros = buffer(device, D3D12_HEAP_TYPE_DEFAULT, bytes, false, D3D12_RESOURCE_STATE_COMMON)?;
+    let readback = buffer(device, D3D12_HEAP_TYPE_READBACK, bytes, false, D3D12_RESOURCE_STATE_COPY_DEST)?;
+    crate::host::name(&map, || "textures on screen: the map of marked slots".to_owned());
+    let mut data = std::ptr::null_mut();
+    // SAFETY: plain object creation and the mapping of a readback buffer.
+    unsafe {
+        readback.Map(0, None, Some(&mut data))?;
+        let queue: ID3D12CommandQueue =
+            device.CreateCommandQueue(&D3D12_COMMAND_QUEUE_DESC { Type: D3D12_COMMAND_LIST_TYPE_COPY, ..Default::default() })?;
+        let allocator: ID3D12CommandAllocator = device.CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_COPY)?;
+        let list: ID3D12GraphicsCommandList = device.CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_COPY, &allocator, None)?;
+        list.Close()?;
+        let fence: ID3D12Fence = device.CreateFence(0, D3D12_FENCE_FLAG_NONE)?;
+        let gpu = map.GetGPUVirtualAddress();
+        Ok(Map { map, zeros, readback, data: data.cast(), gpu, queue, allocator, list, fence, sent: AtomicU64::new(0) })
+    }
+}
+
+fn map() -> Option<&'static Map> {
+    MAP.get_or_init(|| match make() {
+        Ok(map) => {
+            tracing::info!("textures on screen first (VICTORY_TEXTURE_MARKS=1): shaders mark the texture slots they pick");
+            start_reader();
+            Some(map)
+        }
+        Err(e) => {
+            tracing::warn!(error = %e, "textures on screen: no map; textures keep their order");
+            None
+        }
+    })
+    .as_ref()
+}
+
+/// The GPU address a shader's `SLOT_SEEN` root view is bound to.
+pub(crate) fn gpu() -> Option<u64> {
+    if !on() {
+        return None;
+    }
+    map().map(|m| m.gpu)
+}
+
+/// Whether title slot `index` was marked lately (a texture on screen).
+pub(crate) fn marked(index: u32) -> bool {
+    let m = MARKED.read().unwrap_or_else(|e| e.into_inner());
+    m.0.contains(&index) || m.1.contains(&index)
+}
+
+/// Whether any slot is marked: the queue's order changes only then.
+pub(crate) fn any() -> bool {
+    let m = MARKED.read().unwrap_or_else(|e| e.into_inner());
+    !(m.0.is_empty() && m.1.is_empty())
+}
+
+/// One read of the map on the card: copied to the readback buffer and
+/// cleared, by our copy queue; then the slots set, from the copy.
+/// shortcut: a mark a shader writes between the two copies is lost; the
+/// next frame that samples the slot writes it again.
+fn read_once(map: &Map) -> windows::core::Result<HashSet<u32>> {
+    let bytes = u64::from(SEEN_SLOTS) * 4;
+    // SAFETY: our own list, allocator and queue, used by this thread alone;
+    // the previous submission was waited for.
+    unsafe {
+        map.allocator.Reset()?;
+        map.list.Reset(&map.allocator, None)?;
+        map.list.CopyBufferRegion(&map.readback, 0, &map.map, 0, bytes);
+        map.list.CopyBufferRegion(&map.map, 0, &map.zeros, 0, bytes);
+        map.list.Close()?;
+        let list: ID3D12CommandList = map.list.cast()?;
+        map.queue.ExecuteCommandLists(&[Some(list)]);
+        let value = map.sent.fetch_add(1, Relaxed) + 1;
+        map.queue.Signal(&map.fence, value)?;
+        let started = std::time::Instant::now();
+        while map.fence.GetCompletedValue() < value {
+            if started.elapsed() > std::time::Duration::from_secs(5) {
+                return Err(windows::core::Error::empty());
+            }
+            std::thread::sleep(std::time::Duration::from_millis(1));
+        }
+    }
+    let mut found = HashSet::new();
+    let words = map.data.cast::<u64>();
+    for k in 0..(SEEN_SLOTS as usize / 2) {
+        // SAFETY: inside the readback mapping, which the copy above filled.
+        let w = unsafe { words.add(k).read() };
+        if w == 0 {
+            continue;
+        }
+        for half in 0..2u32 {
+            if (w >> (32 * half)) as u32 != 0 {
+                found.insert(k as u32 * 2 + half);
+            }
+        }
+    }
+    Ok(found)
+}
+
+fn start_reader() {
+    let spawned = std::thread::Builder::new().name("textures on screen".into()).spawn(|| {
+        loop {
+            std::thread::sleep(std::time::Duration::from_millis(500));
+            let Some(map) = MAP.get().and_then(Option::as_ref) else {
+                continue;
+            };
+            let started = std::time::Instant::now();
+            let Ok(found) = read_once(map) else {
+                tracing::warn!("textures on screen: the map could not be read; textures keep their order");
+                *MARKED.write().unwrap_or_else(|e| e.into_inner()) = (HashSet::new(), HashSet::new());
+                return;
+            };
+            let n = found.len() as u64;
+            {
+                let mut m = MARKED.write().unwrap_or_else(|e| e.into_inner());
+                m.1 = std::mem::replace(&mut m.0, found);
+            }
+            COUNTS[0].fetch_add(1, Relaxed);
+            COUNTS[1].fetch_add(n, Relaxed);
+            COUNTS[2].store(n, Relaxed);
+            COUNTS[3].store(started.elapsed().as_micros() as u64, Relaxed);
+        }
+    });
+    if spawned.is_err() {
+        tracing::warn!("textures on screen: no thread to read the map; the queue keeps its order");
+    }
+}
+
+/// For the log: reads of the map, slots marked in the last read, and how
+/// long that read took (ms).
+pub(crate) fn line() -> Option<(u64, u64, f64)> {
+    if !on() || MAP.get().is_none_or(Option::is_none) {
+        return None;
+    }
+    Some((COUNTS[0].load(Relaxed), COUNTS[2].load(Relaxed), COUNTS[3].load(Relaxed) as f64 / 1e3))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// One read of the map on this machine's card: the copy queue copies it
+    /// back and clears it, and an empty map reads as no slot
+    /// (`cargo test --release -p victory-gpu seen::tests -- --ignored --nocapture`).
+    #[test]
+    #[ignore]
+    fn a_read_of_the_map_copies_and_clears_it() {
+        let map = make().expect("the map and its queue on the host device");
+        for n in 0..3 {
+            let started = std::time::Instant::now();
+            let found = read_once(&map).expect("the read");
+            println!("read {n}: {} slots, {:.2} ms", found.len(), started.elapsed().as_secs_f64() * 1e3);
+            assert!(found.is_empty());
+        }
+    }
+
+    /// Marks put into the map on the card (as shaders would) are found at
+    /// their slots by one read and gone by the next.
+    #[test]
+    #[ignore]
+    fn marks_on_the_card_are_found_and_cleared() {
+        let map = make().expect("the map and its queue on the host device");
+        let host = crate::host::host().expect("a host");
+        let slots = [0u32, 7, 4096, 65_537, SEEN_SLOTS - 1];
+        let bytes = u64::from(SEEN_SLOTS) * 4;
+        let (upload, data) = host.upload_buffer(bytes).expect("an upload buffer");
+        // SAFETY: the upload buffer's own mapping, `bytes` long.
+        unsafe {
+            std::ptr::write_bytes(data, 0, bytes as usize);
+            for &s in &slots {
+                data.cast::<u32>().add(s as usize).write(1);
+            }
+            map.allocator.Reset().unwrap();
+            map.list.Reset(&map.allocator, None).unwrap();
+            map.list.CopyBufferRegion(&map.map, 0, &upload, 0, bytes);
+            map.list.Close().unwrap();
+            let list: ID3D12CommandList = map.list.cast().unwrap();
+            map.queue.ExecuteCommandLists(&[Some(list)]);
+            let value = map.sent.fetch_add(1, Relaxed) + 1;
+            map.queue.Signal(&map.fence, value).unwrap();
+            while map.fence.GetCompletedValue() < value {
+                std::thread::sleep(std::time::Duration::from_millis(1));
+            }
+        }
+        let found = read_once(&map).expect("the read");
+        let mut found: Vec<u32> = found.into_iter().collect();
+        found.sort_unstable();
+        assert_eq!(found, slots);
+        assert!(read_once(&map).expect("the second read").is_empty(), "the first read cleared the map");
+    }
+}
