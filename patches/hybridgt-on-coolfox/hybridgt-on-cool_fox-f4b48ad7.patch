diff --git a/apps/victory/src/native_index.rs b/apps/victory/src/native_index.rs
new file mode 100644
index 00000000..04246848
--- /dev/null
+++ b/apps/victory/src/native_index.rs
@@ -0,0 +1,165 @@
+//! HybridGt: from a native program's code header to its shader container.
+//!
+//! Device methods 0x1c8 and 0x218 hand the runtime standalone GFX10 code in
+//! GPU memory, not a container; the code starts with the two hash-carrying
+//! `v_nop`s that the same program's code in its container starts with (run
+//! next32: 16 headers seen, each matching exactly one container in
+//! `shaders.rpf`). `victory shader-index <archive> <out>` writes, for every
+//! native program in the archive, its first 12 bytes and where its
+//! container is; `VICTORY_NATIVE_INDEX=<out>` makes `run` read it and give
+//! the GPU side a lookup (`victory_gpu::set_container_lookup`) that reads
+//! one record of the archive when asked.
+
+use std::collections::HashMap;
+use std::io::{Read, Seek, SeekFrom};
+use std::path::{Path, PathBuf};
+
+use anyhow::Result;
+use victory_shader::{Container, FourCC, native_programs};
+
+use crate::shader::{Source, sources};
+
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+fn unhex(s: &str) -> Option<[u8; 12]> {
+    let mut out = [0u8; 12];
+    if s.len() != 24 {
+        return None;
+    }
+    for (i, o) in out.iter_mut().enumerate() {
+        *o = u8::from_str_radix(&s[2 * i..2 * i + 2], 16).ok()?;
+    }
+    Some(out)
+}
+
+/// Writes the index of `archive`'s native programs to `out`.
+pub fn build(archive: &Path, out: &Path) -> Result<()> {
+    let data = std::fs::read(archive)?;
+    let mut lines = vec![format!("archive {}", archive.display())];
+    let mut programs_seen = 0usize;
+    for source in sources(&data) {
+        let Some(bytes) = source.bytes() else { continue };
+        let Ok(container) = Container::parse(&bytes) else { continue };
+        let Some(dxil) = container.part(FourCC::DXIL) else { continue };
+        let Ok(programs) = native_programs(dxil.data) else { continue };
+        let (offset, kind, len) = match &source {
+            Source::Raw { offset, .. } => {
+                let total = bytes.get(24..28).map_or(0, |b| u32::from_le_bytes(b.try_into().unwrap_or([0; 4])) as usize);
+                (*offset, 'r', total)
+            }
+            Source::Packed(r) => (r.offset, 'p', 0),
+        };
+        for p in &programs {
+            if p.code.len() >= 12 {
+                lines.push(format!("{} {:?} {offset:x} {kind} {len:x}", hex(&p.code[..12]), p.stage));
+                programs_seen += 1;
+            }
+        }
+    }
+    std::fs::write(out, lines.join("\n"))?;
+    println!("{programs_seen} native programs indexed into {}", out.display());
+    Ok(())
+}
+
+/// HybridGt: every saved 0x1c8 description in `dump` through the runtime's
+/// pipeline path (`victory_gpu::pipeline::check_console_graphics`), with
+/// the index at `index`; prints how many made a host pipeline and why the
+/// others did not.
+pub fn check_console(dump: &Path, index: &Path) -> Result<()> {
+    register(index);
+    let mut results: HashMap<&'static str, usize> = HashMap::new();
+    let mut made = 0usize;
+    let mut descs: Vec<PathBuf> = std::fs::read_dir(dump)?
+        .filter_map(|e| e.ok().map(|e| e.path()))
+        .filter(|p| p.file_name().and_then(|n| n.to_str()).is_some_and(|n| n.starts_with("1c8-") && n.ends_with("-desc.bin")))
+        .collect();
+    descs.sort();
+    for d in &descs {
+        let name = d.file_name().and_then(|n| n.to_str()).unwrap_or_default().to_owned();
+        let call = name.split('-').nth(1).unwrap_or_default().to_owned();
+        let block = |k: u32| -> Option<Vec<u8>> {
+            let prefix = format!("1c8-{call}-w{k:02}-");
+            let file = std::fs::read_dir(dump).ok()?.filter_map(|e| e.ok()).find(|e| e.file_name().to_str().is_some_and(|n| n.starts_with(&prefix)))?;
+            std::fs::read(file.path()).ok()
+        };
+        let header = |b: Option<Vec<u8>>| -> Option<[u8; 12]> { b?.get(..12)?.try_into().ok() };
+        // Word 5 is the pixel code, word 9 the vertex code.
+        let first = match (header(block(9)), header(block(13))) {
+            (Some(h), _) => Some(("vertex", h)),
+            (None, Some(h)) => Some(("mesh", h)),
+            _ => None,
+        };
+        let (Some(regs), Some((stage, vs))) = (block(1), first) else {
+            *results.entry("description incomplete").or_default() += 1;
+            continue;
+        };
+        // No word-5 block: a pipeline without a pixel stage.
+        let ps = header(block(5));
+        let layout = block(3).unwrap_or_default();
+        match victory_gpu::pipeline::check_console_graphics(stage, &vs, ps.as_ref(), &regs, &layout) {
+            Ok(()) => made += 1,
+            Err(why) => *results.entry(why).or_default() += 1,
+        }
+    }
+    println!("{} descriptions: {made} host pipelines made", descs.len());
+    for (why, n) in results {
+        println!("  {n:5}  {why}");
+    }
+    Ok(())
+}
+
+/// Reads the index at `path` and gives the GPU side its lookup.
+pub fn register(path: &Path) {
+    let Ok(text) = std::fs::read_to_string(path) else {
+        eprintln!("VIctory: no native program index at {}", path.display());
+        return;
+    };
+    let mut lines = text.lines();
+    let Some(archive) = lines.next().and_then(|l| l.strip_prefix("archive ")) else {
+        return;
+    };
+    let archive = PathBuf::from(archive);
+    let mut map: HashMap<[u8; 12], (u64, bool, u64)> = HashMap::new();
+    for line in lines {
+        let f: Vec<&str> = line.split(' ').collect();
+        if f.len() < 5 {
+            continue;
+        }
+        let (Some(header), Ok(offset), Ok(len)) = (unhex(f[0]), u64::from_str_radix(f[2], 16), u64::from_str_radix(f[4], 16)) else {
+            continue;
+        };
+        map.entry(header).or_insert((offset, f[3] == "p", len));
+    }
+    let entries = map.len();
+    victory_gpu::set_container_lookup(Box::new(move |header: &[u8; 12]| -> Option<Vec<u8>> {
+        let &(offset, packed, len) = map.get(header)?;
+        let mut file = std::fs::File::open(&archive).ok()?;
+        if packed {
+            // The record's size sits 4 bytes before its marker; the window
+            // starts 8 before it (its kind and name end there).
+            let start = offset.checked_sub(8)?;
+            file.seek(SeekFrom::Start(start)).ok()?;
+            let mut head = [0u8; 8];
+            file.read_exact(&mut head).ok()?;
+            let n = u64::from(u32::from_le_bytes(head[4..8].try_into().ok()?));
+            if !(12..=64 << 20).contains(&n) {
+                return None;
+            }
+            let mut window = vec![0u8; (8 + n) as usize];
+            file.seek(SeekFrom::Start(start)).ok()?;
+            file.read_exact(&mut window).ok()?;
+            victory_game::sgd5::unpack_at(&window, 8)
+        } else {
+            if !(28..=64 << 20).contains(&len) {
+                return None;
+            }
+            let mut bytes = vec![0u8; len as usize];
+            file.seek(SeekFrom::Start(offset)).ok()?;
+            file.read_exact(&mut bytes).ok()?;
+            Some(bytes)
+        }
+    }));
+    eprintln!("VIctory: native program index: {entries} code headers ({})", path.display());
+}
