+/// HybridGt: `v_permlane16_b32` / `v_permlanex16_b32` over 32 threads, each
+/// storing its result at dword 32 + thread, against the ISA's definition.
+#[test]
+fn v_permlane16_and_x16_match_rdna2() {
+    // (s1, s2): lane n of a row takes nibble n of s2:s1.
+    let (s1, s2) = (0x7654_3210u32 ^ 0x1357_9bdf, 0xfedc_ba98u32 ^ 0x2468_ace0);
+    for (op, x16) in [(0x377u16, false), (0x378u16, true)] {
+        let [p0, p1] = vop3(op, 7, vgpr(0), sgpr(1), sgpr(2));
+        let body = [
+            vop2(0x1a, 6, 0x82, 0), // v_lshlrev_b32 v6, 2, v0 (byte offset)
+            p0,
+            p1, // v_permlane(x)16_b32 v7, v0, s1, s2
+            // buffer_store_dword v7, v6, s[8:11], offen offset:128
+            0x38 << 26 | 0x1C << 18 | 1 << 12 | 128,
+            0x80 << 24 | (8 >> 2) << 16 | 7 << 8 | 6,
+        ];
+        let shader = build_cs(&body, 32, 0);
+        let _one = ONE_AT_A_TIME.lock().unwrap_or_else(|e| e.into_inner());
+        let mut ran = 0;
+        // WARP's waves are 4 lanes: it refuses `WaveSize(32)`.
+        for (label, warp) in [("hardware", false)] {
+            let Ok(host) = Host::new(warp) else { continue };
+            let (root, pso) = host.compute_pipeline(&shader).expect("pipeline");
+            let inputs = [0, s1, s2, 0];
+            let mut ud = vec![0u32; shader.user_data_dwords().max(1) as usize];
+            for u in &shader.user_data {
+                ud[u.index as usize] = match (u.root, u.slot) {
+                    (RootType::Constants, 0) => inputs[u.dword as usize],
+                    _ => 0,
+                };
+            }
+            let out = host
+                .dispatch(&root, &pso, &Dispatch {
+                    roots: vec![(0, Root::Constants(ud))],
+                    views: &[View::RawUav(64)],
+                    samplers: &[],
+                    groups: [1, 1, 1],
+                })
+                .expect("dispatch");
+            for l in 0..32u32 {
+                let n = l & 15;
+                let word = if n < 8 { s1 } else { s2 };
+                let nib = word >> (4 * (n & 7)) & 15;
+                let base = if x16 { (l & !31) | ((l & 16) ^ 16) } else { l & !15 };
+                let want = base + nib;
+                assert_eq!(out[0][32 + l as usize], want, "{label}: x16={x16} lane {l}");
+            }
+            ran += 1;
+        }
+        if ran == 0 {
+            eprintln!("no SM 6.6 hardware device; v_permlane case not run");
+        }
+    }
+}
