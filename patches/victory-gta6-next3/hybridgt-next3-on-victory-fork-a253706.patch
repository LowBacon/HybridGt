diff --git a/apps/victory/build.rs b/apps/victory/build.rs
new file mode 100644
index 0000000..a4f2ea6
--- /dev/null
+++ b/apps/victory/build.rs
@@ -0,0 +1,10 @@
+//! HybridGt: the executable's icon (`res/victory.ico`, an original design).
+fn main() {
+    println!("cargo:rerun-if-changed=res/victory.rc");
+    println!("cargo:rerun-if-changed=res/victory.ico");
+    if std::env::var("CARGO_CFG_TARGET_OS").as_deref() == Ok("windows") {
+        embed_resource::compile("res/victory.rc", embed_resource::NONE)
+            .manifest_optional()
+            .ok();
+    }
+}
