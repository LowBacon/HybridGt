+            "s_mul_hi_i32",
+            vec![sop2(0x36, 16, 0, 1), vop1(0x001, 0, sgpr(16))],
+            |a, b| ((i64::from(a as i32) * i64::from(b as i32)) >> 32) as u32,
+        ),
