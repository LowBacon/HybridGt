+/// HybridGt: a graphics pipeline from device method 0x1c8: the vertex and
+/// pixel shader containers of the code its description names, its
+/// register block and vertex layout; host pipelines are made at draws, for
+/// the formats bound there ([`host_pipeline_for`]).
+#[cfg(windows)]
+pub(crate) fn graphics_from_console(
+    first: &'static str,
+    code: &[u8],
+    ps: Option<&[u8]>,
+    regs: Vec<u8>,
+    layout: Vec<u8>,
+    iid: *const Iid,
+    out: *mut This,
