+//! HybridGt: AMD FidelityFX Super Resolution 1 (FSR 1, MIT, `third_party/fsr1`)
+//! on the host's present: the title's image, rendered at the display mode the
+//! console reports (`VICTORY_DISPLAY_MODE`), is upscaled to the window's size
+//! by FSR 1's edge-adaptive upscale (EASU) and then sharpened (RCAS), in place
+//! of the plain copy into the swap chain's buffer.
+//!
+//! `VICTORY_FSR=1` turns it on; `VICTORY_FSR_OUTPUT=WxH` is the window's size
+//! (1920x1080 by default); `VICTORY_FSR_SHARPNESS` is RCAS's sharpness in
+//! stops (0 is the sharpest, 0.2 by default). Off by default. FSR 1 is a
+//! spatial upscaler: it needs only the finished image, so it works with any
+//! title; it does not make the title's own frames cheaper, only lets the title
+//! render fewer pixels (a lower `VICTORY_DISPLAY_MODE`) and still fill the
+//! window.
+
+use std::sync::OnceLock;
+
+use windows::Win32::Graphics::Direct3D::Fxc::D3DCompile;
+use windows::Win32::Graphics::Direct3D::ID3DBlob;
+use windows::Win32::Graphics::Direct3D12::*;
+use windows::Win32::Graphics::Dxgi::Common::*;
+use windows::core::PCSTR;
+
+const FFX_A: &str = include_str!("../third_party/fsr1/ffx_a.h");
+const FFX_FSR1: &str = include_str!("../third_party/fsr1/ffx_fsr1.h");
+
+/// Our part of the shader around AMD's headers: sizes come as root
+/// constants (input w, h, output w, h, sharpness bits); FSR 1's own
+/// constant set-up runs on the GPU ("works on CPU or GPU").
+const HEAD: &str = r#"
+#define A_GPU 1
+#define A_HLSL 1
+"#;
+
+const BINDINGS: &str = r#"
+#define ROOT "RootConstants(num32BitConstants=5, b0), DescriptorTable(SRV(t0)), DescriptorTable(UAV(u0)), StaticSampler(s0, filter=FILTER_MIN_MAG_MIP_LINEAR, addressU=TEXTURE_ADDRESS_CLAMP, addressV=TEXTURE_ADDRESS_CLAMP, addressW=TEXTURE_ADDRESS_CLAMP)"
+cbuffer Sizes : register(b0) { uint inW; uint inH; uint outW; uint outH; uint sharpBits; };
+Texture2D<float4> Src : register(t0);
+RWTexture2D<float4> Dst : register(u0);
+SamplerState Samp : register(s0);
+"#;
+
+const EASU_CALLBACKS: &str = r#"
+#define FSR_EASU_F 1
+AF4 FsrEasuRF(AF2 p) { return Src.GatherRed(Samp, p, int2(0, 0)); }
+AF4 FsrEasuGF(AF2 p) { return Src.GatherGreen(Samp, p, int2(0, 0)); }
+AF4 FsrEasuBF(AF2 p) { return Src.GatherBlue(Samp, p, int2(0, 0)); }
+"#;
+
+const EASU_MAIN: &str = r#"
+void Pixel(AU2 p, AU4 c0, AU4 c1, AU4 c2, AU4 c3) {
+  if (p.x >= outW || p.y >= outH) return;
+  AF3 c;
+  FsrEasuF(c, p, c0, c1, c2, c3);
+  Dst[p] = AF4(c, 1);
+}
+[RootSignature(ROOT)]
+[numthreads(64, 1, 1)]
+void main(uint3 lt : SV_GroupThreadID, uint3 g : SV_GroupID) {
+  AU4 c0, c1, c2, c3;
+  FsrEasuCon(c0, c1, c2, c3, AF1(inW), AF1(inH), AF1(inW), AF1(inH), AF1(outW), AF1(outH));
+  AU2 p = ARmp8x8(lt.x) + AU2(g.x << 4u, g.y << 4u);
+  Pixel(p, c0, c1, c2, c3); p.x += 8u;
+  Pixel(p, c0, c1, c2, c3); p.y += 8u;
+  Pixel(p, c0, c1, c2, c3); p.x -= 8u;
+  Pixel(p, c0, c1, c2, c3);
+}
+"#;
+
+const RCAS_CALLBACKS: &str = r#"
+#define FSR_RCAS_F 1
+AF4 FsrRcasLoadF(ASU2 p) { return Src.Load(int3(p, 0)); }
+void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
+"#;
+
+const RCAS_MAIN: &str = r#"
+void Pixel(AU2 p, AU4 con) {
+  if (p.x >= outW || p.y >= outH) return;
+  AF3 c;
+  FsrRcasF(c.r, c.g, c.b, p, con);
+  Dst[p] = AF4(c, 1);
+}
+[RootSignature(ROOT)]
+[numthreads(64, 1, 1)]
+void main(uint3 lt : SV_GroupThreadID, uint3 g : SV_GroupID) {
+  AU4 con;
+  FsrRcasCon(con, asfloat(sharpBits));
+  AU2 p = ARmp8x8(lt.x) + AU2(g.x << 4u, g.y << 4u);
+  Pixel(p, con); p.x += 8u;
+  Pixel(p, con); p.y += 8u;
+  Pixel(p, con); p.x -= 8u;
+  Pixel(p, con);
+}
+"#;
+
+/// Whether FSR 1 upscales the title's image on present (`VICTORY_FSR=1`).
+pub(crate) fn on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_FSR").is_some_and(|v| v == "1"))
+}
+
+/// The window's size with FSR on (`VICTORY_FSR_OUTPUT=WxH`, 1920x1080).
+pub(crate) fn output_size() -> (u32, u32) {
+    static SIZE: OnceLock<(u32, u32)> = OnceLock::new();
+    *SIZE.get_or_init(|| {
+        std::env::var("VICTORY_FSR_OUTPUT")
+            .ok()
+            .and_then(|v| {
+                let (w, h) = v.trim().split_once(['x', 'X'])?;
+                Some((w.trim().parse::<u32>().ok()?, h.trim().parse::<u32>().ok()?))
+            })
+            .filter(|&(w, h)| (320..=7680).contains(&w) && (200..=4320).contains(&h))
+            .unwrap_or((1920, 1080))
+    })
+}
+
+fn sharpness() -> f32 {
+    static S: OnceLock<f32> = OnceLock::new();
+    *S.get_or_init(|| {
+        std::env::var("VICTORY_FSR_SHARPNESS")
+            .ok()
+            .and_then(|v| v.trim().parse::<f32>().ok())
+            .filter(|s| (0.0..=2.0).contains(s))
+            .unwrap_or(0.2)
+    })
+}
+
+/// Descriptor sets in the ring: one per present in the air (the swap chain
+/// holds two buffers; presents sent ahead are bounded by them).
+const RING: u32 = 16;
+
+/// FSR 1's pipelines and the textures between its passes.
+pub(crate) struct Fsr {
+    root: ID3D12RootSignature,
+    easu: ID3D12PipelineState,
+    rcas: ID3D12PipelineState,
+    heap: ID3D12DescriptorHeap,
+    step: u32,
+    next: u32,
+    /// (upscaled, sharpened), at the output size and format they were made for.
+    targets: Option<(ID3D12Resource, ID3D12Resource, u32, u32, DXGI_FORMAT)>,
+}
+
+fn compile(device: &ID3D12Device, name: &str, source: &str) -> windows::core::Result<(ID3D12RootSignature, ID3D12PipelineState)> {
+    let mut code: Option<ID3DBlob> = None;
+    let mut errors: Option<ID3DBlob> = None;
+    let cname = std::ffi::CString::new(name).unwrap_or_default();
+    // SAFETY: the source and names live through the call; the out pointers are ours.
+    let compiled = unsafe {
+        D3DCompile(
+            source.as_ptr().cast(),
+            source.len(),
+            PCSTR(cname.as_ptr().cast()),
+            None,
+            None,
+            windows::core::s!("main"),
+            windows::core::s!("cs_5_1"),
+            0,
+            0,
+            &mut code,
+            Some(&mut errors),
+        )
+    };
+    if let Err(e) = compiled {
+        if let Some(errors) = errors {
+            // SAFETY: the blob's own bytes.
+            let text = unsafe { std::slice::from_raw_parts(errors.GetBufferPointer().cast::<u8>(), errors.GetBufferSize()) };
+            tracing::warn!("FSR 1 {name} did not compile: {}", String::from_utf8_lossy(text));
+        }
+        return Err(e);
+    }
+    let code = code.ok_or_else(windows::core::Error::empty)?;
+    // SAFETY: the blob's own bytes; the root signature is inside.
+    unsafe {
+        let bytes = std::slice::from_raw_parts(code.GetBufferPointer().cast::<u8>(), code.GetBufferSize());
+        let root: ID3D12RootSignature = device.CreateRootSignature(0, bytes)?;
+        let pso: ID3D12PipelineState = device.CreateComputePipelineState(&D3D12_COMPUTE_PIPELINE_STATE_DESC {
+            pRootSignature: std::mem::transmute_copy(&root),
+            CS: D3D12_SHADER_BYTECODE {
+                pShaderBytecode: bytes.as_ptr().cast(),
+                BytecodeLength: bytes.len(),
+            },
+            ..Default::default()
+        })?;
+        Ok((root, pso))
+    }
+}
+
+fn transition(resource: &ID3D12Resource, before: D3D12_RESOURCE_STATES, after: D3D12_RESOURCE_STATES) -> D3D12_RESOURCE_BARRIER {
+    D3D12_RESOURCE_BARRIER {
+        Type: D3D12_RESOURCE_BARRIER_TYPE_TRANSITION,
+        Flags: D3D12_RESOURCE_BARRIER_FLAG_NONE,
+        Anonymous: D3D12_RESOURCE_BARRIER_0 {
+            Transition: std::mem::ManuallyDrop::new(D3D12_RESOURCE_TRANSITION_BARRIER {
+                // SAFETY: a borrowed pointer the barrier does not release.
+                pResource: unsafe { std::mem::transmute_copy(resource) },
+                Subresource: D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES,
+                StateBefore: before,
+                StateAfter: after,
+            }),
+        },
+    }
+}
+
+impl Fsr {
+    pub(crate) fn new(device: &ID3D12Device) -> Option<Fsr> {
+        let made = (|| -> windows::core::Result<Fsr> {
+            let easu_src = [HEAD, FFX_A, BINDINGS, EASU_CALLBACKS, FFX_FSR1, EASU_MAIN].concat();
+            let rcas_src = [HEAD, FFX_A, BINDINGS, RCAS_CALLBACKS, FFX_FSR1, RCAS_MAIN].concat();
+            let (root, easu) = compile(device, "EASU", &easu_src)?;
+            let (_, rcas) = compile(device, "RCAS", &rcas_src)?;
+            // SAFETY: plain object creation.
+            let (heap, step) = unsafe {
+                let heap: ID3D12DescriptorHeap = device.CreateDescriptorHeap(&D3D12_DESCRIPTOR_HEAP_DESC {
+                    Type: D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV,
+                    NumDescriptors: RING * 4,
+                    Flags: D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE,
+                    NodeMask: 0,
+                })?;
+                (heap, device.GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV))
+            };
+            Ok(Fsr {
+                root,
+                easu,
+                rcas,
+                heap,
+                step,
+                next: 0,
+                targets: None,
+            })
+        })();
+        match made {
+            Ok(f) => {
+                let (w, h) = output_size();
+                tracing::info!("FSR 1 (AMD FidelityFX, MIT) upscales the title's image to {w}x{h} on present (VICTORY_FSR=1)");
+                Some(f)
+            }
+            Err(e) => {
+                tracing::warn!(error = %e, "no FSR 1: the title's image is copied as it is");
+                None
+            }
+        }
+    }
+
+    fn targets(&mut self, device: &ID3D12Device, w: u32, h: u32, format: DXGI_FORMAT) -> windows::core::Result<(ID3D12Resource, ID3D12Resource)> {
+        if let Some((a, b, tw, th, tf)) = &self.targets
+            && (*tw, *th, *tf) == (w, h, format)
+        {
+            return Ok((a.clone(), b.clone()));
+        }
+        let make = |format: DXGI_FORMAT| -> windows::core::Result<ID3D12Resource> {
+            let mut out: Option<ID3D12Resource> = None;
+            // SAFETY: plain object creation; the out pointer is ours.
+            unsafe {
+                device.CreateCommittedResource(
+                    &D3D12_HEAP_PROPERTIES {
+                        Type: D3D12_HEAP_TYPE_DEFAULT,
+                        ..Default::default()
+                    },
+                    D3D12_HEAP_FLAG_NONE,
+                    &D3D12_RESOURCE_DESC {
+                        Dimension: D3D12_RESOURCE_DIMENSION_TEXTURE2D,
+                        Width: w as u64,
+                        Height: h,
+                        DepthOrArraySize: 1,
+                        MipLevels: 1,
+                        Format: format,
+                        SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+                        Flags: D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
+                        ..Default::default()
+                    },
+                    D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                    None,
+                    &mut out,
+                )?;
+            }
+            out.ok_or_else(windows::core::Error::empty)
+        };
+        // The upscaled image in half floats (RCAS reads it), the sharpened
+        // one in the swap chain's format (copied into its buffer).
+        let a = make(DXGI_FORMAT_R16G16B16A16_FLOAT)?;
+        let b = make(format)?;
+        self.targets = Some((a.clone(), b.clone(), w, h, format));
+        Ok((a, b))
+    }
+
+    /// Records into `list`: `source` (in `state`, `view` its typed format)
+    /// upscaled and sharpened into `back` (in PRESENT, `w`x`h`, `format`).
+    /// Every resource ends in the state it began in. `Err` records nothing
+    /// the caller must undo only if it fails before the first command.
+    ///
+    /// # Safety
+    /// An open list; live resources; the list runs before `self` is dropped.
+    pub(crate) unsafe fn record(
+        &mut self,
+        device: &ID3D12Device,
+        list: &ID3D12GraphicsCommandList,
+        source: &ID3D12Resource,
+        state: D3D12_RESOURCE_STATES,
+        view: DXGI_FORMAT,
+        back: &ID3D12Resource,
+        (w, h): (u32, u32),
+        format: DXGI_FORMAT,
+    ) -> windows::core::Result<()> {
+        let (up, sharp) = self.targets(device, w, h, format)?;
+        // SAFETY: as the caller promises.
+        unsafe {
+            let desc = source.GetDesc();
+            let (in_w, in_h) = (desc.Width as u32, desc.Height);
+            let slot = self.next % RING;
+            self.next = self.next.wrapping_add(1);
+            let cpu = self.heap.GetCPUDescriptorHandleForHeapStart();
+            let gpu = self.heap.GetGPUDescriptorHandleForHeapStart();
+            let at = |i: u32| {
+                (
+                    D3D12_CPU_DESCRIPTOR_HANDLE { ptr: cpu.ptr + ((slot * 4 + i) * self.step) as usize },
+                    D3D12_GPU_DESCRIPTOR_HANDLE { ptr: gpu.ptr + ((slot * 4 + i) * self.step) as u64 },
+                )
+            };
+            let srv = |resource: &ID3D12Resource, format: DXGI_FORMAT, i: u32| {
+                device.CreateShaderResourceView(
+                    resource,
+                    Some(&D3D12_SHADER_RESOURCE_VIEW_DESC {
+                        Format: format,
+                        ViewDimension: D3D12_SRV_DIMENSION_TEXTURE2D,
+                        Shader4ComponentMapping: D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING,
+                        Anonymous: D3D12_SHADER_RESOURCE_VIEW_DESC_0 {
+                            Texture2D: D3D12_TEX2D_SRV { MipLevels: 1, ..Default::default() },
+                        },
+                    }),
+                    at(i).0,
+                );
+            };
+            let uav = |resource: &ID3D12Resource, format: DXGI_FORMAT, i: u32| {
+                device.CreateUnorderedAccessView(
+                    resource,
+                    None,
+                    Some(&D3D12_UNORDERED_ACCESS_VIEW_DESC {
+                        Format: format,
+                        ViewDimension: D3D12_UAV_DIMENSION_TEXTURE2D,
+                        ..Default::default()
+                    }),
+                    at(i).0,
+                );
+            };
+            srv(source, view, 0);
+            uav(&up, DXGI_FORMAT_R16G16B16A16_FLOAT, 1);
+            srv(&up, DXGI_FORMAT_R16G16B16A16_FLOAT, 2);
+            uav(&sharp, format, 3);
+
+            let read = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+            let uav_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+            if state != read {
+                list.ResourceBarrier(&[transition(source, state, read)]);
+            }
+            list.SetDescriptorHeaps(&[Some(self.heap.clone())]);
+            list.SetComputeRootSignature(&self.root);
+            let groups = (w.div_ceil(16), h.div_ceil(16));
+            let constants = [in_w, in_h, w, h, sharpness().to_bits()];
+            // EASU: source -> up.
+            list.SetPipelineState(&self.easu);
+            list.SetComputeRoot32BitConstants(0, 5, constants.as_ptr().cast(), 0);
+            list.SetComputeRootDescriptorTable(1, at(0).1);
+            list.SetComputeRootDescriptorTable(2, at(1).1);
+            list.Dispatch(groups.0, groups.1, 1);
+            // RCAS: up -> sharp.
+            list.ResourceBarrier(&[transition(&up, uav_state, read)]);
+            list.SetPipelineState(&self.rcas);
+            list.SetComputeRoot32BitConstants(0, 5, constants.as_ptr().cast(), 0);
+            list.SetComputeRootDescriptorTable(1, at(2).1);
+            list.SetComputeRootDescriptorTable(2, at(3).1);
+            list.Dispatch(groups.0, groups.1, 1);
+            // sharp -> the swap chain's buffer.
+            list.ResourceBarrier(&[
+                transition(&up, read, uav_state),
+                transition(&sharp, uav_state, D3D12_RESOURCE_STATE_COPY_SOURCE),
+                transition(back, D3D12_RESOURCE_STATE_PRESENT, D3D12_RESOURCE_STATE_COPY_DEST),
+            ]);
+            list.CopyResource(back, &sharp);
+            let mut after = vec![
+                transition(&sharp, D3D12_RESOURCE_STATE_COPY_SOURCE, uav_state),
+                transition(back, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_PRESENT),
+            ];
+            if state != read {
+                after.push(transition(source, read, state));
+            }
+            list.ResourceBarrier(&after);
+        }
+        Ok(())
+    }
+}
+
+#[cfg(all(test, windows))]
+mod tests {
+    use super::*;
+    use windows::Win32::System::Threading::{CreateEventW, INFINITE, WaitForSingleObject};
+    use windows::core::Interface;
+
+    /// FSR 1's two passes compile, and a flat 64x36 image upscaled to
+    /// 128x72 stays that flat colour (EASU and RCAS keep a constant image
+    /// constant) in every pixel. On the first adapter.
+    #[test]
+    fn a_flat_image_upscales_to_the_same_flat_image() {
+        let Some(h) = crate::host::host() else {
+            return;
+        };
+        let device: ID3D12Device = h.device.cast().unwrap();
+        let mut fsr = Fsr::new(&device).expect("FSR 1's pipelines");
+        let texture = |w: u32, hgt: u32, flags: D3D12_RESOURCE_FLAGS, state: D3D12_RESOURCE_STATES| {
+            let mut out: Option<ID3D12Resource> = None;
+            // SAFETY: plain object creation.
+            unsafe {
+                device
+                    .CreateCommittedResource(
+                        &D3D12_HEAP_PROPERTIES { Type: D3D12_HEAP_TYPE_DEFAULT, ..Default::default() },
+                        D3D12_HEAP_FLAG_NONE,
+                        &D3D12_RESOURCE_DESC {
+                            Dimension: D3D12_RESOURCE_DIMENSION_TEXTURE2D,
+                            Width: w as u64,
+                            Height: hgt,
+                            DepthOrArraySize: 1,
+                            MipLevels: 1,
+                            Format: DXGI_FORMAT_R8G8B8A8_UNORM,
+                            SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+                            Flags: flags,
+                            ..Default::default()
+                        },
+                        state,
+                        None,
+                        &mut out,
+                    )
+                    .unwrap();
+            }
+            out.unwrap()
+        };
+        let source = texture(64, 36, D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET, D3D12_RESOURCE_STATE_RENDER_TARGET);
+        let back = texture(128, 72, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COMMON);
+        const PITCH: u64 = 512; // 128 texels * 4 bytes, a multiple of 256
+        // SAFETY: plain object creation and recording on fresh objects.
+        unsafe {
+            let mut readback: Option<ID3D12Resource> = None;
+            device
+                .CreateCommittedResource(
+                    &D3D12_HEAP_PROPERTIES { Type: D3D12_HEAP_TYPE_READBACK, ..Default::default() },
+                    D3D12_HEAP_FLAG_NONE,
+                    &D3D12_RESOURCE_DESC {
+                        Dimension: D3D12_RESOURCE_DIMENSION_BUFFER,
+                        Width: PITCH * 72,
+                        Height: 1,
+                        DepthOrArraySize: 1,
+                        MipLevels: 1,
+                        SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+                        Layout: D3D12_TEXTURE_LAYOUT_ROW_MAJOR,
+                        ..Default::default()
+                    },
+                    D3D12_RESOURCE_STATE_COPY_DEST,
+                    None,
+                    &mut readback,
+                )
+                .unwrap();
+            let readback = readback.unwrap();
+            let rtv_heap: ID3D12DescriptorHeap = device
+                .CreateDescriptorHeap(&D3D12_DESCRIPTOR_HEAP_DESC {
+                    Type: D3D12_DESCRIPTOR_HEAP_TYPE_RTV,
+                    NumDescriptors: 1,
+                    ..Default::default()
+                })
+                .unwrap();
+            let rtv = rtv_heap.GetCPUDescriptorHandleForHeapStart();
+            device.CreateRenderTargetView(&source, None, rtv);
+            let allocator: ID3D12CommandAllocator = device.CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT).unwrap();
+            let list: ID3D12GraphicsCommandList =
+                device.CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, &allocator, None).unwrap();
+            list.ClearRenderTargetView(rtv, &[0.25, 0.5, 0.75, 1.0], None);
+            fsr.record(
+                &device,
+                &list,
+                &source,
+                D3D12_RESOURCE_STATE_RENDER_TARGET,
+                DXGI_FORMAT_R8G8B8A8_UNORM,
+                &back,
+                (128, 72),
+                DXGI_FORMAT_R8G8B8A8_UNORM,
+            )
+            .unwrap();
+            list.ResourceBarrier(&[transition(&back, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_COPY_SOURCE)]);
+            let dst = D3D12_TEXTURE_COPY_LOCATION {
+                pResource: std::mem::transmute_copy(&readback),
+                Type: D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT,
+                Anonymous: D3D12_TEXTURE_COPY_LOCATION_0 {
+                    PlacedFootprint: D3D12_PLACED_SUBRESOURCE_FOOTPRINT {
+                        Offset: 0,
+                        Footprint: D3D12_SUBRESOURCE_FOOTPRINT {
+                            Format: DXGI_FORMAT_R8G8B8A8_UNORM,
+                            Width: 128,
+                            Height: 72,
+                            Depth: 1,
+                            RowPitch: PITCH as u32,
+                        },
+                    },
+                },
+            };
+            let src = D3D12_TEXTURE_COPY_LOCATION {
+                pResource: std::mem::transmute_copy(&back),
+                Type: D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX,
+                Anonymous: D3D12_TEXTURE_COPY_LOCATION_0 { SubresourceIndex: 0 },
+            };
+            list.CopyTextureRegion(&dst, 0, 0, 0, &src, None);
+            list.Close().unwrap();
+            let queue: ID3D12CommandQueue = device
+                .CreateCommandQueue(&D3D12_COMMAND_QUEUE_DESC { Type: D3D12_COMMAND_LIST_TYPE_DIRECT, ..Default::default() })
+                .unwrap();
+            queue.ExecuteCommandLists(&[Some(list.cast().unwrap())]);
+            let fence: ID3D12Fence = device.CreateFence(0, D3D12_FENCE_FLAG_NONE).unwrap();
+            let event = CreateEventW(None, false, false, None).unwrap();
+            queue.Signal(&fence, 1).unwrap();
+            fence.SetEventOnCompletion(1, event).unwrap();
+            WaitForSingleObject(event, INFINITE);
+            let mut data = std::ptr::null_mut();
+            readback.Map(0, None, Some(&mut data)).unwrap();
+            let bytes = std::slice::from_raw_parts(data as *const u8, (PITCH * 72) as usize);
+            let want = [64i32, 128, 191];
+            for y in 0..72 {
+                for x in 0..128 {
+                    let at = y * PITCH as usize + x * 4;
+                    for c in 0..3 {
+                        let got = i32::from(bytes[at + c]);
+                        assert!((got - want[c]).abs() <= 2, "pixel {x},{y} channel {c}: {got}, want about {}", want[c]);
+                    }
+                }
+            }
+            eprintln!("FSR 1 upscaled 64x36 to 128x72; every pixel kept the flat colour");
+        }
+    }
+}
