+//! HybridGt: parts of `host.rs` moved out for the repository's file-size policy: the frame
+//! meter's methods, the presenting methods of [`Host`], and title buffer copies done on
+//! the card.
+
+use super::*;
+
+
+/// HybridGt: before a submission sent behind flights is prepared, each title
+/// buffer copy ([`Step::Copy`]) whose source or destination a flight's
+/// shaders may write is done on the card instead of on the CPU, where it has
+/// a host copy at both ends: the source range is refreshed, the destination
+/// range is declared written by the GPU (its bytes come back to title
+/// memory with the copy-back, as a shader's would), and the copy itself runs
+/// in the list's prelude, ahead of the list's commands, where the CPU copy
+/// ran too (at submission). On the CPU it waited for those flights' copy-back
+/// first: one of the two "title memory read" settles a frame, 154 ms of
+/// waiting in run next9. Copies without host copies at both ends, within one
+/// host copy, or under copies made in place, stay on the CPU.
+pub(super) fn gpu_buffer_copies(runs: &[&HostList]) {
+    if !gpu_buffer_copies_on() {
+        return;
+    }
+    let written = {
+        let line = line();
+        if line.written.is_empty() {
+            return;
+        }
+        line.written.clone()
+    };
+    for list in runs {
+        let fills = gpu_fills_on();
+        let mut deferred = list.deferred();
+        if !deferred.copies.iter().any(|s| matches!(s, Step::Copy(..)) || (fills && matches!(s, Step::Fill(..)))) {
+            continue;
+        }
+        let steps = std::mem::take(&mut deferred.copies);
+        let mut out = Vec::with_capacity(steps.len() + 4);
+        for step in steps {
+            if let Step::Copy(dst, src, len) = step
+                && (touches(&written, src, src + len) || touches(&written, dst, dst + len))
+                && let Some(to) = crate::shadow::find(dst as u64, len as u64)
+                && let Some(from) = crate::shadow::find(src as u64, len as u64)
+                && !std::sync::Arc::ptr_eq(&to, &from)
+                && let Some(at) = to.offset_of(dst as u64, len as u64)
+                && let Some(off) = from.offset_of(src as u64, len as u64)
+            {
+                out.push(Step::Refresh(from.clone(), src, len));
+                out.push(Step::GpuWrite(to.clone(), dst, len));
+                out.push(Step::GpuCopy(to, at, from, off, len as u64));
+                continue;
+            }
+            if fills
+                && let Step::Fill(dst, src, len) = step
+                && touches(&written, src, src + len)
+                && let Some((chunk, at)) = list.chunk_at(dst, len)
+                && let Some(from) = crate::shadow::find(src as u64, len as u64)
+                && let Some(off) = from.offset_of(src as u64, len as u64)
+            {
+                out.push(Step::Refresh(from.clone(), src, len));
+                out.push(Step::GpuFill(chunk, at, from, off, len as u64));
+                continue;
+            }
+            out.push(step);
+        }
+        deferred.copies = out;
+    }
+}
+
+impl Meter {
+    pub(super) fn new() -> Self {
+        let now = std::time::Instant::now();
+        Meter {
+            since: now,
+            frames: 0,
+            #[cfg(feature = "diagnostics")]
+            copy_stats_frames: 0,
+            drawn: crate::draw::drawn(),
+            logged: now,
+            caption: None,
+        }
+    }
+
+    /// Counts a presented frame.
+    pub(super) fn frame(&mut self, hwnd: HWND) {
+        #[cfg(feature = "diagnostics")]
+        tracing::debug!(target: "victory_gpu::frame", token = crate::frame::current(), "present");
+        #[cfg(feature = "diagnostics")]
+        crate::copystat::presented();
+        self.frames += 1;
+        #[cfg(feature = "diagnostics")]
+        {
+            self.copy_stats_frames += 1;
+        }
+        let elapsed = self.since.elapsed();
+        if elapsed < std::time::Duration::from_secs(1) {
+            return;
+        }
+        let drawn = crate::draw::drawn();
+        let frames = f64::from(self.frames);
+        let fps = frames / elapsed.as_secs_f64();
+        crate::fpsbox::set(fps);
+        let ms = elapsed.as_secs_f64() * 1000.0 / frames;
+        let draws = (drawn - self.drawn) as f64 / frames;
+        (self.since, self.frames, self.drawn) = (std::time::Instant::now(), 0, drawn);
+        // Of a frame, ms preparing submissions and ms waiting for the GPU.
+        let [cpu, gpu] = [0, 1].map(|i| {
+            SUBMISSION_US[i].swap(0, Ordering::Relaxed) as f64 / 1000.0 / frames
+        });
+        let [copy_ms, copy_mb, texture_ms, texture_mb] = [0, 1, 2, 3].map(|i| {
+            let scale = if i % 2 == 0 { 1e3 } else { 1e6 };
+            PREPARING[i].swap(0, Ordering::Relaxed) as f64 / scale / frames
+        });
+        let [back_ms, back_mb] = [0, 1].map(|i| {
+            COPY_BACK[i].swap(0, Ordering::Relaxed) as f64 / [1e3, 1e6][i] / frames
+        });
+        let dropped = crate::draw::take_dropped() as f64 / frames;
+        let indirect = crate::list::take_indirect() as f64 / frames;
+        let mesh_largest = MESH_GROUPS[0].swap(0, Ordering::Relaxed);
+        let mesh_groups = MESH_GROUPS[1].swap(0, Ordering::Relaxed) as f64 / frames;
+        tracing::info!(
+            "indirect mesh and compute dispatches: the largest group count asked for {mesh_largest} (run: at most 65535 a dimension), {mesh_groups:.0} groups asked per frame"
+        );
+        let [spread_direct, spread_indirect, spread_lean] =
+            [0, 1, 2].map(|i| crate::draw::SPREAD[i].swap(0, Ordering::Relaxed) as f64 / frames);
+        let [spread_over, spread_under, spread_extra] =
+            [0, 1, 2].map(|i| SPREAD_ASKED[i].swap(0, Ordering::Relaxed) as f64 / frames);
+        tracing::info!(
+            "dispatches spread across z past 65,535 groups in x (USER_DISPATCH_SPREAD), per frame: {spread_direct:.2} direct, {spread_indirect:.2} indirect ({spread_lean:.2} lean), records: {spread_over:.2} over 65,535 (+{spread_extra:.0} extra groups), {spread_under:.2} at or under 65,535 (programs that read no group id x, and the builder's stages, are not spread)"
+        );
+        // (Run 200 counted indirect compute records asking for 77,000 to
+        // 98,000 groups in x, 0.2 to 0.8 a frame, cut to the 65,535 one
+        // dispatch runs; the counter went when the clamp's budget moved to
+        // the card's memory.)
+        {
+            let [texture_us, slots] = [0, 1].map(|i| crate::draw::HEAP_PASS_PARTS[i].swap(0, Ordering::Relaxed));
+            let [slot_us, refresh_us, mirror_us, span_bytes] = [2, 3, 4, 5].map(|i| crate::draw::HEAP_PASS_PARTS[i].swap(0, Ordering::Relaxed));
+            tracing::info!("the heap pass's slot loop per frame (HybridGt): {:.1} ms making host views (mirror)", mirror_us as f64 / 1e3 / frames);
+            tracing::info!(
+                "the heap pass's parts per frame (HybridGt): {:.1} ms over buffer slots ({:.0} found unchanged and kept), {:.1} ms refreshing the copies their views cover ({:.1} MB of spans)",
+                slot_us as f64 / 1e3 / frames,
+                crate::draw::SLOTS_SKIPPED.swap(0, Ordering::Relaxed) as f64 / frames,
+                refresh_us as f64 / 1e3 / frames,
