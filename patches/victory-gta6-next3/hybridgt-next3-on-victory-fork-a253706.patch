+/// HybridGt, `VICTORY_SYNC_TIMING=1`: nanoseconds spent in the phases of
+/// [`HostHeap::mirror`] (0: lock and view lookup, 1: buffer and texture
+/// bookkeeping, 2: making the host descriptor, 3: keeping its resource) and
+/// the calls timed (4), since the last frame line. Off: one load of a flag.
+pub(crate) static SYNC_TIMES: [std::sync::atomic::AtomicU64; 5] = [const { std::sync::atomic::AtomicU64::new(0) }; 5];
+
+pub(crate) fn sync_timing() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_SYNC_TIMING").is_some_and(|v| v == "1"))
+}
+
+struct SyncLap(Option<std::time::Instant>);
+
+impl SyncLap {
+    fn start() -> Self {
+        if sync_timing() {
+            SYNC_TIMES[4].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+            SyncLap(Some(std::time::Instant::now()))
+        } else {
+            SyncLap(None)
+        }
+    }
+
+    fn mark(&mut self, phase: usize) {
+        if let Some(at) = self.0 {
+            let now = std::time::Instant::now();
+            SYNC_TIMES[phase].fetch_add((now - at).as_nanos() as u64, std::sync::atomic::Ordering::Relaxed);
+            self.0 = Some(now);
+        }
+    }
+}
