+    0xBE4C_CCCD,
+    0x3EFF_FFFF,
+    0x3F00_0000,
+    0xBF00_0000,
+    0x3F00_0001,
+    0x3F7F_FFFF,
+    0xBF7F_FFFF,
+    0x3F80_0000,
+    0xBF80_0000,
+    0x3F80_0001,
+    0x3FC0_0000,
+    0x4040_0000,
+    0x42C9_0000,
