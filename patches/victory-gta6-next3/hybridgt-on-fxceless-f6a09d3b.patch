+/// answer "visible" (their state goes back to 0).
+#[cfg(windows)]
+pub(crate) fn close_open(open: Vec<(windows::Win32::Graphics::Direct3D12::ID3D12QueryHeap, u32, u32, usize)>, list: &crate::host::HostList) {
+    for (host, kind, index, console) in open {
