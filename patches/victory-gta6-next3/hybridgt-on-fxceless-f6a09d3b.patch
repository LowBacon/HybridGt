+/// HybridGt: buffers placed in page pool sections since the start.
+static POOL_PLACED: AtomicU64 = AtomicU64::new(0);
+
+/// HybridGt: the heaps opened on committed page pool sections, by handle
+/// (each opened once and kept: the heap is the section, whatever its views
+/// do).
+static SECTION_HEAPS: Mutex<BTreeMap<usize, ID3D12Heap>> = Mutex::new(BTreeMap::new());
+
+fn section_committed(section: usize) -> bool {
+    views().sections.iter().any(|s| s.0 == section && s.2)
+}
+
+/// A buffer over bytes `[offset, offset + len)` of a committed section.
+fn place_in_section(device: &ID3D12Device, section: usize, offset: u64, len: u64) -> windows::core::Result<Placed> {
+    let heap = {
+        let mut heaps = SECTION_HEAPS.lock().unwrap_or_else(|e| e.into_inner());
+        match heaps.get(&section) {
+            Some(h) => h.clone(),
+            None => {
+                let h = open(device, From::Section(section))?;
+                heaps.insert(section, h.clone());
+                h
+            }
+        }
+    };
+    let at = offset & !(K64 as u64 - 1);
+    let bytes = (offset + len.max(1)).next_multiple_of(K64 as u64) - at;
+    let buffer = place(device, &heap, at, bytes)?;
+    // SAFETY: a live buffer.
+    let gpu = unsafe { buffer.GetGPUVirtualAddress() } + (offset - at);
+    Ok(Placed { buffer, heap, gpu, bias: offset - at })
