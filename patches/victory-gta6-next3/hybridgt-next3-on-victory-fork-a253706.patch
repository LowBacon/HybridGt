+/// taken, microseconds waiting to take it, microseconds held, and the pages
+/// the runtime asked to map or unmap under it ([`title_memory_remap_pages`]),
+/// then the calls that found their pages mapped as asked already and changed
+/// nothing.
+pub static REMAPS: [AtomicU64; 7] = [const { AtomicU64::new(0) }; 7];
+
+/// HybridGt: microseconds the runtime's mapping work spent in system calls
+/// (`system`) and in telling the GPU side what changed (`told`).
+pub fn title_memory_remap_time(system: u64, told: u64) {
+    REMAPS[5].fetch_add(system, Ordering::Relaxed);
+    REMAPS[6].fetch_add(told, Ordering::Relaxed);
+}
+
+/// HybridGt: the runtime's mapping calls count their pages here, and the
+/// calls that found nothing to change (`unchanged`).
+pub fn title_memory_remap_pages(pages: usize, unchanged: bool) {
+    REMAPS[3].fetch_add(pages as u64, Ordering::Relaxed);
+    if unchanged {
+        REMAPS[4].fetch_add(1, Ordering::Relaxed);
+    }
+}
+
 /// The runtime is about to map, unmap or move physical pages of title
 /// memory: until what it returns is dropped, no read of title memory in
 /// place is under way and none begins ([`title_memory_reading`]). Taken
 /// around the whole change, the unmapping and the mapping again.
 pub fn title_memory_remapping() -> Remapping {
     let asked = std::time::Instant::now();
-    let held = MAPPING.write().unwrap_or_else(|e| e.into_inner());
+    let guard = MAPPING.write().unwrap_or_else(|e| e.into_inner());
+    REMAPS[0].fetch_add(1, Ordering::Relaxed);
+    REMAPS[1].fetch_add(asked.elapsed().as_micros() as u64, Ordering::Relaxed);
     crate::framelog::add(crate::framelog::T::Remaps, 1);
     crate::framelog::add(crate::framelog::T::RemapWaitUs, asked.elapsed().as_micros() as u64);
-    Remapping(held, asked)
+    Remapping(guard, std::time::Instant::now())
 }
 
