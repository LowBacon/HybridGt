+    );
+
+    let [d8u_w0, d8u_w1] = vop3p_dot(0x019, 0, vgpr(1), vgpr(2), vgpr(3));
+    let dot8_u4_shader = build_valu_cs(&[d8u_w0, d8u_w1]);
