+        (0x0000_0001, 0),
+        (0x8000_0000, 0),
+        (0x1248_0F00, 0),
+        (0xF0F0_0F0F, 0x0000_0000),
+        (0x0000_0000, 0x0000_0001),
+        (0x0000_0000, 0x8000_0000),
+        (0xFFFF_FFFF, 0xFFFF_FFFF),
+        (0x0102_0408, 0x8040_2010),
+        (0x1000_0001, 0x0000_F000),
