+/// HybridGt: whether `[base, base + pages.len() pages)` shows exactly `pages`
+/// already, page for page (the title asks again for what is there).
+fn shows_already(physical: &Physical, base: usize, pages: &[usize]) -> bool {
+    pages.iter().enumerate().all(|(k, page)| {
+        let at = base + k * PAGE;
+        let Some(want) = physical.pages.get(page) else { return false };
+        physical
+            .views
+            .range(..=at)
+            .next_back()
+            .filter(|(view, (size, _))| at < **view + size)
+            .is_some_and(|(view, (_, s))| {
+                Arc::ptr_eq(&s.section, &want.section) && s.index + (at - view) / PAGE == want.index
+            })
+    })
+}
+
+/// The work of [`XMemMapPhysicalPages`] under its locks (`physical` and the
+/// GPU side's remapping lock, both held by the caller): `n` pages at `base`,
+/// `None` unmaps. False if a page or the host fails.
+///
+/// HybridGt: a range that shows the asked pages already is left as it is:
