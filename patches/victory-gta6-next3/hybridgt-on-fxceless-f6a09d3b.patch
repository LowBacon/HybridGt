+//! HybridGt diagnostics: does the title's CPU read what the relay copies back?
+//!
+//! `VICTORY_READ_PROBE=N` (off by default): after the relay merges a fetched
+//! piece of what shaders wrote into title memory (`Shadow::card_merge_relay`),
+//! every `N`th such piece's 4 KiB pages are made no-access. The first touch
+//! of one faults here: the page gets its protection back and the touch is
+//! counted, as the title's or as this runtime's (the faulting instruction in
+//! `victory.exe` or not). A probed piece that comes back for the next merge
+//! untouched is counted as never read, and opened first.
+//!
+//! What it tells: the share of copy-back bytes the CPU reads before the GPU
+//! writes them again; what nobody reads need not come down each frame.
+//! shortcut: pages are whole 4 KiB pages, so a read of bytes beside the
+//! piece in the same page counts as a read of it; kernel reads by this
+//! runtime (`read_into`) of a probed page fail instead of faulting, so
+//! fetch-on-read must not rely on this module. A diagnostics aid: frame
+//! times of a run with it are not comparable.
+
+use std::collections::HashMap;
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+const PAGE: usize = 4096;
+
+/// Protected pages: page number -> protection to give back.
+static PROBED: Mutex<Option<HashMap<usize, u32>>> = Mutex::new(None);
+
+/// Pieces probed, touched by the title, touched by this runtime, merged
+/// again untouched; bytes probed.
+static STATS: [AtomicU64; 5] = [const { AtomicU64::new(0) }; 5];
+static NEXT: AtomicU64 = AtomicU64::new(0);
+
+pub(crate) fn every() -> u64 {
+    static N: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
+    *N.get_or_init(|| std::env::var("VICTORY_READ_PROBE").ok().and_then(|v| v.trim().parse().ok()).unwrap_or(0))
+}
+
+fn pages(at: usize, len: usize) -> std::ops::Range<usize> {
+    at / PAGE..(at + len.max(1)).div_ceil(PAGE)
+}
+
+/// Before the relay merges into `[at, at + len)`: probed pages there get
+/// their protection back (counted as never read).
+pub(crate) fn before_merge(at: usize, len: usize) {
+    if every() == 0 {
+        return;
+    }
+    let mut g = PROBED.lock().unwrap_or_else(|e| e.into_inner());
+    let Some(map) = g.as_mut() else { return };
+    let mut opened = false;
+    for page in pages(at, len) {
+        if let Some(old) = map.remove(&page) {
+            restore(page, old);
+            opened = true;
+        }
+    }
+    if opened {
+        STATS[3].fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// After the relay merged `[at, at + len)`: every `N`th piece is probed.
+pub(crate) fn after_merge(at: usize, len: usize) {
+    let n = every();
+    if n == 0 || NEXT.fetch_add(1, Ordering::Relaxed) % n != 0 {
+        return;
+    }
+    install();
+    use windows_sys::Win32::System::Memory::{PAGE_NOACCESS, PAGE_READONLY, PAGE_READWRITE, VirtualProtect};
+    let mut g = PROBED.lock().unwrap_or_else(|e| e.into_inner());
+    let map = g.get_or_insert_with(HashMap::new);
+    let mut any = false;
+    for page in pages(at, len) {
+        if map.contains_key(&page) {
+            continue;
+        }
+        let mut old = 0;
+        // SAFETY: title memory the merge just wrote; only its protection changes.
+        if unsafe { VirtualProtect((page * PAGE) as *const _, PAGE, PAGE_NOACCESS, &mut old) } == 0 {
+            continue;
+        }
+        if old != PAGE_READWRITE && old != PAGE_READONLY {
+            restore(page, old);
+            continue;
+        }
+        map.insert(page, old);
+        any = true;
+    }
+    if any {
+        STATS[0].fetch_add(1, Ordering::Relaxed);
+        STATS[4].fetch_add(len as u64, Ordering::Relaxed);
+    }
+}
+
+fn restore(page: usize, old: u32) {
+    use windows_sys::Win32::System::Memory::VirtualProtect;
+    let mut was = 0;
+    // SAFETY: a page this module protected.
+    unsafe { VirtualProtect((page * PAGE) as *const _, PAGE, old, &mut was) };
+}
+
+/// `victory.exe`'s own code: [start, end).
+fn own_code() -> (usize, usize) {
+    static RANGE: std::sync::OnceLock<(usize, usize)> = std::sync::OnceLock::new();
+    *RANGE.get_or_init(|| {
+        use windows_sys::Win32::System::LibraryLoader::GetModuleHandleW;
+        use windows_sys::Win32::System::ProcessStatus::{K32GetModuleInformation, MODULEINFO};
+        use windows_sys::Win32::System::Threading::GetCurrentProcess;
+        // SAFETY: the process's own module; plain data out.
+        unsafe {
+            let module = GetModuleHandleW(std::ptr::null());
+            let mut info: MODULEINFO = std::mem::zeroed();
+            if K32GetModuleInformation(GetCurrentProcess(), module, &mut info, size_of::<MODULEINFO>() as u32) == 0 {
+                return (0, 0);
+            }
+            (info.lpBaseOfDll as usize, info.lpBaseOfDll as usize + info.SizeOfImage as usize)
+        }
+    })
+}
+
+fn install() {
+    use windows_sys::Win32::Foundation::{EXCEPTION_ACCESS_VIOLATION, NTSTATUS};
+    use windows_sys::Win32::System::Diagnostics::Debug::{
+        AddVectoredExceptionHandler, EXCEPTION_CONTINUE_EXECUTION, EXCEPTION_CONTINUE_SEARCH, EXCEPTION_POINTERS,
+    };
+    unsafe extern "system" fn on_touch(info: *mut EXCEPTION_POINTERS) -> i32 {
+        // SAFETY: the system passes the exception being dispatched.
+        let (r, rip) = unsafe { (&*(*info).ExceptionRecord, (*(*info).ContextRecord).Rip as usize) };
+        if r.ExceptionCode != EXCEPTION_ACCESS_VIOLATION as NTSTATUS || r.NumberParameters < 2 {
+            return EXCEPTION_CONTINUE_SEARCH;
+        }
+        let page = r.ExceptionInformation[1] / PAGE;
+        let mut g = PROBED.lock().unwrap_or_else(|e| e.into_inner());
+        let Some(old) = g.as_mut().and_then(|m| m.remove(&page)) else {
+            return EXCEPTION_CONTINUE_SEARCH;
+        };
+        restore(page, old);
+        let (a, b) = own_code();
+        let ours = rip >= a && rip < b;
+        STATS[if ours { 2 } else { 1 }].fetch_add(1, Ordering::Relaxed);
+        EXCEPTION_CONTINUE_EXECUTION
+    }
+    static ONCE: std::sync::Once = std::sync::Once::new();
+    // SAFETY: the handler touches only this module's state and protections.
+    ONCE.call_once(|| unsafe {
+        AddVectoredExceptionHandler(1, Some(on_touch));
+    });
+}
+
+/// The line for the frame-rate log (since the start).
+pub(crate) fn line() -> Option<String> {
+    if every() == 0 {
+        return None;
+    }
+    let s: Vec<u64> = STATS.iter().map(|s| s.load(Ordering::Relaxed)).collect();
+    Some(format!(
+        "copy-back read probe (VICTORY_READ_PROBE={}), since the start: {} pieces probed ({} MB); read by the title {}, by this runtime {}, merged again unread {}",
+        every(),
+        s[0],
+        s[4] >> 20,
+        s[1],
+        s[2],
+        s[3]
+    ))
+}
