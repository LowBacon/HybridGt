+    use super::*;
+
+    /// The masked merge on the card (`CARD_MERGE`): for the runs a
+    /// `MergeLog` took, the card side gets exactly those bytes of the CPU
+    /// side, and every other byte stays as it was. On the first adapter.
+    #[test]
+    fn the_merge_writes_the_masked_bytes_and_nothing_else() {
+        let Some(h) = host() else {
+            return;
+        };
+        let (root, pso) = h.make_card_merge().expect("the merge's pipeline");
+        const SIZE: usize = 64 << 10;
+        let (side, side_data) = h.shared_buffer(SIZE as u64).expect("side");
+        let (card, card_data) = h.shared_buffer(SIZE as u64).expect("card");
+        let runs = [(5usize, 2usize), (7, 3), (100, 1), (4096, 17), (8191, 2), (SIZE - 4, 4)];
+        let mut log = crate::shadow::MergeLog::default();
+        for &(at, n) in &runs {
+            log.add(at, n);
+        }
+        let entries = log.take(1);
+        let (list_buf, list_data) = h.shared_buffer(1 << 20).expect("entries");
+        // SAFETY: the mappings hold SIZE bytes, 1 MiB; nothing runs on them.
+        unsafe {
+            for i in 0..SIZE {
+                *side_data.add(i) = (i * 7 + 3) as u8;
+                *card_data.add(i) = (i * 13 + 1) as u8;
+            }
+            std::ptr::copy_nonoverlapping(entries.as_ptr().cast::<u8>(), list_data, entries.len() * 8);
+        }
+        let (allocator, list) = h.make_prelude().expect("a list");
+        // SAFETY: fresh objects, live buffers, the merge's own root signature.
+        unsafe {
+            allocator.Reset().unwrap();
+            list.Reset(&allocator, None).unwrap();
+            list.SetComputeRootSignature(&root);
+            list.SetPipelineState(&pso);
+            list.SetComputeRootShaderResourceView(1, side.GetGPUVirtualAddress());
+            list.SetComputeRootShaderResourceView(2, list_buf.GetGPUVirtualAddress());
+            list.SetComputeRootUnorderedAccessView(3, card.GetGPUVirtualAddress());
+            let constants = [entries.len() as u32, SIZE as u32, 0];
+            list.SetComputeRoot32BitConstants(0, 3, constants.as_ptr().cast(), 0);
+            list.Dispatch((entries.len() as u32).div_ceil(64), 1, 1);
+            list.Close().unwrap();
+            let fence: ID3D12Fence = h.device.CreateFence(0, D3D12_FENCE_FLAG_NONE).unwrap();
+            let event = CreateEventW(None, false, false, None).unwrap();
+            h.queue.ExecuteCommandLists(&[Some(list.cast().unwrap())]);
+            h.queue.Signal(&fence, 1).unwrap();
+            fence.SetEventOnCompletion(1, event).unwrap();
+            WaitForSingleObject(event, INFINITE);
+            let merged = |i: usize| runs.iter().any(|&(at, n)| i >= at && i < at + n);
+            for i in 0..SIZE {
+                let want = if merged(i) { (i * 7 + 3) as u8 } else { (i * 13 + 1) as u8 };
+                assert_eq!(*card_data.add(i), want, "byte {i} (merged: {})", merged(i));
+            }
+        }
+        eprintln!("merged {} dwords on the card; every other byte as it was", entries.len());
+    }
+}
