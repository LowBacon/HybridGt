+    let mut shaders = vec![shader(first, code)];
+    shaders.extend(ps.map(|ps| shader("pixel", ps)));
+    let key = {
+        let mut h = blake3::Hasher::new();
+        for s in &shaders {
+            h.update(s.hash.as_bytes());
+        }
+        h.update(&regs);
+        h.update(&layout);
+        h.finalize().to_hex()[..32].to_owned()
+    };
+    // Target formats an earlier run drew it with: its host pipelines are
+    // started now, while the title loads, not at its first draw.
+    let mut made = Vec::new();
+    for rects in [false, true] {
+        for (targets, depth) in formats::remembered(&formats::name(&key, rects)) {
+            let t: Vec<windows::Win32::Graphics::Dxgi::Common::DXGI_FORMAT> =
+                targets.iter().map(|&f| windows::Win32::Graphics::Dxgi::Common::DXGI_FORMAT(f)).collect();
+            let state = host::GraphicsState::console(&regs, &layout, &t, windows::Win32::Graphics::Dxgi::Common::DXGI_FORMAT(depth), rects);
+            let pending = Box::new(Arc::new(make::Pending::new(shaders.clone(), Some(Box::new(state)))));
+            make::begin(&pending);
+            made.push((targets, depth, rects, pending));
+        }
+    }
+    let pipeline = Box::new(Pipeline {
+        object: Object::new(&FUNCTIONS),
+        packet: [0; 8],
+        // Never made itself: a pipeline with no shaders.
+        host: Arc::new(make::Pending::new(Vec::new(), None)),
+        builder: false,
+        shaders: shaders.clone(),
+        bound: std::sync::atomic::AtomicBool::new(false),
+        console: Some(Box::new(Console {
+            key,
+            shaders,
+            regs,
+            layout,
+            made: Mutex::new(made),
+        })),
     });
     object::hand_out(PIPELINE, pipeline, iid, &PIPELINE_IIDS, out)
 }
 
+/// HybridGt: the target formats each 0x1c8 pipeline was drawn with, kept
+/// across runs in `console-formats.txt` beside the pipeline library (one
+/// line each: pipeline key, depth format, target formats), so that the next
+/// run starts making its host pipelines when the title creates it.
+#[cfg(windows)]
+mod formats {
+    use std::collections::HashMap;
+    use std::io::Write;
+    use std::sync::Mutex;
+
+    type Sets = Vec<(Vec<i32>, i32)>;
+    static KNOWN: Mutex<Option<HashMap<String, Sets>>> = Mutex::new(None);
+    static FILE: std::sync::OnceLock<Option<std::path::PathBuf>> = std::sync::OnceLock::new();
+
+    fn file() -> Option<&'static std::path::PathBuf> {
+        FILE.get_or_init(|| {
+            let dir = std::env::var_os("VICTORY_CACHE_DIR")?;
+            Some(std::path::PathBuf::from(dir).join("console-formats.txt"))
+        })
+        .as_ref()
+    }
+
+    fn with<R>(f: impl FnOnce(&mut HashMap<String, Sets>) -> R) -> R {
+        let mut known = KNOWN.lock().unwrap_or_else(|e| e.into_inner());
+        let known = known.get_or_insert_with(|| {
+            let mut map: HashMap<String, Sets> = HashMap::new();
+            if let Some(text) = file().and_then(|p| std::fs::read_to_string(p).ok()) {
+                for line in text.lines() {
+                    let mut f = line.split(' ');
+                    let (Some(key), Some(depth)) = (f.next(), f.next().and_then(|d| d.parse().ok())) else { continue };
+                    let targets: Vec<i32> = f.filter_map(|t| t.parse().ok()).collect();
+                    let sets = map.entry(key.to_owned()).or_default();
+                    if !sets.iter().any(|s| s.0 == targets && s.1 == depth) {
+                        sets.push((targets, depth));
+                    }
+                }
+            }
+            map
+        });
+        f(known)
+    }
+
+    #[cfg(test)]
+    mod tests {
+        /// What one run notes, the file holds once, and the map answers.
+        #[test]
+        fn formats_are_remembered_once_and_written_down() {
+            let dir = std::env::temp_dir().join(format!("hgt-formats-{}", std::process::id()));
+            std::fs::create_dir_all(&dir).unwrap();
+            // SAFETY: set before the module's first look at it, in this test only.
+            unsafe { std::env::set_var("VICTORY_CACHE_DIR", &dir) };
+            super::remember("k1", &[28, 10], 45);
+            super::remember("k1", &[28, 10], 45);
+            super::remember("k1", &[87], 0);
+            assert_eq!(super::remembered("k1"), vec![(vec![28, 10], 45), (vec![87], 0)]);
+            assert!(super::remembered("k2").is_empty());
+            let text = std::fs::read_to_string(dir.join("console-formats.txt")).unwrap();
+            assert_eq!(text.lines().collect::<Vec<_>>(), ["k1 45 28 10", "k1 0 87"]);
+            let _ = std::fs::remove_dir_all(&dir);
+        }
+    }
+
+    /// The name a pipeline's format sets are kept under: its key, with `r`
+    /// for its rectangle-list version.
+    pub(super) fn name(key: &str, rects: bool) -> String {
+        if rects { format!("{key}r") } else { key.to_owned() }
+    }
+
+    /// The format sets an earlier run drew pipeline `key` with.
+    pub(super) fn remembered(key: &str) -> Sets {
+        with(|m| m.get(key).cloned().unwrap_or_default())
+    }
+
+    /// Notes that pipeline `key` was drawn with `targets` and `depth`.
+    pub(super) fn remember(key: &str, targets: &[i32], depth: i32) {
+        let new = with(|m| {
+            let sets = m.entry(key.to_owned()).or_default();
+            let new = !sets.iter().any(|s| s.0 == targets && s.1 == depth);
+            if new {
+                sets.push((targets.to_vec(), depth));
+            }
+            new
+        });
+        if new && let Some(path) = file() {
+            let line: Vec<String> = targets.iter().map(i32::to_string).collect();
+            if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+                let _ = writeln!(f, "{key} {depth} {}", line.join(" "));
+            }
+        }
+    }
+}
