+/// HybridGt component check (`victory console-pipelines`): whether a host
+/// pipeline is made for a saved 0x1c8 description, by the runtime's own
+/// path, into an 8-bit colour target and a depth-stencil target: the
+/// containers found from the code headers, then made. `Err` says what
+/// failed.
+#[cfg(windows)]
+pub fn check_console_graphics(
+    first: &'static str,
+    header: &[u8; 12],
+    ps_header: Option<&[u8; 12]>,
+    regs: &[u8],
+    layout: &[u8],
+) -> Result<(), &'static str> {
+    use windows::Win32::Graphics::Dxgi::Common::{DXGI_FORMAT_D24_UNORM_S8_UINT, DXGI_FORMAT_R8G8B8A8_UNORM};
+    let code = crate::container_for(header).ok_or("vertex or mesh code not in the index")?;
+    let mut shaders = vec![shader(first, &code)];
+    if let Some(h) = ps_header {
+        let ps = crate::container_for(h).ok_or("pixel code not in the index")?;
+        shaders.push(shader("pixel", &ps));
+    }
+    if shaders.iter().any(|s| s.translated().is_none()) {
+        return Err("a shader does not translate");
+    }
+    let state = host::GraphicsState::console(regs, layout, &[DXGI_FORMAT_R8G8B8A8_UNORM], DXGI_FORMAT_D24_UNORM_S8_UINT, false);
+    host::HostPipeline::new(&shaders, Some(&state)).ok_or("the host refused the pipeline")?;
+    // Its rectangle-list version too (a geometry stage completes them), for
+    // pipelines with a vertex stage.
+    if first == "vertex" {
+        let rects = host::GraphicsState::console(regs, layout, &[DXGI_FORMAT_R8G8B8A8_UNORM], DXGI_FORMAT_D24_UNORM_S8_UINT, true);
+        let made = host::HostPipeline::new(&shaders, Some(&rects)).ok_or("the host refused the rectangle version")?;
+        if !made.rects {
+            return Err("the rectangle version has no rectangle stage");
+        }
+    }
+    Ok(())
+}
+
+/// The host pipeline of `this` for a draw into `targets` (formats as the
+/// host views them) and `depth`: a 0x1c8 pipeline's for those formats
+/// (made on first use), any other pipeline's own ([`host_pipeline`]).
+#[cfg(windows)]
+pub(crate) fn host_pipeline_for<'a>(
+    this: This,
+    targets: &[windows::Win32::Graphics::Dxgi::Common::DXGI_FORMAT],
+    depth: windows::Win32::Graphics::Dxgi::Common::DXGI_FORMAT,
+    rects: bool,
+) -> Option<&'a host::HostPipeline> {
+    if this.is_null() {
+        return None;
+    }
+    let p = pipeline(this);
+    let Some(console) = &p.console else {
+        return make::ready(&p.host);
+    };
+    let key: Vec<i32> = targets.iter().map(|f| f.0).collect();
+    let pending: *const Arc<make::Pending> = {
+        let mut made = console.made.lock().unwrap_or_else(|e| e.into_inner());
+        match made.iter().find(|m| m.0 == key && m.1 == depth.0 && m.2 == rects) {
+            Some(m) => &*m.3,
+            None => {
+                let state = host::GraphicsState::console(&console.regs, &console.layout, targets, depth, rects);
+                let pending = Box::new(Arc::new(make::Pending::new(console.shaders.clone(), Some(Box::new(state)))));
+                let at: *const Arc<make::Pending> = &*pending;
+                formats::remember(&formats::name(&console.key, rects), &key, depth.0);
+                made.push((key, depth.0, rects, pending));
+                at
+            }
+        }
+    };
+    // SAFETY: boxed, and kept while the pipeline lives (never removed).
+    make::ready(unsafe { &*pending })
+}
+
+/// HybridGt: a pipeline object with no shaders, for the device methods the
+/// runtime does not implement yet (0x1c8, 0x218): the title holds a real
+/// object (reference counts, queries), and its draws and dispatches with it
+/// are dropped as those of any pipeline without a host pipeline.
+pub(crate) fn placeholder(iid: *const Iid, out: *mut This) -> HRESULT {
+    hand_out(
+        Vec::new(),
+        #[cfg(windows)]
+        None,
+        iid,
+        out,
+    )
+}
+
+/// HybridGt: a compute pipeline from one shader container (device method
+/// 0x218, its code found as a container's by `crate::container_for`).
+pub(crate) fn compute_from_container(bytes: &[u8], iid: *const Iid, out: *mut This) -> HRESULT {
+    hand_out(
+        vec![shader("compute", bytes)],
+        #[cfg(windows)]
+        None,
+        iid,
+        out,
+    )
+}
