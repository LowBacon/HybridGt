+impl MergeLog {
+    /// Bytes `[from, from + len)` of the copy are the title's on the CPU's
+    /// side and go to the card's side at the next send, those bytes only.
+    pub(crate) fn add(&mut self, from: usize, len: usize) {
+        if len == 0 {
+            return;
+        }
+        for byte in from..from + len {
+            let dword = (byte & !3) as u32;
+            let bit = 0xFFu32 << ((byte & 3) * 8);
+            match self.pending.last_mut() {
+                Some(last) if last.0 == dword => last.1 |= bit,
+                _ => self.pending.push((dword, bit)),
+            }
+        }
+        if self.batches.back().is_none_or(|b| b.sent != u64::MAX) {
+            self.batches.push_back(MergeBatch { sent: u64::MAX, sorted: true, ..Default::default() });
+        }
+        let Some(batch) = self.batches.back_mut() else { return };
+        if batch.runs.last().is_some_and(|&(a, _)| a > from) {
+            batch.sorted = false;
+        }
+        batch.runs.push((from, from + len));
+        batch.longest = batch.longest.max(len);
+    }
+
+    /// At a send numbered `sent_as`: the entries for the shader, each dword
+    /// once (its masks joined), and the pending runs now numbered.
+    pub(crate) fn take(&mut self, sent_as: u64) -> Vec<(u32, u32)> {
+        let mut entries = std::mem::take(&mut self.pending);
+        entries.sort_unstable_by_key(|e| e.0);
+        entries.dedup_by(|b, a| {
+            if a.0 == b.0 {
+                a.1 |= b.1;
+                true
+            } else {
+                false
+            }
+        });
+        if let Some(batch) = self.batches.back_mut()
+            && batch.sent == u64::MAX
+        {
+            batch.sent = sent_as;
+            batch.sort();
+        }
+        entries
+    }
+
+    /// Forgets the runs of sends up to `fetched` (a fetch sent after them
+    /// has been merged: no copy-back reads the card from before them).
+    pub(crate) fn prune(&mut self, fetched: u64) {
+        while self.batches.front().is_some_and(|b| b.sent <= fetched) {
+            self.batches.pop_front();
+        }
+    }
+
+    /// The runs overlapping `[from, to)` that a fetch sent after send
+    /// `fetched_after` did not see on the card (pending ones included).
+    pub(crate) fn unseen(&mut self, from: usize, to: usize, fetched_after: u64) -> Vec<(usize, usize)> {
+        let mut out = Vec::new();
+        for batch in self.batches.iter_mut().filter(|b| b.sent > fetched_after) {
+            batch.sort();
+            let low = from.saturating_sub(batch.longest);
+            let first = batch.runs.partition_point(|r| r.0 < low);
+            out.extend(batch.runs[first..].iter().take_while(|r| r.0 < to).filter(|r| r.1 > from).copied());
+        }
+        out.sort_unstable();
+        out
+    }
+}
+
+/// HybridGt: at a send numbered `sent_as`, per copy in the card's memory with
+/// pending merges: the shader's entries and the 64 KiB pieces they touch
+/// (spans to hash again after the merge). Runs of sends a merged fetch has
+/// passed are forgotten here too.
+pub(crate) fn card_merges(sent_as: u64) -> Vec<(Arc<Shadow>, Vec<(u32, u32)>, Vec<(usize, usize)>)> {
+    let fetched = RELAY_FETCHED.load(Ordering::Acquire);
+    let carded = CARDED.lock().unwrap_or_else(|e| e.into_inner());
+    let mut out = Vec::new();
+    for weak in carded.iter() {
+        let Some(shadow) = weak.upgrade() else {
+            continue;
+        };
+        let Some(card) = shadow.card.as_ref() else {
+            continue;
+        };
+        let entries = {
+            let _side = shadow.before.lock().unwrap_or_else(|e| e.into_inner());
+            let mut log = card.merges.lock().unwrap_or_else(|e| e.into_inner());
+            log.prune(fetched);
+            if log.pending.is_empty() {
+                continue;
+            }
+            log.take(sent_as)
+        };
+        let mut spans: Vec<(usize, usize)> = Vec::new();
+        for &(dword, _) in &entries {
+            let piece = dword as usize / PAGE * PAGE;
+            match spans.last_mut() {
+                Some(last) if last.1 >= piece => last.1 = last.1.max(piece + PAGE),
+                _ => spans.push((piece, piece + PAGE)),
+            }
+        }
+        let size = card.size as usize;
+        for span in &mut spans {
+            span.1 = span.1.min(size);
+        }
+        out.push((shadow, entries, spans));
+    }
+    out
+}
