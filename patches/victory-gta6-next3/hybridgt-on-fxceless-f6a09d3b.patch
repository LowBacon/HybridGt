+                        "dot4AddPacked.i32",
+                        Attr::ReadNone,
+                        self.s.t.i32,
+                        163,
+                        &[zero, s0, s1],
+                    );
+                    sat_i32_add(self, d, acc)
+                } else {
+                    self.s.op(
+                        c,
+                        "dot4AddPacked.i32",
+                        Attr::ReadNone,
+                        self.s.t.i32,
+                        163,
+                        &[acc, s0, s1],
+                    )
+                };
+                write_dot_int(self, r)
