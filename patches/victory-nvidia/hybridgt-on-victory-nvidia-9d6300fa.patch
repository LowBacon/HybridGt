+/// HybridGt: DXIL wants the elements packed into one row to share one
+/// interpolation mode (the validator: "has interpolation mode that differs
+/// from another element packed into the same row"); the console's packing
+/// does not care. Two cases are put right here without changing a value:
+///
+/// - outputs of a vertex, mesh or geometry stage: there the mode is only a
+///   declaration (the pixel stage's inputs choose how values are
+///   interpolated, and stages link by semantic, register and mask), so a row
+///   that mixes modes takes one: constant if any element of it is an integer
+///   or constant, else the mode of its first element;
+/// - pixel inputs the rasterizer makes (`SV_IsFrontFace`, `SV_SampleIndex`):
+///   no earlier stage writes them, so one in a row of another mode gets a
+///   row of its own after the others;
+/// - pixel inputs the program never reads: they take the mode of the row's
+///   inputs that are read (constant if none is).
+///
+/// Elements without a mode (0) or a row are left alone. Returns how many
+/// elements changed.
+pub(crate) fn one_mode_a_row(elements: &mut [SigElement], pixel_inputs: bool) -> usize {
+    let rows: std::collections::BTreeSet<u32> = elements.iter().filter_map(|e| e.row).collect();
+    let mut changed = 0;
+    let mut free = rows.iter().next_back().map_or(0, |r| r + 1);
+    for row in rows {
+        let of: Vec<usize> = (0..elements.len())
+            .filter(|&i| elements[i].row == Some(row) && elements[i].interp != 0)
+            .collect();
+        let Some(&first) = of.iter().min_by_key(|&&i| elements[i].col) else {
+            continue;
+        };
+        if of.iter().all(|&i| elements[i].interp == elements[first].interp) {
+            continue;
+        }
+        if pixel_inputs {
+            for &i in &of {
+                if matches!(elements[i].kind, 11 | 13) {
+                    elements[i].row = Some(free);
+                    elements[i].col = 0;
+                    free += 1;
+                    changed += 1;
+                }
+            }
+            // Inputs the program never reads (usage 0): their mode changes
+            // no value, so they take the mode of the row's inputs that are
+            // read (constant if none is), when one mode serves them all and
+            // the type allows it (an integer is never interpolated).
+            let of: Vec<usize> = of.into_iter().filter(|&i| elements[i].row == Some(row)).collect();
+            let read: std::collections::BTreeSet<u8> =
+                of.iter().filter(|&&i| elements[i].usage != 0).map(|&i| elements[i].interp).collect();
+            if read.len() <= 1 {
+                let mode = read.into_iter().next().unwrap_or(1);
+                for &i in &of {
+                    let integer = matches!(elements[i].comp, 1 | 4 | 5);
+                    if elements[i].usage == 0 && elements[i].interp != mode && (mode == 1 || !integer) {
+                        elements[i].interp = mode;
+                        changed += 1;
+                    }
+                }
+            }
+        } else {
+            let constant = of.iter().any(|&i| elements[i].interp == 1 || matches!(elements[i].comp, 1 | 4 | 5));
+            let mode = if constant { 1 } else { elements[first].interp };
+            for &i in &of {
+                if elements[i].interp != mode {
+                    elements[i].interp = mode;
+                    changed += 1;
+                }
+            }
+        }
+    }
+    changed
+}
