+            "v_dot2_f32_f16" | "v_dot2c_f32_f16" => {
+                let f32t = self.s.t.f32;
+                let is_vop3p = inst.machine.encoding == Encoding::Vop3p;
+                let (s0_lo, s0_hi, s1_lo, s1_hi) = if is_vop3p {
