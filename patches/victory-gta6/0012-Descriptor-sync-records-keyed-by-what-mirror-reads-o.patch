From d0bbc4a6eddbf8f6c26028f1ed731e741adb5c46 Mon Sep 17 00:00:00 2001
From: LowBacon <lenni.a.jokitalo@gmail.com>
Date: Wed, 25 Nov 2026 09:46:53 +0200
Subject: [PATCH] Descriptor sync: records keyed by what mirror reads, one lock
 a page (HybridGt)

sync_heaps looked at about 234,000 slots a frame in the world and took a
BLAKE3 hash of each 32-byte record under a lock of its own. mirror reads
only the record's first 12 bytes (VIEW_TAG, index, generation), so that is
now the key: the same slots are mirrored, and the change check over 234,000
slots takes 0.83 ms where it took 15.1 ms (ignored test change_check_cost,
RTX 4070 Ti host CPU). The seen keys are locked once per page.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/victory-gpu/src/descriptor.rs      |  11 +-
 crates/victory-gpu/src/descriptor/host.rs | 137 +++++++++++++++++++---
 2 files changed, 124 insertions(+), 24 deletions(-)

diff --git a/crates/victory-gpu/src/descriptor.rs b/crates/victory-gpu/src/descriptor.rs
index 6aad6da..bc74034 100644
--- a/crates/victory-gpu/src/descriptor.rs
+++ b/crates/victory-gpu/src/descriptor.rs
@@ -178,6 +178,7 @@ pub(crate) fn sync_heaps() {
     let started = std::time::Instant::now();
     let (mut pages, mut looked, mut mirrored) = (0u64, 0u64, 0u64);
     let mut page_bytes: Vec<u8> = Vec::new();
+    let mut batch: Vec<(u32, u64, u64)> = Vec::new();
     let heaps = SHADER_HEAPS.lock().unwrap_or_else(|e| e.into_inner());
     for &(start, end, at) in heaps.iter() {
         // SAFETY: registered heaps are live (removed when dropped).
@@ -203,6 +204,7 @@ pub(crate) fn sync_heaps() {
                 if crate::host::read_into(from as *const u8, &mut page_bytes) {
                     pages += 1;
                     let slots = changed_slots(from, to, start as usize, step, mirrored_count);
+                    batch.clear();
                     for index in slots {
                         let handle = start + index * step;
                         // A record that straddles the range's ends is left
@@ -214,12 +216,11 @@ pub(crate) fn sync_heaps() {
                             continue;
                         };
                         looked += 1;
-                        // Only a record that is not the one last seen there
-                        // (`HostHeap::mirror_copied`).
-                        if host.mirror_copied(index as u32, handle, record) {
-                            mirrored += 1;
-                        }
+                        batch.push((index as u32, handle, host::copied_key(record)));
                     }
+                    // Only records that are not the ones last seen there
+                    // (`HostHeap::mirror_copied_batch`).
+                    mirrored += host.mirror_copied_batch(&batch);
                 }
                 page += crate::watch::PAGE;
             }
diff --git a/crates/victory-gpu/src/descriptor/host.rs b/crates/victory-gpu/src/descriptor/host.rs
index 78a1740..c0f6d47 100644
--- a/crates/victory-gpu/src/descriptor/host.rs
+++ b/crates/victory-gpu/src/descriptor/host.rs
@@ -28,7 +28,7 @@ pub(crate) struct HostHeap {
     made: Mutex<Vec<u64>>,
     /// A fingerprint of the record each slot held when the pass over
     /// records copied in as bytes last looked at it
-    /// ([`HostHeap::mirror_copied`]; 0: never looked at). Made on first use.
+    /// ([`HostHeap::mirror_copied_batch`]; 0: never looked at). Made on first use.
     copied: Mutex<Vec<u64>>,
     /// The host resource each slot views, held while the slot does: shaders
     /// index heaps directly, so a slot the title has not rewritten since it
@@ -856,6 +856,26 @@ pub(crate) fn probe_view_limit() {
 /// table past them is made afresh in these slots like any other.
 pub(crate) const DYNAMIC: u32 = 1 << 18;
 
+/// HybridGt: what [`HostHeap::mirror`] reads of a record, as one key: a view of
+/// ours is `[VIEW_TAG, index, generation]` in its first 12 bytes and `mirror`
+/// reads nothing else, so two records with the same key are mirrored alike.
+/// Generations start at 1: a view's key is never 0 nor [`NOT_A_VIEW`].
+/// (It replaced a BLAKE3 hash of the whole record, run on about 234,000
+/// slots a frame in the world: the same answers, at a fraction of the cost.)
+pub(crate) fn copied_key(record: &[u8]) -> u64 {
+    let word = |k: usize| record.get(k * 4..k * 4 + 4).map(|b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]));
+    match (word(0), word(1), word(2)) {
+        (Some(tag), Some(i), Some(generation)) if tag == VIEW_TAG && generation != 0 => {
+            let key = u64::from(generation) << 32 | u64::from(i);
+            if key == NOT_A_VIEW { NOT_A_VIEW - 1 } else { key }
+        }
+        _ => NOT_A_VIEW,
+    }
+}
+
+/// HybridGt: [`copied_key`] of every record that is not a view of ours.
+pub(crate) const NOT_A_VIEW: u64 = u64::MAX;
+
 impl HostHeap {
     pub(crate) fn new(sampler: bool, count: u32) -> Option<Self> {
         let host = host()?;
@@ -1803,8 +1823,8 @@ impl HostHeap {
 
     /// For a slot on a page of the title's heap that changed with no call
     /// (`super::sync_heaps`: the title copies records into its heap as
-    /// bytes): [`HostHeap::mirror`], if the `bytes` bytes of the record at
-    /// `handle` are not the ones this last saw there. True if it did.
+    /// bytes): [`HostHeap::mirror`], if the record at `handle` is not the one
+    /// this last saw there ([`copied_key`]).
     ///
     /// The page says only that something on it was written, and `mirror`
     /// by itself would take every buffer or placed-texture record on it for
@@ -1815,29 +1835,38 @@ impl HostHeap {
     /// `record`: the record's bytes as the caller read them (through the
     /// kernel, which fails on a page the title unmapped meanwhile where a
     /// read in place would fault: the title unmaps heap pages too).
-    pub(crate) fn mirror_copied(&self, index: u32, handle: u64, record: &[u8]) -> bool {
-        if index >= self.count {
-            return false;
-        }
-        let n = record.len();
-        // Never 0, which is "never looked at".
-        let print = u64::from_le_bytes(blake3::hash(record).as_bytes()[..8].try_into().unwrap_or([1; 8])) | 1;
+    ///
+    /// HybridGt: done for the slots of one page at once, `(index, handle,
+    /// copied_key(record))` each: one lock of the seen keys for the batch instead
+    /// of one a slot; the slots whose key changed are then mirrored. Returns how many were.
+    pub(crate) fn mirror_copied_batch(&self, slots: &[(u32, u64, u64)]) -> u64 {
+        let mut changed: Vec<(u32, u64)> = Vec::new();
         {
             let mut copied = self.copied.lock().unwrap_or_else(|e| e.into_inner());
             if copied.is_empty() {
                 copied.resize(self.count as usize, 0);
             }
-            let Some(last) = copied.get_mut(index as usize) else {
-                return false;
-            };
-            // A slot never looked at that holds nothing: as it was.
-            if *last == print || (*last == 0 && record[..n].iter().all(|&b| b == 0)) {
-                return false;
+            for &(index, handle, key) in slots {
+                if index >= self.count {
+                    continue;
+                }
+                let Some(last) = copied.get_mut(index as usize) else {
+                    continue;
+                };
+                // A slot never looked at that holds no view of ours: `mirror`
+                // would find nothing to undo there.
+                if *last == key || (*last == 0 && key == NOT_A_VIEW) {
+                    *last = key;
+                    continue;
+                }
+                *last = key;
+                changed.push((index, handle));
             }
-            *last = print;
         }
-        self.mirror(index, handle, false);
-        true
+        for &(index, handle) in &changed {
+            self.mirror(index, handle, false);
+        }
+        changed.len() as u64
     }
 
     /// Makes host slot `index` from the record the title has at `handle`
@@ -3573,3 +3602,73 @@ pub(crate) fn heap_samplers(list: &[(u32, [u32; 4])]) {
         }
     }
 }
+
+#[cfg(test)]
+mod copied_key_tests {
+    use super::{NOT_A_VIEW, VIEW_TAG, copied_key};
+
+    fn record(words: [u32; 3], tail: u8) -> Vec<u8> {
+        let mut r: Vec<u8> = words.iter().flat_map(|w| w.to_le_bytes()).collect();
+        r.extend(std::iter::repeat_n(tail, 20));
+        r
+    }
+
+    /// The key is what `mirror` reads: the view's index and generation; the
+    /// 20 bytes after them never change it, anything else does.
+    #[test]
+    fn the_key_is_what_mirror_reads() {
+        let a = copied_key(&record([VIEW_TAG, 7, 1], 0));
+        assert_eq!(a, copied_key(&record([VIEW_TAG, 7, 1], 0xab)));
+        assert_ne!(a, copied_key(&record([VIEW_TAG, 8, 1], 0)));
+        assert_ne!(a, copied_key(&record([VIEW_TAG, 7, 2], 0)));
+        assert_ne!(a, 0);
+        assert_ne!(a, NOT_A_VIEW);
+        // Not a view of ours: zeros, another tag, generation 0, too short.
+        assert_eq!(copied_key(&[0; 32]), NOT_A_VIEW);
+        assert_eq!(copied_key(&record([0x1234, 7, 1], 0)), NOT_A_VIEW);
+        assert_eq!(copied_key(&record([VIEW_TAG, 7, 0], 0)), NOT_A_VIEW);
+        assert_eq!(copied_key(&VIEW_TAG.to_le_bytes()), NOT_A_VIEW);
+        assert_ne!(copied_key(&record([VIEW_TAG, u32::MAX, u32::MAX], 0)), NOT_A_VIEW);
+    }
+
+    /// Cost of the change check per frame in the world (234,000 slots a frame,
+    /// run next1): the old BLAKE3 print with a lock a slot against the key with
+    /// one lock a page (2,048 slots). Ignored by default:
+    /// `cargo test -p victory-gpu --release -- --ignored change_check_cost --nocapture`
+    #[test]
+    #[ignore]
+    fn change_check_cost() {
+        use std::sync::Mutex;
+        const SLOTS: usize = 234_000;
+        let records: Vec<Vec<u8>> = (0..SLOTS).map(|i| record([VIEW_TAG, i as u32, 1 + (i % 3) as u32], 0)).collect();
+        let seen = Mutex::new(vec![0u64; SLOTS]);
+        let t = std::time::Instant::now();
+        let mut n = 0;
+        for (i, r) in records.iter().enumerate() {
+            let print = u64::from_le_bytes(blake3::hash(r).as_bytes()[..8].try_into().unwrap()) | 1;
+            let mut s = seen.lock().unwrap();
+            if s[i] != print {
+                s[i] = print;
+                n += 1;
+            }
+        }
+        let old = t.elapsed();
+        let seen = Mutex::new(vec![0u64; SLOTS]);
+        let t = std::time::Instant::now();
+        let mut m = 0;
+        for (p, page) in records.chunks(2048).enumerate() {
+            let keys: Vec<u64> = page.iter().map(|r| copied_key(r)).collect();
+            let mut s = seen.lock().unwrap();
+            for (k, key) in keys.into_iter().enumerate() {
+                let i = p * 2048 + k;
+                if s[i] != key {
+                    s[i] = key;
+                    m += 1;
+                }
+            }
+        }
+        let new = t.elapsed();
+        assert_eq!(n, m);
+        eprintln!("change check of {SLOTS} slots: BLAKE3 + lock a slot {old:?}, key + lock a page {new:?}");
+    }
+}
