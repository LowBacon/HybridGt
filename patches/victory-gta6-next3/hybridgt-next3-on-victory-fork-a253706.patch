diff --git a/crates/victory-shader/src/emit/lower/gs.rs b/crates/victory-shader/src/emit/lower/gs.rs
new file mode 100644
index 0000000..9d471a6
--- /dev/null
+++ b/crates/victory-shader/src/emit/lower/gs.rs
@@ -0,0 +1,261 @@
+//! HybridGt: legacy (non-NGG) GFX10 geometry programs as host geometry
+//! shaders.
+//!
+//! On the console the geometry program reads its primitive's vertices from
+//! the ES-GS ring in LDS, at byte offsets the hardware passes packed in `v0`
+//! (vertices 0 and 1, low and high halves) and `v1` (vertex 2), and writes
+//! each vertex it emits to the GS-VS ring at its own slot, then sends
+//! `GS_EMIT`; a copy shader the driver makes reads the ring and exports.
+//! Ring dword `k` of a vertex is signature register `k / 4`, column `k % 4`
+//! (the title's `ISG1`/`OSG1` rows; seen in `GS_VoxelizeGeneric`: 5 output
+//! registers, 20 dwords a vertex).
+//!
+//! Here: ES-GS reads at a vertex's offset become `loadInput` of that vertex;
+//! GS-VS writes are kept per vertex (dword `d` of the slot is vertex
+//! `d / stride`), and the `n`th `GS_EMIT` stores vertex `n` as the outputs
+//! and emits it; `GS_CUT` ends the strip. The driver's ring placement
+//! (`resource::DRIVER`, `s2`) drops out.
+
+use std::collections::{HashMap, HashSet};
+
+use super::super::bitcode::{Attr, V};
+use crate::gfx10::{Fields, Operand};
+use crate::ir::{Inst, Program, Reg, Value};
+
+/// `s_sendmsg` ids and operations (GFX10).
+const MSG_GS: u16 = 2;
+const MSG_GS_DONE: u16 = 3;
+const OP_CUT: u16 = 1;
+const OP_EMIT: u16 = 2;
+
+pub(super) struct Gs {
+    /// VGPR values holding a vertex's ES-GS ring offset in bytes, by vertex.
+    esgs: HashMap<Value, u32>,
+    /// VGPR values holding this primitive's GS-VS ring slot.
+    gsvs: HashSet<Value>,
+    /// Ring dwords per emitted vertex.
+    stride: u32,
+    /// GS-VS ring dwords written: (vertex, dword of the vertex) -> value.
+    staged: HashMap<(u32, u32), V>,
+    emitted: u32,
+}
+
+/// How many vertices the program emits at most (its `GS_EMIT` messages, the
+/// program having no loops around them; at least one).
+pub(super) fn emits(p: &Program) -> u32 {
+    let n = p
+        .blocks
+        .iter()
+        .flat_map(|b| &b.insts)
+        .filter(|i| i.name() == "s_sendmsg")
+        .filter(|i| matches!(i.fields, Fields::Sopp { imm } if imm & 0xF == MSG_GS && (imm >> 4) & 2 != 0))
+        .count() as u32;
+    n.max(1)
+}
+
+impl Gs {
+    /// The classification of `p`'s ring addresses; `outputs` registers set the
+    /// GS-VS stride (4 dwords a register).
+    pub(super) fn new(p: &Program, output_rows: u32) -> Gs {
+        let input = |v: Value| p.inputs.iter().find(|(_, x)| *x == v).map(|(r, _)| *r);
+        let mut consts: HashMap<Value, u32> = HashMap::new();
+        let mut esgs: HashMap<Value, u32> = HashMap::new();
+        let mut gsvs: HashSet<Value> = HashSet::new();
+        let num = |inst: &Inst, op: &Operand, consts: &HashMap<Value, u32>| -> Option<u32> {
+            match *op {
+                Operand::Const(c @ 128..=192) => Some(u32::from(c) - 128),
+                Operand::Literal(x) => Some(x),
+                Operand::Scalar { code, .. } => inst.read(Reg::S(code)).and_then(|v| consts.get(&v).copied()),
+                _ => None,
+            }
+        };
+        let vval = |inst: &Inst, op: &Operand| match *op {
+            Operand::Vector { reg, .. } => inst.read(Reg::V(reg)),
+            _ => None,
+        };
+        for inst in p.blocks.iter().flat_map(|b| &b.insts) {
+            let name = inst.name();
+            if let Fields::Sop { src, .. } = &inst.fields
+                && name == "s_mov_b32"
+                && let (Some(&(_, out)), Some(k)) = (inst.writes.first(), src.first().and_then(|s| num(inst, s, &consts)))
+            {
+                consts.insert(out, k);
+                continue;
+            }
+            let Fields::Valu(f) = &inst.fields else {
+                continue;
+            };
+            let Some(&(Reg::V(_), out)) = inst.writes.first() else {
+                continue;
+            };
+            match name {
+                // A vertex's offset: v0 low half (vertex 0), v0 high half
+                // (vertex 1), v1 low half (vertex 2), times 4.
+                "v_lshlrev_b32" if f.src.len() == 2 && num(inst, &f.src[0], &consts) == Some(2) => {
+                    let Some(v) = vval(inst, &f.src[1]) else { continue };
+                    let high = f.sdwa.is_some_and(|s| s.src_sel[1] == 5);
+                    let vertex = match input(v) {
+                        Some(Reg::V(0)) => Some(u32::from(high)),
+                        Some(Reg::V(1)) => Some(2 + u32::from(high)),
+                        _ => None,
+                    };
+                    if let Some(vertex) = vertex {
+                        esgs.insert(out, vertex);
+                    }
+                }
+                // Masked to the ring: the same vertex.
+                "v_and_b32" if f.src.len() == 2 => {
+                    for (a, m) in [(1, 0), (0, 1)] {
+                        if let (Some(v), Some(_)) = (vval(inst, &f.src[a]), num(inst, &f.src[m], &consts))
+                            && let Some(&vertex) = esgs.get(&v)
+                        {
+                            esgs.insert(out, vertex);
+                        }
+                    }
+                }
+                "v_mov_b32" => {
+                    if let Some(v) = f.src.first().and_then(|s| vval(inst, s)) {
+                        if let Some(&vertex) = esgs.get(&v) {
+                            esgs.insert(out, vertex);
+                        }
+                        if gsvs.contains(&v) {
+                            gsvs.insert(out);
+                        }
+                    }
+                }
+                // The primitive's slot: lane x slot bytes + the wave's base.
+                "v_mad_u32_u24" if f.src.first().and_then(|s| num(inst, s, &consts)).is_some_and(|k| k >= 16) => {
+                    gsvs.insert(out);
+                }
+                _ => {}
+            }
+        }
+        Gs {
+            esgs,
+            gsvs,
+            stride: 4 * output_rows.max(1),
+            staged: HashMap::new(),
+            emitted: 0,
+        }
+    }
+}
+
+impl<'a> super::Lower<'a> {
+    /// An LDS access of a geometry program; `Ok(false)` if it is no ring
+    /// access this module knows.
+    pub(super) fn gs_ds(&mut self, inst: &Inst, elements: &[(u32, u32)], dst: Option<u8>, data: &[Operand]) -> Result<bool, super::Why> {
+        let Some(gs) = self.gs.as_ref() else {
+            return Ok(false);
+        };
+        let Fields::Ds { addr: Some(Operand::Vector { reg, .. }), .. } = &inst.fields else {
+            return Ok(false);
+        };
+        let Some(a) = inst.read(Reg::V(*reg)) else {
+            return Ok(false);
+        };
+        let name = inst.name();
+        if name.starts_with("ds_read") {
+            let Some(&vertex) = gs.esgs.get(&a) else {
+                return Err("an LDS read in a geometry program that is no vertex's input");
+            };
+            let reg = dst.ok_or("an LDS read result")?;
+            let mut n = 0;
+            for &(off, w) in elements {
+                for k in 0..w {
+                    let byte = off + 4 * k;
+                    let x = self.gs_input(vertex, byte / 16, ((byte / 4) % 4) as u8);
+                    self.write(inst, Reg::V(reg + n), x, None);
+                    n += 1;
+                }
+            }
+            return Ok(true);
+        }
+        if name.starts_with("ds_write") {
+            if !gs.gsvs.contains(&a) {
+                return Err("an LDS write in a geometry program that is no emitted vertex");
+            }
+            let stride = gs.stride;
+            let mut staged = Vec::new();
+            for (e, &(off, w)) in elements.iter().enumerate() {
+                let vals = self.vgprs(inst, data.get(e).ok_or("an LDS write")?, w as u8)?;
+                for (k, x) in vals.into_iter().enumerate() {
+                    let dword = (off + 4 * k as u32) / 4;
+                    staged.push(((dword / stride, dword % stride), x));
+                }
+            }
+            let gs = self.gs.as_mut().expect("checked above");
+            gs.staged.extend(staged);
+            return Ok(true);
+        }
+        Err("an LDS operation in a geometry program")
+    }
+
+    /// Input register `row`, column `col` of `vertex`, as an i32 (zero where
+    /// the signature has no such column).
+    fn gs_input(&mut self, vertex: u32, row: u32, col: u8) -> V {
+        let found = self.s.inputs.iter().enumerate().find_map(|(id, e)| {
+            (e.row == Some(row) && col >= e.col && col < e.col + e.cols).then_some((id, col - e.col, e.comp == 9))
+        });
+        let Some((id, col, float)) = found else {
+            return self.s.m.i32(0);
+        };
+        let (name, ty) = if float { ("loadInput.f32", self.s.t.f32) } else { ("loadInput.i32", self.s.t.i32) };
+        let args = [self.s.m.i32(id as u32), self.s.m.i32(0), self.s.m.i8(col), self.s.m.i32(vertex)];
+        let x = self.s.op(self.cur, name, Attr::ReadNone, ty, 4, &args);
+        if float { self.as_int(x) } else { x }
+    }
+
+    /// `s_sendmsg` in a geometry program: `Ok(false)` if not a GS message.
+    pub(super) fn gs_msg(&mut self, imm: u16, guarded: bool) -> Result<bool, super::Why> {
+        if self.gs.is_none() {
+            return Ok(false);
+        }
+        let (msg, op) = (imm & 0xF, (imm >> 4) & 3);
+        if msg == MSG_GS_DONE {
+            return Ok(true);
+        }
+        if msg != MSG_GS {
+            return Ok(false);
+        }
+        if guarded {
+            return Err("a geometry emit where not every lane runs");
+        }
+        let stream = self.s.m.i8(((imm >> 8) & 3) as u8);
+        let void = self.s.t.void;
+        if op & OP_EMIT != 0 {
+            let gs = self.gs.as_mut().expect("checked above");
+            let n = gs.emitted;
+            gs.emitted += 1;
+            let outputs: Vec<(usize, u32, u8, u8, bool)> = self
+                .s
+                .outputs
+                .iter()
+                .enumerate()
+                .filter_map(|(id, e)| Some((id, e.row?, e.col, e.cols, e.comp == 9)))
+                .collect();
+            for (id, row, col0, cols, float) in outputs {
+                for c in 0..cols {
+                    let dword = row * 4 + u32::from(col0 + c);
+                    let staged = self.gs.as_ref().and_then(|g| g.staged.get(&(n, dword)).copied());
+                    let x = staged.unwrap_or_else(|| self.s.m.i32(0));
+                    let (name, x) = if float { ("storeOutput.f32", self.as_float(x)) } else { ("storeOutput.i32", x) };
+                    let args = [self.s.m.i32(id as u32), self.s.m.i32(0), self.s.m.i8(c), x];
+                    self.s.op(self.cur, name, Attr::NoUnwind, void, 5, &args);
+                }
+            }
+            self.s.op(self.cur, "emitStream", Attr::NoUnwind, void, 97, &[stream]);
+        }
+        if op & OP_CUT != 0 {
+            self.s.op(self.cur, "cutStream", Attr::NoUnwind, void, 98, &[stream]);
+        }
+        Ok(true)
+    }
+}
+
+impl<'a> super::Lower<'a> {
+    /// `s_sendmsg` at block `b`, instruction `i` of a geometry program.
+    pub(super) fn gs_sendmsg(&mut self, imm: u16, b: usize, i: usize) -> Result<(), super::Why> {
+        let guarded = self.guard(b, i)?.is_some();
+        self.gs_msg(imm, guarded).map(|_| ())
+    }
+}
