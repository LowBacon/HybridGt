+    /// nothing.
+    fn significand_f32(&mut self, bits: V) -> (V, V, V) {
+        let c = self.cur;
+        let k = |l: &mut Self, v: u32| l.s.m.i32(v);
+        let e = {
+            let f = self.as_float(bits);
