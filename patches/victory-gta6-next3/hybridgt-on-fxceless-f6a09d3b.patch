+            .unwrap_or_else(|e| panic!("dispatch failed: {e}"));
+        for t in 0..64u32 {
+            assert_eq!(out[0][t as usize], s0 + ((t + 32) & 63), "lane {t}, s0 {s0:#x}");
+        }
+    }
+    eprintln!("ran on the hardware device: every lane's read 32 lanes on, across both host waves");
+}
