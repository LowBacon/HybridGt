+        let next_b = s.m.bin(body, Bin::Add, acc, two);
+        s.m.set_phi(
+            acc,
+            vec![(zero, entry), (next_a, latch_a), (next_b, latch_b)],
+        );
+
+        s.m.terminate(exit, Term::Ret);
+        s
+    }
