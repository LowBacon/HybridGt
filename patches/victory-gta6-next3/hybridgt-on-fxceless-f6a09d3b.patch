+//! HybridGt: more of `host.rs` (the repository's file-size policy): the card copies' chunks and
+//! the switches of the copy queue's fetches.
+
+use super::*;
+
+
+/// A scratch chunk of `size` bytes or more: one kept ([`SPARE`]) or a new
+/// one; and its size.
+///
+/// A small first chunk ([`SCRATCH_FIRST`]) asked for while none of them is
+/// kept is a kept 4 MiB one. Without that, on an RTX 5080 (Jason's balcony,
+/// Series S) the spares sat at their bound the whole time, all of them
+/// 4 MiB ones, while some 35 small first chunks a frame were made new and
+/// as many came back past the bound and were freed (about 1 ms each, a
+/// committed upload buffer).
+pub(super) fn take_chunk(host: &Host, size: u64) -> Option<(Chunk, u64)> {
+    if scratch_pool() {
+        let mut spare = SPARE.lock().unwrap_or_else(|e| e.into_inner());
+        let kept = spare.take(size).map(|c| (c, size)).or_else(|| {
+            let any = size == SCRATCH_FIRST && scratch_any_size();
+            any.then(|| spare.take(SCRATCH_CHUNK).map(|c| (c, SCRATCH_CHUNK))).flatten()
+        });
+        if let Some((chunk, size)) = kept {
+            ALIVE[3].fetch_sub(1, Ordering::Relaxed);
+            ALIVE[4].fetch_sub(size, Ordering::Relaxed);
+            ALIVE[5].fetch_add(1, Ordering::Relaxed);
+            return Some((chunk, size));
+        }
+    }
+    // HybridGt: with `VICTORY_GPU_FILLS=1` scratch is memory the card can
+    // write too ([`gpu_fills_on`]): a fill may then be done on the card.
+    let (buffer, data) = if gpu_fills_on() { host.shared_buffer(size)? } else { host.upload_buffer(size)? };
+    name(&buffer, || "list scratch".into());
+    // SAFETY: a live buffer.
+    let gpu = unsafe { buffer.GetGPUVirtualAddress() };
+    ALIVE[1].fetch_add(1, Ordering::Relaxed);
+    ALIVE[2].fetch_add(size, Ordering::Relaxed);
+    let chunk = Chunk {
+        _buffer: buffer,
+        data: data as usize,
+        gpu,
+    };
+    Some((chunk, size))
+}
+
+/// HybridGt: whether the relay fetches flagged pieces on a copy queue of its
+/// own (`VICTORY_FETCH_COPY_QUEUE=1`; off by default).
+///
+/// On the host's queue a fetch waited behind every flight sent meanwhile:
+/// 100-170 ms a frame for 5-8 fetches (runs next12-next15), the frame's
+/// pace once the submitting thread no longer waited. The flights a fetch
+/// lands have run when it is made (the relay waited for their fence), so on
+/// a copy queue it runs at once. What it may then see of the card: every
+/// send numbered up to the newest of the landed plans' sends (those ran
+/// ahead of the landed flights' lists), and possibly later sends and later
+/// flights' bytes. The merge is told the landed plans' newest send as the
+/// fetch's "after", so later sends are skipped as unseen (they are the
+/// title's bytes, already on the CPU's side); later flights' bytes may be
+/// merged early, which the relay accepts already (see
+/// [`Host::relay_card_back`]). The copy queue reads the card's buffers
+/// while the host's queue may run shaders on them: outside D3D12's rules
+/// for buffers used on two queues, so it stays a switch until measured.
+pub(super) fn fetch_copy_queue_on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_FETCH_COPY_QUEUE").is_some_and(|v| v == "1"))
+}
+
+/// HybridGt: whether fills of scratch memory that would wait for flights are
+/// done on the card (`VICTORY_GPU_FILLS=1`, with [`gpu_buffer_copies_on`]):
+/// a constant buffer the title's shaders wrote and a draw then reads at an
+/// address the host cannot bind as it is (copied to scratch). Scratch chunks
+/// are then shared memory, which the card can write.
+pub(super) fn gpu_fills_on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| gpu_buffer_copies_on() && std::env::var_os("VICTORY_GPU_FILLS").is_some_and(|v| v == "1"))
+}
+
+/// HybridGt: whether title buffer copies that would wait for flights are done
+/// on the card instead (`VICTORY_GPU_BUFFER_COPIES=1`; off by default).
+pub(super) fn gpu_buffer_copies_on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| relay() && std::env::var_os("VICTORY_GPU_BUFFER_COPIES").is_some_and(|v| v == "1"))
+}
