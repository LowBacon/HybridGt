+    sent: u64,
+    runs: Vec<(usize, usize)>,
+    sorted: bool,
+    longest: usize,
+}
+
+impl MergeBatch {
+    fn sort(&mut self) {
+        if !self.sorted {
+            self.runs.sort_unstable();
+            self.sorted = true;
+        }
+    }
+}
+
+impl MergeLog {
