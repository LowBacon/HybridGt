+//! HybridGt: a program's exports (positions, parameters, colours, depth), out of `lower.rs`
+//! (the repository's file-size policy).
+
+use super::*;
+
+impl<'a> Lower<'a> {
+    pub(super) fn export(&mut self, b: usize, i: usize) -> Result<(), Why> {
+        let e = *self
+            .exports
+            .get(&(b, i))
+            .ok_or("an export I/O raising did not see")?;
+        if e.compressed {
+            return Err("a compressed export");
+        }
+        let guard = self.guard(b, i)?;
+        let mesh = self.s.mesh.is_some();
+        let c = self.cur;
+        if let Some(g) = guard
+            && !mesh
+        {
+            if !(e.done && self.s.pixel) {
+                return Err("a conditional export");
+            }
+            let t = self.s.m.bool(true);
+            let kill = self.s.m.bin(c, Bin::Xor, g, t);
+            self.s
+                .op(c, "discard", Attr::NoUnwind, self.s.t.void, 82, &[kill]);
+        }
+        if mesh && e.target == Target::Primitive {
+            return self.emit_indices(e, guard);
+        }
+        let param_row = |usage: Usage, row: u8| match usage {
+            // The 2020 compiler leaves a mesh program's first entry zeroed
+            // (usage "position"): its row is the one no other entry names.
+            Usage::Other(0) if mesh => self.unnamed_row(),
+            _ => Some(row),
+        };
+        // (output element, channel) per exported channel; per-primitive
+        // outputs are elements of `prims`.
+        let mut stores = Vec::new();
+        let primitive = matches!(e.target, Target::PrimitiveParam { .. });
+        let outputs = if primitive {
+            &self.s.prims
+        } else {
+            &self.s.outputs
+        };
+        let by_kind = |kind: u8| outputs.iter().position(|o| o.kind == kind);
+        // 16-bit vertex outputs: the halves each dword carries, as (output
+        // element, channel, high half) per channel.
+        let halves = match e.target {
+            Target::Param { usage, row } => {
+                param_row(usage, row).and_then(|r| self.half_outputs.get(&r).map(|&h| (r, h)))
+            }
+            _ => None,
+        };
+        if let Some((row, (pack2, _))) = halves {
+            let packs: Vec<(u8, Option<u8>)> = self
+                .half_outputs
+                .iter()
+                .filter(|(_, h)| h.0)
+                .map(|(&r, h)| (r, h.1))
+                .collect();
+            for ch in 0..4u8 {
+                let Some(value) = e.values[usize::from(ch)] else {
+                    continue;
+                };
+                for high in [false, true] {
+                    let h = 2 * ch + u8::from(high);
+                    let src = if pack2 {
+                        packed_half(outputs, &packs, row, h)
+                    } else {
+                        (!high).then_some((row, ch))
+                    };
+                    let found = src.and_then(|(r, c)| {
+                        outputs.iter().position(|o| {
+                            o.row == Some(u32::from(r)) && c >= o.col && c < o.col + o.cols
+                        })
+                    });
+                    if let Some(id) = found {
+                        let col = src.expect("found").1 - outputs[id].col;
+                        stores.push((id, col, value, Some(high)));
+                    }
+                }
+            }
+        }
+        for ch in 0..4u8 {
+            let Some(value) = e.values[usize::from(ch)] else {
+                continue;
+            };
+            if halves.is_some() {
+                break;
+            }
+            let found = match e.target {
+                Target::Color(n) => outputs
+                    .iter()
+                    .position(|o| o.kind == 16 && o.row == Some(u32::from(n)))
+                    .map(|id| (id, ch)),
+                Target::Position(0) => by_kind(3).map(|id| (id, ch)),
+                Target::Depth => match ch {
+                    0 => by_kind(17)
+                        .or(by_kind(18))
+                        .or(by_kind(19))
+                        .map(|id| (id, 0)),
+                    1 => by_kind(20).map(|id| (id, 0)),
+                    2 => by_kind(14).map(|id| (id, 0)),
+                    _ => None,
+                },
+                Target::Param { usage, row } | Target::PrimitiveParam { usage, row } => {
+                    let row = param_row(usage, row);
+                    outputs
+                        .iter()
+                        .position(|o| {
+                            row.is_some_and(|r| o.row == Some(u32::from(r)))
+                                && ch >= o.col
+                                && ch < o.col + o.cols
+                        })
+                        .map(|id| (id, ch - outputs[id].col))
+                }
+                Target::Null | Target::Unread => None,
+                Target::Position(n @ 1..=2) => {
+                    // shortcut: without the misc vector (point size, render
+                    // target or viewport index) pos1 and pos2 carry the clip
+                    // then cull distances, in semantic order.
+                    if outputs.iter().any(|o| matches!(o.kind, 4 | 5)) {
+                        return Err("render-target or viewport index exports");
+                    }
+                    let mut dists: Vec<usize> = (0..outputs.len())
+                        .filter(|&i| matches!(outputs[i].kind, 6 | 7))
+                        .collect();
+                    dists.sort_by_key(|&i| (outputs[i].kind, outputs[i].index));
+                    let flat: Vec<(usize, u8)> = dists
+                        .iter()
+                        .flat_map(|&i| (0..outputs[i].cols).map(move |c| (i, c)))
+                        .collect();
+                    // Channels past the distances the signature declares are
+                    // ones the clipper does not enable (`PA_CL_VS_OUT_CNTL`).
+                    let k = usize::from(n - 1) * 4 + usize::from(ch);
+                    flat.get(k).copied()
+                }
+                Target::Position(_) => return Err("clip, cull or point-size exports"),
+                Target::Primitive => return Err("a primitive export"),
+            };
+            if let Some((id, col)) = found {
+                stores.push((id, col, value, None));
+            }
+        }
+        fn elements<'l>(l: &'l mut Lower, primitive: bool) -> &'l mut Vec<SigElement> {
+            if primitive {
+                &mut l.s.prims
+            } else {
+                &mut l.s.outputs
+            }
+        }
+        if stores
+            .iter()
+            .any(|s| s.3.is_none() && elements(self, primitive)[s.0].half)
+        {
+            return Err("a 16-bit output the stage data does not mark");
+        }
+        // A mesh lane writes its own vertex or primitive, where it exports.
+        let at = if mesh {
+            let flat = self.mesh_thread();
+            let limit = if let Some(m) = self.s.mesh {
+                if primitive {
+                    m.max_primitives
+                } else {
+                    m.max_vertices
+                }
+            } else {
+                0
+            };
+            let threads = self.s.threads.map(|t| t[0]).unwrap_or(u32::MAX);
+            let mesh_guard = if limit > 0 && threads > limit {
+                let lim = self.s.m.i32(limit);
+                let in_bounds = self.s.m.cmp(self.cur, pred::IULT, flat, lim);
+                match guard {
+                    Some(g) => Some(self.s.m.bin(self.cur, Bin::And, g, in_bounds)),
+                    None => Some(in_bounds),
+                }
+            } else {
+                guard
+            };
+            self.begin_guarded(mesh_guard)
+        } else {
+            None
+        };
+        let (name, opcode) = match (mesh, primitive) {
+            (false, _) => ("storeOutput", 5),
+            (true, false) => ("storeVertexOutput", 171),
+            (true, true) => ("storePrimitiveOutput", 172),
+        };
+        for (id, col, value, half) in stores {
+            let mut x = self.i32_of(value)?;
+            if let Some(high) = half {
+                // An f16 half, declared a 32-bit float on the host.
+                let c = self.cur;
+                if high {
+                    let k16 = self.s.m.i32(16);
+                    x = self.s.m.bin(c, Bin::LShr, x, k16);
+                }
+                let f32t = self.s.t.f32;
+                let f = self
+                    .s
+                    .op(c, "legacyF16ToF32", Attr::ReadNone, f32t, 131, &[x]);
+                x = self.as_int(f);
+            }
+            let el = &mut elements(self, primitive)[id];
+            el.usage |= 1 << col;
+            let (suffix, x) = match el.comp {
+                9 if half.is_some() => (".f32", self.as_float(x)),
+                9 => {
+                    let f = match self.floats.get(&value) {
+                        Some(&f) => f,
+                        None => self.as_float(x),
+                    };
+                    (".f32", f)
+                }
+                _ => (".i32", x),
+            };
+            let mut args = vec![
+                self.s.m.i32(id as u32),
+                self.s.m.i32(0),
+                self.s.m.i8(col),
+                x,
+            ];
+            if mesh {
+                args.push(self.mesh_thread());
+            }
+            let void = self.s.t.void;
+            self.s.op(
+                self.cur,
+                &format!("{name}{suffix}"),
+                Attr::NoUnwind,
+                void,
+                opcode,
+                &args,
+            );
+        }
+        self.end_guarded(at, &[]);
+        Ok(())
+    }
+}
diff --git a/crates/victory-shader/src/emit/lower/gs.rs b/crates/victory-shader/src/emit/lower/gs.rs
new file mode 100644
index 00000000..9d471a69
--- /dev/null
+++ b/crates/victory-shader/src/emit/lower/gs.rs
@@ -0,0 +1,261 @@
+//! HybridGt: legacy (non-NGG) GFX10 geometry programs as host geometry
+//! shaders.
+//!
+//! On the console the geometry program reads its primitive's vertices from
+//! the ES-GS ring in LDS, at byte offsets the hardware passes packed in `v0`
+//! (vertices 0 and 1, low and high halves) and `v1` (vertex 2), and writes
+//! each vertex it emits to the GS-VS ring at its own slot, then sends
+//! `GS_EMIT`; a copy shader the driver makes reads the ring and exports.
+//! Ring dword `k` of a vertex is signature register `k / 4`, column `k % 4`
+//! (the title's `ISG1`/`OSG1` rows; seen in `GS_VoxelizeGeneric`: 5 output
+//! registers, 20 dwords a vertex).
+//!
+//! Here: ES-GS reads at a vertex's offset become `loadInput` of that vertex;
+//! GS-VS writes are kept per vertex (dword `d` of the slot is vertex
+//! `d / stride`), and the `n`th `GS_EMIT` stores vertex `n` as the outputs
+//! and emits it; `GS_CUT` ends the strip. The driver's ring placement
+//! (`resource::DRIVER`, `s2`) drops out.
+
+use std::collections::{HashMap, HashSet};
+
+use super::super::bitcode::{Attr, V};
+use crate::gfx10::{Fields, Operand};
+use crate::ir::{Inst, Program, Reg, Value};
+
+/// `s_sendmsg` ids and operations (GFX10).
+const MSG_GS: u16 = 2;
+const MSG_GS_DONE: u16 = 3;
+const OP_CUT: u16 = 1;
+const OP_EMIT: u16 = 2;
+
+pub(super) struct Gs {
+    /// VGPR values holding a vertex's ES-GS ring offset in bytes, by vertex.
+    esgs: HashMap<Value, u32>,
+    /// VGPR values holding this primitive's GS-VS ring slot.
+    gsvs: HashSet<Value>,
+    /// Ring dwords per emitted vertex.
+    stride: u32,
+    /// GS-VS ring dwords written: (vertex, dword of the vertex) -> value.
+    staged: HashMap<(u32, u32), V>,
+    emitted: u32,
+}
+
+/// How many vertices the program emits at most (its `GS_EMIT` messages, the
+/// program having no loops around them; at least one).
+pub(super) fn emits(p: &Program) -> u32 {
+    let n = p
+        .blocks
+        .iter()
+        .flat_map(|b| &b.insts)
+        .filter(|i| i.name() == "s_sendmsg")
+        .filter(|i| matches!(i.fields, Fields::Sopp { imm } if imm & 0xF == MSG_GS && (imm >> 4) & 2 != 0))
+        .count() as u32;
+    n.max(1)
+}
+
+impl Gs {
+    /// The classification of `p`'s ring addresses; `outputs` registers set the
+    /// GS-VS stride (4 dwords a register).
+    pub(super) fn new(p: &Program, output_rows: u32) -> Gs {
+        let input = |v: Value| p.inputs.iter().find(|(_, x)| *x == v).map(|(r, _)| *r);
+        let mut consts: HashMap<Value, u32> = HashMap::new();
+        let mut esgs: HashMap<Value, u32> = HashMap::new();
+        let mut gsvs: HashSet<Value> = HashSet::new();
+        let num = |inst: &Inst, op: &Operand, consts: &HashMap<Value, u32>| -> Option<u32> {
+            match *op {
+                Operand::Const(c @ 128..=192) => Some(u32::from(c) - 128),
+                Operand::Literal(x) => Some(x),
+                Operand::Scalar { code, .. } => inst.read(Reg::S(code)).and_then(|v| consts.get(&v).copied()),
+                _ => None,
+            }
+        };
+        let vval = |inst: &Inst, op: &Operand| match *op {
+            Operand::Vector { reg, .. } => inst.read(Reg::V(reg)),
+            _ => None,
+        };
+        for inst in p.blocks.iter().flat_map(|b| &b.insts) {
+            let name = inst.name();
+            if let Fields::Sop { src, .. } = &inst.fields
+                && name == "s_mov_b32"
+                && let (Some(&(_, out)), Some(k)) = (inst.writes.first(), src.first().and_then(|s| num(inst, s, &consts)))
+            {
+                consts.insert(out, k);
+                continue;
+            }
+            let Fields::Valu(f) = &inst.fields else {
+                continue;
+            };
+            let Some(&(Reg::V(_), out)) = inst.writes.first() else {
+                continue;
+            };
+            match name {
+                // A vertex's offset: v0 low half (vertex 0), v0 high half
+                // (vertex 1), v1 low half (vertex 2), times 4.
+                "v_lshlrev_b32" if f.src.len() == 2 && num(inst, &f.src[0], &consts) == Some(2) => {
+                    let Some(v) = vval(inst, &f.src[1]) else { continue };
+                    let high = f.sdwa.is_some_and(|s| s.src_sel[1] == 5);
+                    let vertex = match input(v) {
+                        Some(Reg::V(0)) => Some(u32::from(high)),
+                        Some(Reg::V(1)) => Some(2 + u32::from(high)),
+                        _ => None,
+                    };
+                    if let Some(vertex) = vertex {
+                        esgs.insert(out, vertex);
+                    }
+                }
+                // Masked to the ring: the same vertex.
+                "v_and_b32" if f.src.len() == 2 => {
+                    for (a, m) in [(1, 0), (0, 1)] {
+                        if let (Some(v), Some(_)) = (vval(inst, &f.src[a]), num(inst, &f.src[m], &consts))
+                            && let Some(&vertex) = esgs.get(&v)
+                        {
+                            esgs.insert(out, vertex);
+                        }
+                    }
+                }
+                "v_mov_b32" => {
+                    if let Some(v) = f.src.first().and_then(|s| vval(inst, s)) {
+                        if let Some(&vertex) = esgs.get(&v) {
+                            esgs.insert(out, vertex);
+                        }
+                        if gsvs.contains(&v) {
+                            gsvs.insert(out);
+                        }
+                    }
+                }
+                // The primitive's slot: lane x slot bytes + the wave's base.
+                "v_mad_u32_u24" if f.src.first().and_then(|s| num(inst, s, &consts)).is_some_and(|k| k >= 16) => {
+                    gsvs.insert(out);
+                }
+                _ => {}
+            }
+        }
+        Gs {
+            esgs,
+            gsvs,
+            stride: 4 * output_rows.max(1),
+            staged: HashMap::new(),
+            emitted: 0,
+        }
+    }
+}
+
+impl<'a> super::Lower<'a> {
+    /// An LDS access of a geometry program; `Ok(false)` if it is no ring
+    /// access this module knows.
+    pub(super) fn gs_ds(&mut self, inst: &Inst, elements: &[(u32, u32)], dst: Option<u8>, data: &[Operand]) -> Result<bool, super::Why> {
+        let Some(gs) = self.gs.as_ref() else {
+            return Ok(false);
+        };
+        let Fields::Ds { addr: Some(Operand::Vector { reg, .. }), .. } = &inst.fields else {
+            return Ok(false);
+        };
+        let Some(a) = inst.read(Reg::V(*reg)) else {
+            return Ok(false);
+        };
+        let name = inst.name();
+        if name.starts_with("ds_read") {
+            let Some(&vertex) = gs.esgs.get(&a) else {
+                return Err("an LDS read in a geometry program that is no vertex's input");
+            };
+            let reg = dst.ok_or("an LDS read result")?;
+            let mut n = 0;
+            for &(off, w) in elements {
+                for k in 0..w {
+                    let byte = off + 4 * k;
+                    let x = self.gs_input(vertex, byte / 16, ((byte / 4) % 4) as u8);
+                    self.write(inst, Reg::V(reg + n), x, None);
+                    n += 1;
+                }
+            }
+            return Ok(true);
+        }
+        if name.starts_with("ds_write") {
+            if !gs.gsvs.contains(&a) {
+                return Err("an LDS write in a geometry program that is no emitted vertex");
+            }
+            let stride = gs.stride;
+            let mut staged = Vec::new();
+            for (e, &(off, w)) in elements.iter().enumerate() {
+                let vals = self.vgprs(inst, data.get(e).ok_or("an LDS write")?, w as u8)?;
+                for (k, x) in vals.into_iter().enumerate() {
+                    let dword = (off + 4 * k as u32) / 4;
+                    staged.push(((dword / stride, dword % stride), x));
+                }
+            }
+            let gs = self.gs.as_mut().expect("checked above");
+            gs.staged.extend(staged);
+            return Ok(true);
+        }
+        Err("an LDS operation in a geometry program")
+    }
+
+    /// Input register `row`, column `col` of `vertex`, as an i32 (zero where
+    /// the signature has no such column).
+    fn gs_input(&mut self, vertex: u32, row: u32, col: u8) -> V {
+        let found = self.s.inputs.iter().enumerate().find_map(|(id, e)| {
+            (e.row == Some(row) && col >= e.col && col < e.col + e.cols).then_some((id, col - e.col, e.comp == 9))
+        });
+        let Some((id, col, float)) = found else {
+            return self.s.m.i32(0);
+        };
+        let (name, ty) = if float { ("loadInput.f32", self.s.t.f32) } else { ("loadInput.i32", self.s.t.i32) };
+        let args = [self.s.m.i32(id as u32), self.s.m.i32(0), self.s.m.i8(col), self.s.m.i32(vertex)];
+        let x = self.s.op(self.cur, name, Attr::ReadNone, ty, 4, &args);
+        if float { self.as_int(x) } else { x }
+    }
+
+    /// `s_sendmsg` in a geometry program: `Ok(false)` if not a GS message.
+    pub(super) fn gs_msg(&mut self, imm: u16, guarded: bool) -> Result<bool, super::Why> {
+        if self.gs.is_none() {
+            return Ok(false);
+        }
+        let (msg, op) = (imm & 0xF, (imm >> 4) & 3);
+        if msg == MSG_GS_DONE {
+            return Ok(true);
+        }
+        if msg != MSG_GS {
+            return Ok(false);
+        }
+        if guarded {
+            return Err("a geometry emit where not every lane runs");
+        }
+        let stream = self.s.m.i8(((imm >> 8) & 3) as u8);
+        let void = self.s.t.void;
+        if op & OP_EMIT != 0 {
+            let gs = self.gs.as_mut().expect("checked above");
+            let n = gs.emitted;
+            gs.emitted += 1;
+            let outputs: Vec<(usize, u32, u8, u8, bool)> = self
+                .s
+                .outputs
+                .iter()
+                .enumerate()
+                .filter_map(|(id, e)| Some((id, e.row?, e.col, e.cols, e.comp == 9)))
+                .collect();
+            for (id, row, col0, cols, float) in outputs {
+                for c in 0..cols {
+                    let dword = row * 4 + u32::from(col0 + c);
+                    let staged = self.gs.as_ref().and_then(|g| g.staged.get(&(n, dword)).copied());
+                    let x = staged.unwrap_or_else(|| self.s.m.i32(0));
+                    let (name, x) = if float { ("storeOutput.f32", self.as_float(x)) } else { ("storeOutput.i32", x) };
+                    let args = [self.s.m.i32(id as u32), self.s.m.i32(0), self.s.m.i8(c), x];
+                    self.s.op(self.cur, name, Attr::NoUnwind, void, 5, &args);
+                }
+            }
+            self.s.op(self.cur, "emitStream", Attr::NoUnwind, void, 97, &[stream]);
+        }
+        if op & OP_CUT != 0 {
+            self.s.op(self.cur, "cutStream", Attr::NoUnwind, void, 98, &[stream]);
+        }
+        Ok(true)
+    }
+}
+
+impl<'a> super::Lower<'a> {
+    /// `s_sendmsg` at block `b`, instruction `i` of a geometry program.
+    pub(super) fn gs_sendmsg(&mut self, imm: u16, b: usize, i: usize) -> Result<(), super::Why> {
+        let guarded = self.guard(b, i)?.is_some();
+        self.gs_msg(imm, guarded).map(|_| ())
+    }
+}
diff --git a/crates/victory-shader/src/emit/lower/layout.rs b/crates/victory-shader/src/emit/lower/layout.rs
new file mode 100644
index 00000000..6e69edf5
--- /dev/null
+++ b/crates/victory-shader/src/emit/lower/layout.rs
@@ -0,0 +1,45 @@
+//! HybridGt: how outputs and inputs pack into signature rows, and typed buffer formats, out
+//! of `lower.rs` (the repository's file-size policy).
+
+use super::*;
+
+/// A GFX10 buffer format (the unified format of typed buffer loads): the
+/// channel widths from the lowest bits up, and how the channels convert.
+/// Formats are numbered in families (`8`, `16`, `8_8`, ...: AMD names
+/// list channels from the highest bits), each with its numeric formats in
+/// the order unorm, snorm, uscaled, sscaled, uint, sint, float.
+pub(super) fn buffer_format(format: u8) -> Option<(&'static [u32], Numeric)> {
+    use Numeric::*;
+    const NORM: &[Numeric] = &[Unorm, Snorm, Uscaled, Sscaled, Uint, Sint];
+    const ALL: &[Numeric] = &[Unorm, Snorm, Uscaled, Sscaled, Uint, Sint, Float];
+    const WIDE: &[Numeric] = &[Uint, Sint, Float];
+    // Numbers and order from LLVM's `UfmtGFX10` (`SIDefines.h`); the GFX10
+    // buffer formats have no 5_9_9_9. Channel order from Mesa
+    // (`ac_formats.c`): R11G11B10_FLOAT is 10_11_11, and 10_10_10_2 has
+    // its 2-bit channel in the lowest bits.
+    const FAMILIES: [(&[u32], &[Numeric]); 14] = [
+        (&[8], NORM),
+        (&[16], ALL),
+        (&[8, 8], NORM),
+        (&[32], WIDE),
+        (&[16, 16], ALL),
+        (&[11, 11, 10], ALL),     // 10_11_11
+        (&[10, 11, 11], ALL),     // 11_11_10
+        (&[2, 10, 10, 10], NORM), // 10_10_10_2
+        (&[10, 10, 10, 2], NORM), // 2_10_10_10
+        (&[8, 8, 8, 8], NORM),
+        (&[32, 32], WIDE),
+        (&[16, 16, 16, 16], ALL),
+        (&[32, 32, 32], WIDE),
+        (&[32, 32, 32, 32], WIDE),
+    ];
+    let mut n = usize::from(format.checked_sub(1)?);
+    for (bits, numerics) in FAMILIES {
+        if n < numerics.len() {
+            return Some((bits, numerics[n]));
+        }
+        n -= numerics.len();
+    }
+    None
+}
+
diff --git a/crates/victory-shader/src/emit/lower/ops.rs b/crates/victory-shader/src/emit/lower/ops.rs
new file mode 100644
index 00000000..616ad635
--- /dev/null
+++ b/crates/victory-shader/src/emit/lower/ops.rs
@@ -0,0 +1,926 @@
+//! HybridGt: a program's scalar (SOP) and LDS (DS) instructions, out of `lower.rs` (the
+//! repository's file-size policy). Moved, not changed.
+
+use super::*;
+
+impl<'a> Lower<'a> {
+    /// LDS (thread-group shared memory) and `ds_swizzle`.
+    pub(super) fn ds(&mut self, inst: &Inst, b: usize, i: usize) -> Result<(), Why> {
+        let Fields::Ds {
+            dst,
+            addr,
+            data,
+            offset0,
+            offset1,
+            gds,
+        } = &inst.fields
+        else {
+            unreachable!()
+        };
+        if *gds {
+            return Err("GDS");
+        }
+        let name = inst.name();
+        // Lanes past a DispatchX count neither read nor write LDS; a
+        // swizzle or permute moves registers only, under its own guard.
+        let guard = if name == "ds_swizzle_b32" || name.contains("permute") {
+            self.guard(b, i)?
+        } else {
+            self.effect_guard(b, i)?
+        };
+        let c = self.cur;
+        let offset = u32::from(*offset0) | u32::from(*offset1) << 8;
+        let dst_reg = match dst {
+            Some(Operand::Vector { reg, .. }) => Some(*reg),
+            _ => None,
+        };
+        if name == "ds_swizzle_b32" {
+            // Bit 15 set: each lane of a quad picks a lane of it; else lanes
+            // of each group of 32 combine their index with and/or/xor masks.
+            let quad = offset & 0x8000 != 0
+                || offset & 0x1C == 0x1C && offset & 0x380 == 0 && offset >> 10 & 0x1F < 4;
+            // Mesh: host quads are threads 4n..4n+3 of a 1D group, as the
+            // console's, so quad-local swizzles read through quad operations.
+            let mesh_quad = self.s.mesh.is_some() && quad;
+            if !mesh_quad {
+                self.cross_lane(quad)?;
+            }
+            // The source sits in the address field.
+            let x = self.vgprs(inst, addr.as_ref().ok_or("a swizzle source")?, 1)?[0];
+            let lane = self.lane_index();
+            let k = |l: &mut Self, v: u32| l.s.m.i32(v);
+            let src = if offset & 0x8000 != 0 {
+                let (three, one) = (k(self, 3), k(self, 1));
+                let sel = self.s.m.bin(c, Bin::And, lane, three);
+                let sh = self.s.m.bin(c, Bin::Shl, sel, one);
+                let pattern = k(self, offset & 0xFF);
+                let pick = self.s.m.bin(c, Bin::LShr, pattern, sh);
+                let pick = self.s.m.bin(c, Bin::And, pick, three);
+                let not3 = k(self, !3);
+                let base = self.s.m.bin(c, Bin::And, lane, not3);
+                self.s.m.bin(c, Bin::Or, base, pick)
+            } else {
+                let and = k(self, offset & 0x1F | !0x1F);
+                let or = k(self, offset >> 5 & 0x1F);
+                let xor = k(self, offset >> 10 & 0x1F);
+                let t = self.s.m.bin(c, Bin::And, lane, and);
+                let t = self.s.m.bin(c, Bin::Or, t, or);
+                self.s.m.bin(c, Bin::Xor, t, xor)
+            };
+            let r = if quad {
+                // lane q of a quad reads lane pattern[q] of it
+                let pattern = if offset & 0x8000 != 0 {
+                    [0, 1, 2, 3].map(|q| offset >> (2 * q) & 3)
+                } else {
+                    let (and, or, xor) = (offset & 0x1F, offset >> 5 & 0x1F, offset >> 10 & 0x1F);
+                    [0, 1, 2, 3].map(|q| ((q & and) | or) ^ xor)
+                };
+                self.quad_read(x, src, pattern)
+            } else {
+                self.read_lane(x, src)
+            };
+            let reg = dst_reg.ok_or("a swizzle result")?;
+            self.write(inst, Reg::V(reg), r, guard);
+            return Ok(());
+        }
+        if name == "ds_bpermute_b32" {
+            // Backward permute: no LDS is touched. Each lane takes the data
+            // register of the lane its address names, (address + offset) / 4,
+            // within its own 32-lane half: GFX10 permutes the two halves of a
+            // wave of 64 on their own (RDNA ISA; LLVM's
+            // `supportsWaveWideBPermute` is false for wave64 from GFX10 on,
+            // and Mesa ACO's `emit_bpermute` emulates a wave-wide one). So
+            // lane l reads lane (l & 32) | (that & 31): in the same host wave
+            // on a host of 32 lanes too, where each host wave is one half of
+            // the console's (from Belobug PR #363). A source lane outside EXEC
+            // gives 0. (The title's checkerboard shadow-mask
+            // generators read their neighbours' samples with it; without them
+            // every shadowed light was multiplied by an empty mask.)
+            // shortcut: a source lane that is not at this instruction on the
+            // host (it left through a branch, not a guard) is read as the
+            // host gives it; the console reads 0.
+            self.cross_lane(false)?;
+            let at = self.vgprs(inst, addr.as_ref().ok_or("a permute address")?, 1)?[0];
+            let x = self.vgprs(inst, data.first().ok_or("a permute source")?, 1)?[0];
+            let o = self.s.m.i32(offset);
+            let at = self.s.m.bin(c, Bin::Add, at, o);
+            let two = self.s.m.i32(2);
+            let src = self.s.m.bin(c, Bin::LShr, at, two);
+            let k31 = self.s.m.i32(31);
+            let mut src = self.s.m.bin(c, Bin::And, src, k31);
+            if self.wave() == 64 {
+                // The lane's own half: bit 5 of its host lane, which is 0 in
+                // a host wave of 32 (one half of the console's wave).
+                let lane = self.lane_index();
+                let k32 = self.s.m.i32(32);
+                let half = self.s.m.bin(c, Bin::And, lane, k32);
+                src = self.s.m.bin(c, Bin::Or, src, half);
+            }
+            let x = match guard {
+                Some(g) => {
+                    let z = self.s.m.i32(0);
+                    self.s.m.select(c, g, x, z)
+                }
+                None => x,
+            };
+            let r = self.read_lane(x, src);
+            let reg = dst_reg.ok_or("a permute result")?;
+            self.write(inst, Reg::V(reg), r, guard);
+            return Ok(());
+        }
+        if name == "ds_permute_b32" {
+            // Forward permute: no LDS is touched. Each lane's data register
+            // goes to the lane its address names, (address + offset) / 4
+            // within its own 32-lane half, and every lane takes what was written to its
+            // own slot; a slot no lane names keeps what it held. Where two
+            // lanes name one, which of them wins is undefined on the console,
+            // and the host's plain store leaves it undefined the same way.
+            self.cross_lane(false)?;
+            let halves = self.exchange.as_ref().is_some_and(|e| !e.1);
+            if !halves {
+                // (a DXIL wave has no way to scatter a dword to a lane: the
+                // table past the exchange dwords, made where the console wave
+                // is two host waves, is the only way)
+                return Err("a lane permute in one host wave");
+            }
+            if self.local {
+                // a console wave of 64 run as two host waves that do not
+                // exchange (each as a wave of its own): the lane named may
+                // be in the other one
+                return Err("a lane permute across two host waves");
+            }
+            if !self.all_lanes(self.cur_ir) {
+                // the barriers below need every lane of the group
+                need(self.cur_ir);
+                return Err("a lane permute across two host waves where not every lane runs");
+            }
+            // A console wave of 64 run as two host waves of 32: the lane
+            // named may be in the other one. Every console lane's dword goes
+            // through a table past the program's LDS, one dword per console
+            // lane of each console wave ([`Self::permute_table`]). The
+            // console writes nothing for a lane outside EXEC, so the store
+            // is taken under the guard — not with a zero, which could race
+            // a lane that does name the slot.
+            let table = self
+                .permute_table
+                .ok_or("a lane permute across two host waves")?;
+            let at = self.vgprs(inst, addr.as_ref().ok_or("a permute address")?, 1)?[0];
+            let x = self.vgprs(inst, data.first().ok_or("a permute source")?, 1)?[0];
+            let cl = self.console_lane();
+            let six = self.s.m.i32(6);
+            let thread = self.console_thread();
+            let slot = self.s.m.i32(table);
+            // this console wave's 64 table dwords, as `exchange_pair` picks
+            // its pair of exchange dwords: the wave's threads are 64 apart
+            let wave = self.s.m.bin(c, Bin::LShr, thread, six);
+            let base = self.s.m.bin(c, Bin::Shl, wave, six);
+            let base = self.s.m.bin(c, Bin::Add, base, slot);
+            let o = self.s.m.i32(offset);
+            let at = self.s.m.bin(c, Bin::Add, at, o);
+            let two = self.s.m.i32(2);
+            let to = self.s.m.bin(c, Bin::LShr, at, two);
+            // within the lane's own 32-lane half, as `ds_bpermute` below:
+            // GFX10 permutes the two halves of a wave of 64 on their own
+            // (HybridGt, on merging fxceless's half-local backward permute)
+            let k31 = self.s.m.i32(31);
+            let to = self.s.m.bin(c, Bin::And, to, k31);
+            let k32 = self.s.m.i32(32);
+            let half = self.s.m.bin(c, Bin::And, cl, k32);
+            let to = self.s.m.bin(c, Bin::Or, to, half);
+            let index = self.s.m.bin(c, Bin::Add, base, to);
+            let lds = self.s.lds();
+            let ptr = self.s.m.element(c, lds, index);
+            let g = self.begin_guarded(guard);
+            self.s.m.store(self.cur, ptr, x);
+            self.end_guarded(g, &[]);
+            let c2 = self.cur;
+            self.group_sync(c2);
+            // every lane takes what was written to its own slot
+            let index = self.s.m.bin(c2, Bin::Add, base, cl);
+            let ptr = self.s.m.element(c2, lds, index);
+            let r = self.s.m.load(c2, ptr);
+            // the slots are written again only after every thread read them
+            let c3 = self.cur;
+            self.group_sync(c3);
+            let reg = dst_reg.ok_or("a permute result")?;
+            self.write(inst, Reg::V(reg), r, guard);
+            return Ok(());
+        }
+        // HybridGt: a geometry program's ring accesses (`gs.rs`).
+        if self.gs.is_some() {
+            let w = match name.rsplit('_').next() {
+                Some("b64") => 2,
+                Some("b96") => 3,
+                Some("b128") => 4,
+                _ => 1,
+            };
+            let rest = name.trim_start_matches("ds_read").trim_start_matches("ds_write");
+            let elements: Vec<(u32, u32)> = if rest.starts_with('2') {
+                let scale = 4 * w * if name.contains("st64") { 64 } else { 1 };
+                vec![(u32::from(*offset0) * scale, w), (u32::from(*offset1) * scale, w)]
+            } else {
+                vec![(offset, w)]
+            };
+            if self.gs_ds(inst, &elements, dst_reg, &data[..])? {
+                return Ok(());
+            }
+        }
+        let paired_lds = match self.x.native.io {
+            StageIo::Cs(cs) if self.twin.is_some() => Some(cs.lds_bytes() / 4),
+            _ => None,
+        };
+        if paired_lds.unwrap_or(self.s.lds_dwords) == 0 {
+            return Err("LDS the program does not allocate");
+        }
+        let a = self.vgprs(inst, addr.as_ref().ok_or("an LDS address")?, 1)?[0];
+        let index = |l: &mut Self, bytes: u32| -> V {
+            let c = l.cur;
+            let o = l.s.m.i32(bytes);
+            let at = l.s.m.bin(c, Bin::Add, a, o);
+            let two = l.s.m.i32(2);
+            l.s.m.bin(c, Bin::LShr, at, two)
+        };
+        if let Some(dwords) = paired_lds {
+            return self.paired_lds(inst, a, guard, dwords);
+        }
+        // Shortcut: other modes take LDS addresses as dword-aligned and in bounds.
+        let dword = |l: &mut Self, bytes: u32| -> V {
+            let index = index(l, bytes);
+            let lds = l.s.lds();
+            l.s.m.element(l.cur, lds, index)
+        };
+        let width = |n: &str| match n.rsplit('_').next() {
+            Some("b64") => 2,
+            Some("b96") => 3,
+            Some("b128") => 4,
+            _ => 1,
+        };
+        // (byte offset, dwords) per element; read2/write2 scale their two
+        // offsets by the element size (×64 for st64).
+        let pair = |n: &str| -> Vec<(u32, u32)> {
+            let w = width(n);
+            let scale = 4 * w * if n.contains("st64") { 64 } else { 1 };
+            vec![
+                (u32::from(*offset0) * scale, w),
+                (u32::from(*offset1) * scale, w),
+            ]
+        };
+        // Bytes and halves: the dword holding them, and their bit position
+        // in it (naturally aligned, so they never straddle dwords).
+        // `_d16` reads fill a register's low half (`_d16_hi` its high half)
+        // and keep the other; `_d16_hi` writes take the data's high half.
+        let base = name.trim_end_matches("_hi").trim_end_matches("_d16");
+        let sub = match base {
+            "ds_read_u8" | "ds_read_i8" | "ds_write_b8" => Some(8u32),
+            "ds_read_u16" | "ds_read_i16" | "ds_write_b16" => Some(16),
+            _ => None,
+        };
+        let sub = sub.filter(|_| {
+            base == name
+                || name.ends_with("_d16") && base.starts_with("ds_read")
+                || name.ends_with("_d16_hi")
+        });
+        if let Some(bits) = sub {
+            let p = dword(self, offset);
+            let o = self.s.m.i32(offset);
+            let at = self.s.m.bin(c, Bin::Add, a, o);
+            let three = self.s.m.i32(3);
+            let byte = self.s.m.bin(c, Bin::And, at, three);
+            let sh = self.s.m.bin(c, Bin::Shl, byte, three);
+            let mask = self.s.m.i32((1u32 << bits) - 1);
+            if name.starts_with("ds_read") {
+                let reg = dst_reg.ok_or("an LDS read result")?;
+                let w = self.s.m.load(c, p);
+                let x = self.s.m.bin(c, Bin::LShr, w, sh);
+                let x = if base.contains("_i") {
+                    let k = self.s.m.i32(32 - bits);
+                    let x = self.s.m.bin(c, Bin::Shl, x, k);
+                    self.s.m.bin(c, Bin::AShr, x, k)
+                } else {
+                    self.s.m.bin(c, Bin::And, x, mask)
+                };
+                let x = if base == name {
+                    x
+                } else {
+                    let old = match inst.read(Reg::V(reg)) {
+                        Some(v) => self.i32_of(v)?,
+                        None => self.s.m.i32(0),
+                    };
+                    let half = self.s.m.i32(0xFFFF);
+                    let x = self.s.m.bin(c, Bin::And, x, half);
+                    let (x, keep) = if name.ends_with("_hi") {
+                        let k16 = self.s.m.i32(16);
+                        (self.s.m.bin(c, Bin::Shl, x, k16), half)
+                    } else {
+                        (x, self.s.m.i32(0xFFFF_0000))
+                    };
+                    let old = self.s.m.bin(c, Bin::And, old, keep);
+                    self.s.m.bin(c, Bin::Or, old, x)
+                };
+                self.write(inst, Reg::V(reg), x, guard);
+            } else {
+                // Clear, then set: two atomics, so lanes writing other
+                // bytes of the dword keep theirs.
+                let mut x = self.vgprs(inst, data.first().ok_or("an LDS write")?, 1)?[0];
+                if name != base {
+                    // The data's high half.
+                    let k16 = self.s.m.i32(16);
+                    x = self.s.m.bin(c, Bin::LShr, x, k16);
+                }
+                let x = self.s.m.bin(c, Bin::And, x, mask);
+                let x = self.s.m.bin(c, Bin::Shl, x, sh);
+                let m = self.s.m.bin(c, Bin::Shl, mask, sh);
+                let ones = self.s.m.i32(u32::MAX);
+                let keep = self.s.m.bin(c, Bin::Xor, m, ones);
+                use super::super::bitcode::Rmw;
+                let at = self.begin_guarded(guard);
+                self.s.m.atomic(self.cur, Rmw::And, p, keep);
+                self.s.m.atomic(self.cur, Rmw::Or, p, x);
+                self.end_guarded(at, &[]);
+            }
+            return Ok(());
+        }
+        if let Some(rest) = name.strip_prefix("ds_read") {
+            let elements = if rest.starts_with('2') {
+                pair(name)
+            } else if matches!(rest, "_b32" | "_b64" | "_b96" | "_b128") {
+                vec![(offset, width(name))]
+            } else {
+                return Err("an LDS read of bytes or halves");
+            };
+            let reg = dst_reg.ok_or("an LDS read result")?;
+            let mut n = 0;
+            for (off, w) in elements {
+                for k in 0..w {
+                    let p = dword(self, off + 4 * k);
+                    let x = self.s.m.load(self.cur, p);
+                    self.write(inst, Reg::V(reg + n), x, guard);
+                    n += 1;
+                }
+            }
+            return Ok(());
+        }
+        if let Some(rest) = name.strip_prefix("ds_write") {
+            let elements = if rest.starts_with('2') {
+                pair(name)
+            } else if matches!(rest, "_b32" | "_b64" | "_b96" | "_b128") {
+                vec![(offset, width(name))]
+            } else {
+                return Err("an LDS write of bytes or halves");
+            };
+            let mut stores = Vec::new();
+            for (e, (off, w)) in elements.into_iter().enumerate() {
+                let vals = self.vgprs(inst, data.get(e).ok_or("an LDS write")?, w as u8)?;
+                for (k, x) in vals.into_iter().enumerate() {
+                    stores.push((off + 4 * k as u32, x));
+                }
+            }
+            let at = self.begin_guarded(guard);
+            for (off, x) in stores {
+                let p = dword(self, off);
+                self.s.m.store(self.cur, p, x);
+            }
+            self.end_guarded(at, &[]);
+            return Ok(());
+        }
+        // Atomics: the old value returns with `_rtn`.
+        let op = name
+            .strip_prefix("ds_")
+            .map(|n| n.replace("_rtn", ""))
+            .ok_or("an LDS operation")?;
+        use super::super::bitcode::Rmw;
+        let rmw = match op.as_str() {
+            "add_u32" => Some(Rmw::Add),
+            "sub_u32" => Some(Rmw::Sub),
+            "and_b32" => Some(Rmw::And),
+            "or_b32" => Some(Rmw::Or),
+            "xor_b32" => Some(Rmw::Xor),
+            "min_i32" => Some(Rmw::Min),
+            "max_i32" => Some(Rmw::Max),
+            "min_u32" => Some(Rmw::UMin),
+            "max_u32" => Some(Rmw::UMax),
+            "wrxchg_b32" => Some(Rmw::Xchg),
+            "cmpst_b32" | "max_f32" | "min_f32" => None,
+            _ => return Err("an LDS operation"),
+        };
+        let v0 = self.vgprs(inst, data.first().ok_or("an LDS atomic")?, 1)?[0];
+        let v1 = match data.get(1) {
+            Some(d) => Some(self.vgprs(inst, d, 1)?[0]),
+            None => None,
+        };
+        let old_reg = dst_reg.and_then(|r| inst.read(Reg::V(r)).map(|v| (r, v)));
+        let outside = match old_reg {
+            Some((_, v)) => self.i32_of(v).unwrap_or(self.s.m.i32(0)),
+            None => self.s.m.i32(0),
+        };
+        let p = dword(self, offset);
+        if let Some(max) = match op.as_str() {
+            "max_f32" => Some(true),
+            "min_f32" => Some(false),
+            _ => None,
+        } {
+            let at = self.begin_guarded(guard);
+            let r = self.lds_float_min_max(p, v0, max);
+            let r = self.end_guarded(at, &[(r, outside)])[0];
+            if let Some(reg) = dst_reg {
+                self.write(inst, Reg::V(reg), r, None);
+            }
+            return Ok(());
+        }
+        let at = self.begin_guarded(guard);
+        let r = match rmw {
+            Some(op) => self.s.m.atomic(self.cur, op, p, v0),
+            // Compare with data0, store data1.
+            None => self
+                .s
+                .m
+                .cmpxchg(self.cur, p, v0, v1.ok_or("an LDS compare")?),
+        };
+        let r = self.end_guarded(at, &[(r, outside)])[0];
+        if let Some(reg) = dst_reg {
+            self.write(inst, Reg::V(reg), r, None);
+        }
+        Ok(())
+    }
+
+    pub(super) fn sop(&mut self, inst: &Inst) -> Result<(), Why> {
+        let Fields::Sop { dst, src, imm } = &inst.fields else {
+            unreachable!()
+        };
+        let name = inst.name();
+        let scc = inst.write(Reg::Scc);
+        let dst_code = match dst {
+            Some(Operand::Scalar { code, .. }) => Some(*code),
+            _ => None,
+        };
+        let lo = dst_code.and_then(|c| inst.write(Reg::S(c)));
+        if inst.write(Reg::S(EXEC)).is_some() || self.is_mask(lo) {
+            return Err(LANE_MASK);
+        }
+        if matches!(
+            name,
+            "s_setreg_imm32_b32" | "s_setreg_b32" | "s_swappc_b64" | "s_version"
+        ) || name.starts_with("s_waitcnt")
+        {
+            // shortcut: the float MODE register is not modelled; s_swappc_b64 is the
+            // vertex fetch call, whose results arrive as inputs.
+            return Err("a register the emitter does not model");
+        }
+        if name == "s_getpc_b64" {
+            // The address of the next instruction is no number the host has: tables in
+            // the code are read by their tracked address. As a number the counter is
+            // that instruction's offset in the code, so an address paths join before
+            // one load is the byte in the code, whichever table each path took
+            // (resource tracking gives such a join as the computed term, with no base).
+            let z = self.s.m.i32(0);
+            let at = self.s.m.i32(inst.machine.offset as u32 + 4);
+            let hi = dst_code.and_then(|c| inst.write(Reg::S(c + 1)));
+            self.set(lo, Val::I32(at));
+            self.set(hi, Val::I32(z));
+            return Ok(());
+        }
+        let c = self.cur;
+        let src32 = |l: &mut Self, k: usize| -> Result<V, Why> {
+            // SOPK arithmetic reads its destination as the first source.
+            if k == 0 && matches!(name, "s_addk_i32" | "s_mulk_i32") {
+                let d = dst.as_ref().ok_or("a missing operand")?;
+                return l.operand(inst, d);
+            }
+            let op = src.get(k).ok_or("a missing operand")?;
+            l.operand(inst, op)
+        };
+        let sext16 = |l: &mut Self| l.s.m.i32(i32::from(imm.unwrap_or(0) as i16) as u32);
+        // Dword `h` of 64-bit source `k` (inline constants sign-extend).
+        let half = |l: &mut Self, k: usize, h: u8| -> Result<V, Why> {
+            match src.get(k) {
+                Some(&Operand::Scalar { code, .. }) if code != NULL => {
+                    let v = inst.read(Reg::S(code + h)).ok_or("an unread operand")?;
+                    l.i32_of(v)
+                }
+                Some(op) if h == 0 => l.operand(inst, op),
+                Some(Operand::Const(k)) => {
+                    let x = crate::resource::inline(*k).ok_or("a special operand")?;
+                    Ok(l.s.m.i32(if (x as i32) < 0 { u32::MAX } else { 0 }))
+                }
+                _ => Ok(l.s.m.i32(0)),
+            }
+        };
+        if let Some(op) = name.strip_prefix("s_bitcmp") {
+            // SCC is whether bit src1 (mod 32, or mod 64 for the 64-bit form)
+            // of src0 is clear (bitcmp0) or set (bitcmp1).
+            let (bit, k31) = (src32(self, 1)?, self.s.m.i32(31));
+            let idx = self.s.m.bin(c, Bin::And, bit, k31);
+            let word = if op.ends_with("_b64") {
+                let (a, b) = (half(self, 0, 0)?, half(self, 0, 1)?);
+                let k32 = self.s.m.i32(32);
+                let upper = self.s.m.bin(c, Bin::And, bit, k32);
+                let z = self.s.m.i32(0);
+                let upper = self.s.m.cmp(c, pred::NE, upper, z);
+                self.s.m.select(c, upper, b, a)
+            } else {
+                src32(self, 0)?
+            };
+            let shifted = self.s.m.bin(c, Bin::LShr, word, idx);
+            let one = self.s.m.i32(1);
+            let tested = self.s.m.bin(c, Bin::And, shifted, one);
+            let want = self.s.m.i32(u32::from(op.starts_with('1')));
+            let r = self.s.m.cmp(c, pred::EQ, tested, want);
+            self.set(scc, Val::Bit(r));
+            return Ok(());
+        }
+        if let Some(op) = name.strip_prefix("s_cmp_").filter(|o| o.ends_with("_u64")) {
+            // eq and lg only: both dwords.
+            let mut r = None;
+            for h in 0..2 {
+                let (a, b) = (half(self, 0, h)?, half(self, 1, h)?);
+                let e = self.s.m.cmp(c, pred::EQ, a, b);
+                r = Some(match r {
+                    Some(x) => self.s.m.bin(c, Bin::And, x, e),
+                    None => e,
+                });
+            }
+            let mut r = r.expect("two dwords");
+            if op.starts_with("lg") {
+                let t = self.s.m.bool(true);
+                r = self.s.m.bin(c, Bin::Xor, r, t);
+            }
+            self.set(scc, Val::Bit(r));
+            return Ok(());
+        }
+        if let Some(op) = name.strip_prefix("s_cmp_").or(name.strip_prefix("s_cmpk_")) {
+            let (a, b) = if name.starts_with("s_cmpk_") {
+                let b = if op.ends_with("_i32") {
+                    sext16(self)
+                } else {
+                    self.s.m.i32(u32::from(imm.unwrap_or(0)))
+                };
+                (src32(self, 0)?, b)
+            } else {
+                if op.ends_with("64") {
+                    return Err("a 64-bit scalar compare");
+                }
+                (src32(self, 0)?, src32(self, 1)?)
+            };
+            let signed = op.ends_with("_i32");
+            let p = match &op[..2] {
+                "eq" => pred::EQ,
+                "lg" => pred::NE,
+                "gt" if signed => pred::SGT,
+                "ge" if signed => pred::SGE,
+                "lt" if signed => pred::SLT,
+                "le" if signed => pred::SLE,
+                "gt" => pred::IUGT,
+                "ge" => pred::IUGE,
+                "lt" => pred::IULT,
+                "le" => pred::IULE,
+                _ => return Err("a scalar compare"),
+            };
+            let r = self.s.m.cmp(c, p, a, b);
+            self.set(scc, Val::Bit(r));
+            return Ok(());
+        }
+        let wide = name.ends_with("_b64") || name.ends_with("_u64") || name.ends_with("_i64");
+        if wide {
+            let hi = dst_code.and_then(|c| inst.write(Reg::S(c + 1)));
+            let nonzero = |l: &mut Self, a: V, b: V| {
+                let o = l.s.m.bin(c, Bin::Or, a, b);
+                let z = l.s.m.i32(0);
+                l.s.m.cmp(c, pred::NE, o, z)
+            };
+            return match name {
+                "s_quadmask_b64" => {
+                    let (a, b) = (half(self, 0, 0)?, half(self, 0, 1)?);
+                    let low = self.quad_mask(a);
+                    let high = self.quad_mask(b);
+                    let k8 = self.s.m.i32(8);
+                    let high = self.s.m.bin(c, Bin::Shl, high, k8);
+                    let mask = self.s.m.bin(c, Bin::Or, low, high);
+                    let zero = self.s.m.i32(0);
+                    self.set(lo, Val::I32(mask));
+                    self.set(hi, Val::I32(zero));
+                    let nonzero = self.s.m.cmp(c, pred::NE, mask, zero);
+                    self.set(scc, Val::Bit(nonzero));
+                    Ok(())
+                }
+                "s_bcnt1_i32_b64" => {
+                    let (a, b) = (half(self, 0, 0)?, half(self, 0, 1)?);
+                    let i32t = self.s.t.i32;
+                    let na = self
+                        .s
+                        .op(c, "unaryBits.i32", Attr::ReadNone, i32t, 31, &[a]);
+                    let nb = self
+                        .s
+                        .op(c, "unaryBits.i32", Attr::ReadNone, i32t, 31, &[b]);
+                    let r = self.s.m.bin(c, Bin::Add, na, nb);
+                    self.set(lo, Val::I32(r));
+                    let z = self.s.m.i32(0);
+                    let s = self.s.m.cmp(c, pred::NE, r, z);
+                    self.set(scc, Val::Bit(s));
+                    Ok(())
+                }
+                "s_ff1_i32_b64" => {
+                    // The lowest set bit; -1 for none (as DXIL's first bit low).
+                    let (a, b) = (half(self, 0, 0)?, half(self, 0, 1)?);
+                    let i32t = self.s.t.i32;
+                    let fa = self
+                        .s
+                        .op(c, "unaryBits.i32", Attr::ReadNone, i32t, 32, &[a]);
+                    let fb = self
+                        .s
+                        .op(c, "unaryBits.i32", Attr::ReadNone, i32t, 32, &[b]);
+                    let (z, k32) = (self.s.m.i32(0), self.s.m.i32(32));
+                    let fb32 = self.s.m.bin(c, Bin::Add, fb, k32);
+                    let none = self.s.m.cmp(c, pred::EQ, b, z);
+                    let fb = self.s.m.select(c, none, fb, fb32);
+                    let low = self.s.m.cmp(c, pred::NE, a, z);
+                    let r = self.s.m.select(c, low, fa, fb);
+                    self.set(lo, Val::I32(r));
+                    Ok(())
+                }
+                "s_and_b64" | "s_or_b64" | "s_xor_b64" | "s_andn2_b64" | "s_orn2_b64"
+                | "s_nand_b64" | "s_nor_b64" | "s_xnor_b64" | "s_not_b64" => {
+                    let ones = self.s.m.i32(u32::MAX);
+                    let mut r = Vec::new();
+                    for h in 0..2u8 {
+                        let a = half(self, 0, h)?;
+                        let x = if name == "s_not_b64" {
+                            self.s.m.bin(c, Bin::Xor, a, ones)
+                        } else {
+                            let mut b = half(self, 1, h)?;
+                            if name.contains("n2") {
+                                b = self.s.m.bin(c, Bin::Xor, b, ones);
+                            }
+                            let op = match &name[2..5] {
+                                "and" | "nan" => Bin::And,
+                                "or_" | "orn" | "nor" => Bin::Or,
+                                _ => Bin::Xor,
+                            };
+                            let x = self.s.m.bin(c, op, a, b);
+                            if matches!(name, "s_nand_b64" | "s_nor_b64" | "s_xnor_b64") {
+                                self.s.m.bin(c, Bin::Xor, x, ones)
+                            } else {
+                                x
+                            }
+                        };
+                        r.push(x);
+                    }
+                    self.set(lo, Val::I32(r[0]));
+                    self.set(hi, Val::I32(r[1]));
+                    let s = nonzero(self, r[0], r[1]);
+                    self.set(scc, Val::Bit(s));
+                    Ok(())
+                }
+                "s_lshl_b64" | "s_lshr_b64" | "s_ashr_i64" => {
+                    let (a, b) = (half(self, 0, 0)?, half(self, 0, 1)?);
+                    let n = src32(self, 1)?;
+                    let i64t = self.s.m.int(64);
+                    self.s.flags |= flags::INT64;
+                    let a = self.s.m.cast(c, Cast::ZExt, a, i64t);
+                    let b = self.s.m.cast(c, Cast::ZExt, b, i64t);
+                    let k32 = self.s.m.int_const(i64t, 32);
+                    let b = self.s.m.bin(c, Bin::Shl, b, k32);
+                    let x = self.s.m.bin(c, Bin::Or, a, b);
+                    let k63 = self.s.m.i32(63);
+                    let n = self.s.m.bin(c, Bin::And, n, k63);
+                    let n = self.s.m.cast(c, Cast::ZExt, n, i64t);
+                    let op = match name {
+                        "s_lshl_b64" => Bin::Shl,
+                        "s_lshr_b64" => Bin::LShr,
+                        _ => Bin::AShr,
+                    };
+                    let r = self.s.m.bin(c, op, x, n);
+                    let rl = self.s.m.cast(c, Cast::Trunc, r, self.s.t.i32);
+                    let rh = self.s.m.bin(c, Bin::LShr, r, k32);
+                    let rh = self.s.m.cast(c, Cast::Trunc, rh, self.s.t.i32);
+                    self.set(lo, Val::I32(rl));
+                    self.set(hi, Val::I32(rh));
+                    let s = nonzero(self, rl, rh);
+                    self.set(scc, Val::Bit(s));
+                    Ok(())
+                }
+                "s_mov_b64" => {
+                    // Each half by itself: two numbers that travel as a pair (two scalars
+                    // parked in neighbouring VGPR lanes, say) need not both have a value.
+                    for (h, v) in [(0, lo), (1, hi)] {
+                        let val = match half(self, 0, h) {
+                            Ok(a) => Val::I32(a),
+                            Err(why) => Val::Missing(why),
+                        };
+                        self.set(v, val);
+                    }
+                    Ok(())
+                }
+                "s_cselect_b64" => {
+                    let cond = self.scc_in(inst)?;
+                    for (h, v) in [(0, lo), (1, hi)] {
+                        let (a, b) = (half(self, 0, h)?, half(self, 1, h)?);
+                        let r = self.s.m.select(c, cond, a, b);
+                        self.set(v, Val::I32(r));
+                    }
+                    Ok(())
+                }
+                _ => Err(name),
+            };
+        }
+        let m = &mut self.s.m;
+        let _ = m;
+        let (r, carry): (V, Option<V>) = match name {
+            "s_mov_b32" => (src32(self, 0)?, None),
+            "s_movk_i32" => (sext16(self), None),
+            "s_quadmask_b32" => {
+                let pixels = src32(self, 0)?;
+                (self.quad_mask(pixels), None)
+            }
+            "s_cselect_b32" => {
+                let cond = self.scc_in(inst)?;
+                let (a, b) = (src32(self, 0)?, src32(self, 1)?);
+                (self.s.m.select(c, cond, a, b), None)
+            }
+            "s_brev_b32" => {
+                let a = src32(self, 0)?;
+                let r = self
+                    .s
+                    .op(c, "unary.i32", Attr::ReadNone, self.s.t.i32, 30, &[a]);
+                (r, None)
+            }
+            "s_not_b32" => {
+                let a = src32(self, 0)?;
+                let ones = self.s.m.i32(u32::MAX);
+                (self.s.m.bin(c, Bin::Xor, a, ones), None)
+            }
+            "s_add_u32" | "s_add_i32" | "s_addk_i32" => {
+                let a = src32(self, 0)?;
+                let b = if name == "s_addk_i32" {
+                    sext16(self)
+                } else {
+                    src32(self, 1)?
+                };
+                let r = self.s.m.bin(c, Bin::Add, a, b);
+                let carry = if name == "s_add_u32" {
+                    Some(self.s.m.cmp(c, pred::IULT, r, a))
+                } else {
+                    None
+                };
+                (r, carry)
+            }
+            "s_sub_u32" | "s_sub_i32" => {
+                let (a, b) = (src32(self, 0)?, src32(self, 1)?);
+                let r = self.s.m.bin(c, Bin::Sub, a, b);
+                let carry = (name == "s_sub_u32").then(|| self.s.m.cmp(c, pred::IULT, a, b));
+                (r, carry)
+            }
+            "s_addc_u32" | "s_subb_u32" => {
+                let (a, b) = (src32(self, 0)?, src32(self, 1)?);
+                let cin = self.scc_in(inst)?;
+                let (r, carry) = self.add_sub_carry(c, name == "s_addc_u32", a, b, Some(cin));
+                (r, Some(carry))
+            }
+            "s_mul_i32" | "s_mulk_i32" => {
+                let a = src32(self, 0)?;
+                let b = if name == "s_mulk_i32" {
+                    sext16(self)
+                } else {
+                    src32(self, 1)?
+                };
+                (self.s.m.bin(c, Bin::Mul, a, b), None)
+            }
+            "s_mul_hi_u32" | "s_mul_hi_i32" => {
+                let (a, b) = (src32(self, 0)?, src32(self, 1)?);
+                (self.mul_hi(a, b, name.ends_with("i32")), None)
+            }
+            "s_flbit_i32_b32" | "s_flbit_i32" => {
+                // The first bit from the top (differing from the sign for
+                // the signed form), -1 for none: DXIL's first-bit-high.
+                let a = src32(self, 0)?;
+                let op = if name == "s_flbit_i32_b32" { 33 } else { 34 };
+                let r = self
+                    .s
+                    .op(c, "unaryBits.i32", Attr::ReadNone, self.s.t.i32, op, &[a]);
+                (r, None)
+            }
+            "s_ff1_i32_b32" | "s_bcnt1_i32_b32" => {
+                // First set bit (-1 for zero, as DXIL's), or the bit count.
+                let a = src32(self, 0)?;
+                let op = if name == "s_ff1_i32_b32" { 32 } else { 31 };
+                let r = self
+                    .s
+                    .op(c, "unaryBits.i32", Attr::ReadNone, self.s.t.i32, op, &[a]);
+                (r, None)
+            }
+            "s_bfe_u32" | "s_bfe_i32" => {
+                // src1: offset in bits 0-4, width in bits 16-22.
+                let (a, b) = (src32(self, 0)?, src32(self, 1)?);
+                let (k16, k127) = (self.s.m.i32(16), self.s.m.i32(0x7F));
+                let w = self.s.m.bin(c, Bin::LShr, b, k16);
+                let w = self.s.m.bin(c, Bin::And, w, k127);
+                (self.bfe(a, b, w, name == "s_bfe_i32"), None)
+            }
+            "s_and_b32" | "s_or_b32" | "s_xor_b32" | "s_andn2_b32" | "s_orn2_b32"
+            | "s_nand_b32" | "s_nor_b32" | "s_xnor_b32" => {
+                let (a, mut b) = (src32(self, 0)?, src32(self, 1)?);
+                let ones = self.s.m.i32(u32::MAX);
+                if name.contains("n2") {
+                    b = self.s.m.bin(c, Bin::Xor, b, ones);
+                }
+                let op = match &name[2..5] {
+                    "and" | "nan" => Bin::And,
+                    "or_" | "orn" | "nor" => Bin::Or,
+                    _ => Bin::Xor,
+                };
+                let mut r = self.s.m.bin(c, op, a, b);
+                if matches!(name, "s_nand_b32" | "s_nor_b32" | "s_xnor_b32") {
+                    r = self.s.m.bin(c, Bin::Xor, r, ones);
+                }
+                (r, None)
+            }
+            "s_lshl_b32" | "s_lshr_b32" | "s_ashr_i32" => {
+                let (a, b) = (src32(self, 0)?, src32(self, 1)?);
+                let k31 = self.s.m.i32(31);
+                let b = self.s.m.bin(c, Bin::And, b, k31);
+                let op = match name {
+                    "s_lshl_b32" => Bin::Shl,
+                    "s_lshr_b32" => Bin::LShr,
+                    _ => Bin::AShr,
+                };
+                (self.s.m.bin(c, op, a, b), None)
+            }
+            "s_lshl1_add_u32" | "s_lshl2_add_u32" | "s_lshl3_add_u32" | "s_lshl4_add_u32" => {
+                let (a, b) = (src32(self, 0)?, src32(self, 1)?);
+                let k = self.s.m.i32(u32::from(name.as_bytes()[6] - b'0'));
+                let t = self.s.m.bin(c, Bin::Shl, a, k);
+                (self.s.m.bin(c, Bin::Add, t, b), None)
+            }
+            "s_min_u32" | "s_max_u32" | "s_min_i32" | "s_max_i32" => {
+                let (a, b) = (src32(self, 0)?, src32(self, 1)?);
+                let p = match name {
+                    "s_min_u32" => pred::IULT,
+                    "s_max_u32" => pred::IUGT,
+                    "s_min_i32" => pred::SLT,
+                    _ => pred::SGT,
+                };
+                let t = self.s.m.cmp(c, p, a, b);
+                (self.s.m.select(c, t, a, b), None)
+            }
+            "s_abs_i32" => {
+                let a = src32(self, 0)?;
+                let z = self.s.m.i32(0);
+                let neg = self.s.m.cmp(c, pred::SLT, a, z);
+                let n = self.s.m.bin(c, Bin::Sub, z, a);
+                (self.s.m.select(c, neg, n, a), None)
+            }
+            "s_bitset0_b32" | "s_bitset1_b32" => {
+                // Sets (clears) bit src[4:0] of the destination it reads.
+                let old = self.operand(inst, dst.as_ref().ok_or("a missing operand")?)?;
+                let a = src32(self, 0)?;
+                let (k31, one) = (self.s.m.i32(31), self.s.m.i32(1));
+                let a = self.s.m.bin(c, Bin::And, a, k31);
+                let bit = self.s.m.bin(c, Bin::Shl, one, a);
+                if name == "s_bitset1_b32" {
+                    (self.s.m.bin(c, Bin::Or, old, bit), None)
+                } else {
+                    let ones = self.s.m.i32(u32::MAX);
+                    let nb = self.s.m.bin(c, Bin::Xor, bit, ones);
+                    (self.s.m.bin(c, Bin::And, old, nb), None)
+                }
+            }
+            "s_bfm_b32" => {
+                let (a, b) = (src32(self, 0)?, src32(self, 1)?);
+                let k31 = self.s.m.i32(31);
+                let one = self.s.m.i32(1);
+                let a = self.s.m.bin(c, Bin::And, a, k31);
+                let b = self.s.m.bin(c, Bin::And, b, k31);
+                let m = self.s.m.bin(c, Bin::Shl, one, a);
+                let m = self.s.m.bin(c, Bin::Sub, m, one);
+                (self.s.m.bin(c, Bin::Shl, m, b), None)
+            }
+            _ => return Err(name),
+        };
+        self.set(lo, Val::I32(r));
+        if let Some(scc) = scc {
+            let val = match carry {
+                Some(k) => Val::Bit(k),
+                None if matches!(
+                    name,
+                    "s_mov_b32"
+                        | "s_movk_i32"
+                        | "s_cselect_b32"
+                        | "s_brev_b32"
+                        | "s_mul_i32"
+                        | "s_mulk_i32"
+                ) =>
+                {
+                    return Ok(());
+                }
+                None if name.starts_with("s_add") || name.starts_with("s_sub") => {
+                    Val::Missing("the carry of a scalar operation")
+                }
+                None => {
+                    let z = self.s.m.i32(0);
+                    Val::Bit(self.s.m.cmp(c, pred::NE, r, z))
+                }
+            };
+            self.vals.insert(scc, val);
+        }
+        Ok(())
+    }
+}
diff --git a/crates/victory-shader/src/emit/lower_tests.rs b/crates/victory-shader/src/emit/lower_tests.rs
