+        0xF40C_0302, 0xFA00_0000,       // s_load_dwordx8 s[12:19], s[4:5], 0
+        0xBE89_0380, 0xBE8A_0380, 0xBE8B_0380, // sampler words 1-3
+        0xBF06_8001,                    // s_cmp_eq_u32 s1, 0
+        0xBF85_0002,                    // branch to clamp
