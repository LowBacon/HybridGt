+                    let k16 = self.s.m.i32(16);
+                    let mask = self.s.m.i32(0xFFFF);
+                    let op0 = *v.src.first().ok_or("a missing operand")?;
+                    let op1 = *v.src.get(1).ok_or("a missing operand")?;
