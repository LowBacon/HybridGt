+        let merged = s.m.phi(join, i32t);
+        s.m.set_phi(merged, vec![(live_val, entry), (dead_val, dead)]);
+        let _used = s.m.bin(join, Bin::Add, merged, one);
+        s.m.terminate(join, Term::Ret);
