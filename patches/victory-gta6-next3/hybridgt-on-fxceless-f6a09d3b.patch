+/// HybridGt remap census, logged every 2 s while remaps happen
+/// ([`remap_report`]): what the title's page mappings cost, by kind and by
+/// system call, how many pages of the GPU's page-mapping copies come in runs
+/// of consecutive section pages (one view each with `VICTORY_REMAP_RUNS=1`),
+/// and the slowest single operations.
+mod census {
+    use std::sync::Mutex;
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+    pub(super) const ALIAS_CALLS: usize = 0;
+    pub(super) const ALIAS_PAGES: usize = 1;
+    pub(super) const ALIAS_RUNS: usize = 2;
+    pub(super) const MAP_CALLS: usize = 3;
+    pub(super) const MAP_PAGES: usize = 4;
+    pub(super) const UNMAP_N: usize = 5;
+    pub(super) const UNMAP_US: usize = 6;
+    pub(super) const SPLIT_N: usize = 7;
+    pub(super) const SPLIT_US: usize = 8;
+    pub(super) const VIEW_N: usize = 9;
+    pub(super) const VIEW_US: usize = 10;
+    pub(super) const COMMIT_N: usize = 11;
+    pub(super) const COMMIT_US: usize = 12;
+    pub(super) const COALESCE_N: usize = 13;
+    pub(super) const COALESCE_US: usize = 14;
+    pub(super) const JOINED_PAGES: usize = 15;
+    pub(super) const UNCHANGED_PAGES: usize = 16;
+    pub(super) const OP_US: usize = 17;
+
+    pub(super) static C: [AtomicU64; 18] = [const { AtomicU64::new(0) }; 18];
+
+    pub(super) fn add(i: usize, n: u64) {
+        C[i].fetch_add(n, Relaxed);
+    }
+
+    /// The five slowest operations since the last report: microseconds,
+    /// kind, address, pages.
+    static SLOWEST: Mutex<Vec<(u64, &'static str, usize, usize)>> = Mutex::new(Vec::new());
+    static LAST: Mutex<Option<std::time::Instant>> = Mutex::new(None);
+
+    pub(super) fn op(us: u64, kind: &'static str, at: usize, pages: usize) {
+        add(OP_US, us);
+        let mut s = SLOWEST.lock().unwrap_or_else(|e| e.into_inner());
+        if s.len() < 5 || s.last().is_some_and(|l| l.0 < us) {
+            s.push((us, kind, at, pages));
+            s.sort_unstable_by(|a, b| b.0.cmp(&a.0));
+            s.truncate(5);
+        }
+    }
+
+    /// Logs and resets the census, at most once every 2 seconds.
+    pub(super) fn report() {
+        {
+            let mut last = LAST.lock().unwrap_or_else(|e| e.into_inner());
+            match *last {
+                Some(at) if at.elapsed().as_secs() < 2 => return,
+                None => {
+                    *last = Some(std::time::Instant::now());
+                    return;
+                }
+                _ => {}
+            }
+            let secs = last.map_or(2.0, |l| l.elapsed().as_secs_f64());
+            *last = Some(std::time::Instant::now());
+            let c: Vec<u64> = C.iter().map(|x| x.swap(0, Relaxed)).collect();
+            let ms = |i: usize| c[i] as f64 / 1000.0 / secs;
+            let per = |i: usize| c[i] as f64 / secs;
+            let slowest = std::mem::take(&mut *SLOWEST.lock().unwrap_or_else(|e| e.into_inner()));
+            tracing::info!(
+                "remap census per second (HybridGt): GPU page-mapping copies {:.0} calls {:.0} pages \
+                 ({:.0} pages already as asked, {:.0} runs of consecutive section pages, {:.0} pages mapped as joined runs: \
+                 VICTORY_REMAP_RUNS=1), title page maps {:.0} calls {:.0} pages; {:.1} ms in all; system calls: \
+                 unmap {:.0}x {:.1} ms, split {:.0}x {:.1} ms, map view {:.0}x {:.1} ms, commit {:.0}x {:.1} ms, \
+                 coalesce {:.0}x {:.1} ms; slowest (us, kind, address, pages): {:x?}",
+                per(ALIAS_CALLS),
+                per(ALIAS_PAGES),
+                per(UNCHANGED_PAGES),
+                per(ALIAS_RUNS),
+                per(JOINED_PAGES),
+                per(MAP_CALLS),
+                per(MAP_PAGES),
+                ms(OP_US),
+                per(UNMAP_N),
+                ms(UNMAP_US),
+                per(SPLIT_N),
+                ms(SPLIT_US),
+                per(VIEW_N),
+                ms(VIEW_US),
+                per(COMMIT_N),
+                ms(COMMIT_US),
+                per(COALESCE_N),
+                ms(COALESCE_US),
+                slowest
+            );
+        }
+    }
+}
